mmand_contains","content":"—"},"2172":{"id":"/evals-quality/setup-141","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"`required`"},"2173":{"id":"/evals-quality/setup-142","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"bool"},"2174":{"id":"/evals-quality/setup-143","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"no"},"2175":{"id":"/evals-quality/setup-144","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"`true`"},"2176":{"id":"/evals-quality/setup-145","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"Same trace substring search as `trigger_expectation`, without the pass/fail inversion — passes if the pattern is found anywhere in the trace."},"2177":{"id":"/evals-quality/setup-146","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Field"},"2178":{"id":"/evals-quality/setup-147","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Type"},"2179":{"id":"/evals-quality/setup-148","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Required"},"2180":{"id":"/evals-quality/setup-149","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Default"},"2181":{"id":"/evals-quality/setup-150","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"`path`"},"2182":{"id":"/evals-quality/setup-151","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"path"},"2183":{"id":"/evals-quality/setup-152","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"yes"},"2184":{"id":"/evals-quality/setup-153","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"—"},"2185":{"id":"/evals-quality/setup-154","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"`required`"},"2186":{"id":"/evals-quality/setup-155","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"bool"},"2187":{"id":"/evals-quality/setup-156","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"no"},"2188":{"id":"/evals-quality/setup-157","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"`true`"},"2189":{"id":"/evals-quality/setup-158","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Passes if `path` exists under the case's working directory — the case's scratch workspace under the default isolation (plus `workspace_subdir` when set), or the project root under `--no-isolation`."},"2190":{"id":"/evals-quality/setup-159","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Field"},"2191":{"id":"/evals-quality/setup-160","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Type"},"2192":{"id":"/evals-quality/setup-161","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Required"},"2193":{"id":"/evals-quality/setup-162","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Default"},"2194":{"id":"/evals-quality/setup-163","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"`limit`"},"2195":{"id":"/evals-quality/setup-164","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"integer"},"2196":{"id":"/evals-quality/setup-165","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"yes"},"2197":{"id":"/evals-quality/setup-166","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"—"},"2198":{"id":"/evals-quality/setup-167","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"`required`"},"2199":{"id":"/evals-quality/setup-168","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"bool"},"2200":{"id":"/evals-quality/setup-169","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"no"},"2201":{"id":"/evals-quality/setup-170","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"`true`"},"2202":{"id":"/evals-quality/setup-171","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Passes if the number of **tool invocations** the agent made is `<= limit`."},"2203":{"id":"/evals-quality/setup-172","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"A tool invocation is a structured `tool_use` trace event, plus any `raw_json` trace line — the\nlatter covers backends that still emit tool calls as raw JSON instead of decoded tool events.\nAssistant text output, token-usage events, and unmodelled SDK event variants are **not** counted."},"2204":{"id":"/evals-quality/setup-173","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Results use `\"check_name\": \"max_tool_calls\"`. The per-case artifact field counting\nthese events is `command_count`."},"2205":{"id":"/evals-quality/setup-174","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#making-a-check-advisory-with-required","content":"Every check type accepts `required` (default `true`). Setting `required = false` makes the check **advisory**: it still runs, and its result still appears in the run artifacts with its own `passed` value, but a failure does not fail the case."},"2206":{"id":"/evals-quality/setup-175","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#making-a-check-advisory-with-required","content":"Use it for signal you want visible in reports without gating the suite on it."},"2207":{"id":"/evals-quality/setup-176","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"No `checks` file configured (or it loads zero explicit checks): the case still receives the required trigger expectation generated from `should_trigger`."},"2208":{"id":"/evals-quality/setup-177","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"Any checks loaded: the case **passes** only if every **required** check's `passed` is `true`. Checks marked `required = false` are reported but never fail the case. Among required checks there is no partial credit and no threshold — they are all-or-nothing per case."},"2209":{"id":"/evals-quality/setup-178","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"A case whose checks are **all** advisory (`required = false`) has nothing that can fail it, so it passes as long as it does not time out. That is intentional, but it means an all-optional `checks.toml` is not a safety net."},"2210":{"id":"/evals-quality/setup-179","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"A trial that times out is always `error`, independent of checks."},"2211":{"id":"/evals-quality/setup-180","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"Across trials, `pass_threshold` decides the case's aggregated status: pass rate across trials must be `>= pass_threshold`."},"2212":{"id":"/evals-quality/setup-181","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"Once the manifest, CSV, and checks file exist:"},"2213":{"id":"/evals-quality/setup-182","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"`--output-dir` is **required** on `fastskill eval run` — there is no default. Omitting it fails argument parsing before anything else runs:"},"2214":{"id":"/evals-quality/setup-183","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive on both `eval run` and `eval validate` — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` additionally requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`); on `eval validate` both are optional — omit them to validate config without checking any agent's availability."},"2215":{"id":"/evals-quality/setup-184","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"See Run evals for the full day-to-day command set, artifact layout, and CI gating pattern."},"2216":{"id":"/evals-quality/setup-185","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"`[tool.fastskill.eval]` present with a `prompts` path that resolves."},"2217":{"id":"/evals-quality/setup-186","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Prompts CSV has `id`, `prompt`, `should_trigger` headers (plus `tags` / `workspace_subdir` if you use them)."},"2218":{"id":"/evals-quality/setup-187","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Each `should_trigger` value reflects the required consultation/non-consultation expectation; explicit `skill_invoked` checks do not contradict it."},"2219":{"id":"/evals-quality/setup-188","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Outcome correctness is measured separately where consultation alone is insufficient."},"2220":{"id":"/evals-quality/setup-189","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"`fastskill eval validate --all` passes and lists the agent you intend to run against as available."},"2221":{"id":"/evals-quality/setup-190","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Output directory convention agreed for `--output-dir` (local + CI)."},"2222":{"id":"/evals-quality/setup-191","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#see-also","content":"Run evals"},"2223":{"id":"/evals-quality/setup-192","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#see-also","content":"Cluster analysis"},"2224":{"id":"/evals-quality/setup-193","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#see-also","content":"eval command"},"2225":{"id":"/examples/advanced-patterns","page_id":"/examples/advanced-patterns","type":"page","content":"Advanced Patterns","breadcrumbs":["Docs","Reference","Workflow examples"],"tags":[],"url":"/examples/advanced-patterns"},"2226":{"id":"/examples/advanced-patterns-0","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns","content":"Analyze overlap, optimize skills, filter project groups, and manage editable and global skills."},"2227":{"id":"/examples/advanced-patterns-1","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#overview","content":"Overview"},"2228":{"id":"/examples/advanced-patterns-2","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Find duplicate and overlapping skills"},"2229":{"id":"/examples/advanced-patterns-3","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#improve-a-skill-with-optimization","content":"Improve a skill with `optimization`"},"2230":{"id":"/examples/advanced-patterns-4","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#install-only-part-of-a-collection-with-groups","content":"Install only part of a collection with groups"},"2231":{"id":"/examples/advanced-patterns-5","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"Editable and recursive local skills"},"2232":{"id":"/examples/advanced-patterns-6","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#project-vs-global-scope","content":"Project vs. global scope"},"2233":{"id":"/examples/advanced-patterns-7","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#overview","content":"These are real, source-backed workflows for teams managing many skills. Every command below exists in\nthe CLI."},"2234":{"id":"/examples/advanced-patterns-8","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"As a collection grows, skills drift into overlap. `fastskill analysis` surfaces that:"},"2235":{"id":"/examples/advanced-patterns-9","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`analysis duplicates` supports filtering and output control:"},"2236":{"id":"/examples/advanced-patterns-10","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Flag"},"2237":{"id":"/examples/advanced-patterns-11","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Purpose"},"2238":{"id":"/examples/advanced-patterns-12","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--threshold`"},"2239":{"id":"/examples/advanced-patterns-13","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Minimum similarity to report"},"2240":{"id":"/examples/advanced-patterns-14","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--limit`"},"2241":{"id":"/examples/advanced-patterns-15","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Maximum number of pairs to show"},"2242":{"id":"/examples/advanced-patterns-16","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--severity`"},"2243":{"id":"/examples/advanced-patterns-17","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Filter by minimum severity: `critical`, `high`, `medium`, `all`"},"2244":{"id":"/examples/advanced-patterns-18","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--format`"},"2245":{"id":"/examples/advanced-patterns-19","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`table`, `json`, `grid`, or `xml` (`--json` is shorthand)"},"2246":{"id":"/examples/advanced-patterns-20","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#improve-a-skill-with-optimization","content":"`fastskill optimization` runs a text-gradient loop to iteratively improve a skill's content:"},"2247":{"id":"/examples/advanced-patterns-21","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#install-only-part-of-a-collection-with-groups","content":"Skills can be tagged into groups; installs can include or exclude them (poetry-style):"},"2248":{"id":"/examples/advanced-patterns-22","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"For local skill development, add without copying and add whole trees at once:"},"2249":{"id":"/examples/advanced-patterns-23","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"After editing an editable skill in place, run `fastskill index rebuild` so semantic search and resolve\nreflect the changes."},"2250":{"id":"/examples/advanced-patterns-24","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#project-vs-global-scope","content":"Most commands default to the current project. Use `--global` to operate on the shared user-level\nskills directory (`~/.config/fastskill/skills`, tracked by `global-skills.lock`):"},"2251":{"id":"/examples/advanced-patterns-25","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#project-vs-global-scope","content":"Use `analysis` to keep a collection tidy, `optimization` to sharpen individual skills, and group\nfilters\nplus `--global` to control what gets installed where."},"2252":{"id":"/examples/integration-tutorials","page_id":"/examples/integration-tutorials","type":"page","content":"Integration Tutorials","breadcrumbs":["Docs","Reference","Workflow examples"],"tags":[],"url":"/examples/integration-tutorials"},"2253":{"id":"/examples/integration-tutorials-0","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials","content":"Connect FastSkill to agents and pipelines: MCP into Claude Code and Cursor, the serve HTTP API, and locked installs in CI."},"2254":{"id":"/examples/integration-tutorials-1","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#overview","content":"Overview"},"2255":{"id":"/examples/integration-tutorials-2","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"1\\. MCP into Claude Code"},"2256":{"id":"/examples/integration-tutorials-3","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"2\\. MCP into Cursor"},"2257":{"id":"/examples/integration-tutorials-4","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"3\\. Call the HTTP API from an app"},"2258":{"id":"/examples/integration-tutorials-5","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"4\\. Reproducible installs in CI"},"2259":{"id":"/examples/integration-tutorials-6","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#overview","content":"These tutorials cover FastSkill's real integration surfaces: the **MCP** server for agents, the\n**HTTP API** from `fastskill server serve`, and **locked installs** in CI. Each uses commands and endpoints\nthat exist in the tool."},"2260":{"id":"/examples/integration-tutorials-7","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"Expose FastSkill to Claude Code as MCP tools — read-only unless you start the server with\n`--enable-write`."},"2261":{"id":"/examples/integration-tutorials-8","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"Claude Code will now see tools named after complete command paths, such as\n`fastskill_skill_search`, `fastskill_skill_list`, `fastskill_skill_read`, and\n`fastskill_repo_show`. Mutating tools such as `fastskill_project_install` and\n`fastskill_repo_add` are withheld until the server is started with `--enable-write`; see\nWrite access. To point the agent at a running HTTP MCP\nserver instead of spawning FastSkill itself:"},"2262":{"id":"/examples/integration-tutorials-9","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"Same flow, different agent key:"},"2263":{"id":"/examples/integration-tutorials-10","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"Supported agents: `claude`, `cursor`, `gemini`, `copilot`, `opencode`, `codex`. See the full\nMCP tool-calling guide."},"2264":{"id":"/examples/integration-tutorials-11","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"Run the server and use the versioned `/api/v1/...` REST surface. Start read-only:"},"2265":{"id":"/examples/integration-tutorials-12","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"These are all read endpoints and work without `--enable-write`. To manage skills over HTTP (install /\nupdate / delete), start with `fastskill server serve --enable-write`, and front the port with an\nauthenticating proxy if it is exposed — `server serve` enforces no auth of its own. See the\n`server serve` reference and security model."},"2266":{"id":"/examples/integration-tutorials-13","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"Commit `skill-project.toml` and `skills.lock`, then install exact locked versions in the pipeline:"},"2267":{"id":"/examples/integration-tutorials-14","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"Set `OPENAI_API_KEY` from a CI secret if the pipeline needs semantic search or reindex; without it\nthose steps skip silently rather than failing."},"2268":{"id":"/examples/integration-tutorials-15","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"For agents, install FastSkill as an MCP server. For services and pipelines, use the `server serve`\nHTTP API and `project install --lock`. There is no separate SDK to integrate — the CLI, MCP tools,\nand HTTP API are the surface."},"2269":{"id":"/integration/agents","page_id":"/integration/agents","type":"page","content":"Documentation and tools for agents","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/agents"},"2270":{"id":"/integration/agents-0","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents","content":"Retrieve current FastSkill documentation as Markdown and use the CLI or MCP safely."},"2271":{"id":"/integration/agents-1","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#read-the-documentation","content":"Read the documentation"},"2272":{"id":"/integration/agents-2","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#inspect-the-cli-contract","content":"Inspect the CLI contract"},"2273":{"id":"/integration/agents-3","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#preview-apply-verify","content":"Preview, apply, verify"},"2274":{"id":"/integration/agents-4","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#agent-skills-and-mcp","content":"Agent skills and MCP"},"2275":{"id":"/integration/agents-5","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#read-the-documentation","content":"This site documents one release. The release number appears on every page and in\nall Markdown exports. Start with llms.txt, follow its per-page Markdown\nlinks, or download llms-full.txt. These URLs need no authentication\nor browser JavaScript. Each page also provides View Markdown and Copy Markdown."},"2276":{"id":"/integration/agents-6","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#inspect-the-cli-contract","content":"Match the binary version to the documentation. `cli spec` describes the installed\nbinary's complete command tree and flags. Use only the flags supported by that\ncommand; `--json` is not a global flag."},"2277":{"id":"/integration/agents-7","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#preview-apply-verify","content":"Check the process exit status and the returned diagnostics. A valid JSON response\ncan describe failure or partial success. Dry runs validate a plan without changing\nmanaged state; online plans can still fetch inputs. Use `--offline` when supported\nand when required verified content is already available locally."},"2278":{"id":"/integration/agents-8","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#agent-skills-and-mcp","content":"Installed skills provide task instructions. FastSkill's MCP tools provide package\noperations. They are separate interfaces; reading a skill does not require an MCP\nserver. See Claude Code and\nCursor for installation locations and registration."},"2279":{"id":"/integration/agents-9","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#agent-skills-and-mcp","content":"The server exposes read-only tools by default. Mutating tools require\n`mcp serve --enable-write`. Tool names use the full command path, for example\n`fastskill_skill_read` and `fastskill_project_install`. See\nMCP tool access for write configuration."},"2280":{"id":"/integration/claude-code-integration","page_id":"/integration/claude-code-integration","type":"page","content":"Claude Code Integration","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/claude-code-integration"},"2281":{"id":"/integration/claude-code-integration-0","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration","content":"Integrate FastSkill with Claude Code for intelligent skill discovery."},"2282":{"id":"/integration/claude-code-integration-1","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#overview","content":"Overview"},"2283":{"id":"/integration/claude-code-integration-2","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#quick-start","content":"Quick start"},"2284":{"id":"/integration/claude-code-integration-3","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#how-it-works","content":"How it works"},"2285":{"id":"/integration/claude-code-integration-4","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#github-actions","content":"GitHub Actions"},"2286":{"id":"/integration/claude-code-integration-5","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#troubleshooting","content":"Troubleshooting"},"2287":{"id":"/integration/claude-code-integration-6","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#mcp-registration","content":"MCP Registration"},"2288":{"id":"/integration/claude-code-integration-7","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#http-api","content":"HTTP API"},"2289":{"id":"/integration/claude-code-integration-8","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#overview","content":"Claude Code reads skills **directly** from the skills directory (`.claude/skills/` by\ndefault). FastSkill's job is to get the right skills onto disk and keep them reconciled with\nyour manifest — once a skill is installed, Claude Code discovers it natively. There is no\nmetadata file to generate or keep in sync."},"2290":{"id":"/integration/claude-code-integration-9","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#quick-start","content":"That's it — the next time Claude Code runs in this project, the installed skills are available."},"2291":{"id":"/integration/claude-code-integration-10","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"`fastskill project install` / `fastskill skill add` materializes skills into the configured\n`skills_directory` (default `.claude/skills/`)."},"2292":{"id":"/integration/claude-code-integration-11","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Each skill is a folder containing `SKILL.md` plus its resources."},"2293":{"id":"/integration/claude-code-integration-12","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Claude Code scans that directory and loads skills by their `SKILL.md` frontmatter — no\nexport or sync step is involved."},"2294":{"id":"/integration/claude-code-integration-13","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Use `fastskill skill read <skill-id>` to see exactly what an agent loads, or\n`fastskill skill read <skill-id> --meta` for just the metadata."},"2295":{"id":"/integration/claude-code-integration-14","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#github-actions","content":"Keep the skills directory reconciled in CI so commits always carry the resolved skill set:"},"2296":{"id":"/integration/claude-code-integration-15","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#troubleshooting","content":"**Claude Code doesn't see a skill:** Confirm it is installed with `fastskill skill list`, and that\nthe skills directory contains a valid `SKILL.md` for it. `fastskill skill read <skill-id>` should\nprint its content."},"2297":{"id":"/integration/claude-code-integration-16","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#troubleshooting","content":"**Wrong skills directory:** Claude Code and FastSkill must agree on the location. The default\nis `.claude/skills/`; override it via `skills_directory` under `[tool.fastskill]` in\n`skill-project.toml` or the `--skills-dir` flag."},"2298":{"id":"/integration/claude-code-integration-17","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#mcp-registration","content":"Register `fastskill` as an MCP server inside Claude Code with a single command:"},"2299":{"id":"/integration/claude-code-integration-18","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#mcp-registration","content":"After running the command, reload Claude Code. The tools exposed by\n`fastskill mcp serve --transport stdio` will be callable from the agent — the read-only ones only.\nMutating tools (`fastskill_project_install`, `fastskill_skill_add`,\n`fastskill_skill_remove`, …) require `mcp serve --enable-write`; see\nWrite access."},"2300":{"id":"/integration/claude-code-integration-19","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"`fastskill server serve` exposes FastSkill's versioned application API under `/api/v1/…`, for example `GET /api/v1/status` and `GET /api/v1/skills`."},"2301":{"id":"/integration/claude-code-integration-20","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"The old Claude-compatible `/v1/skills…` HTTP surface is no longer part of the public server. Use the MCP integration above for Claude Code and use `/api/v1/…` for HTTP clients."},"2302":{"id":"/integration/claude-code-integration-21","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"See the agent’s skill documentation for native discovery behavior."},"2303":{"id":"/integration/cursor-integration","page_id":"/integration/cursor-integration","type":"page","content":"Cursor Integration","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/cursor-integration"},"2304":{"id":"/integration/cursor-integration-0","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration","content":"Integrate FastSkill with Cursor IDE for intelligent skill discovery and tool recommendations."},"2305":{"id":"/integration/cursor-integration-1","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#overview","content":"Overview"},"2306":{"id":"/integration/cursor-integration-2","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#quick-start","content":"Quick start"},"2307":{"id":"/integration/cursor-integration-3","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#mcp-registration","content":"MCP registration"},"2308":{"id":"/integration/cursor-integration-4","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"How Cursor uses the skills"},"2309":{"id":"/integration/cursor-integration-5","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#example","content":"Example"},"2310":{"id":"/integration/cursor-integration-6","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#configuration","content":"Configuration"},"2311":{"id":"/integration/cursor-integration-7","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#multiple-skill-directories","content":"Multiple skill directories"},"2312":{"id":"/integration/cursor-integration-8","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#automation","content":"Automation"},"2313":{"id":"/integration/cursor-integration-9","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#troubleshooting","content":"Troubleshooting"},"2314":{"id":"/integration/cursor-integration-10","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#summary","content":"Summary"},"2315":{"id":"/integration/cursor-integration-11","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#overview","content":"Cursor discovers skills **directly** from the skills directory (`.claude/skills/` by default)\nand via the FastSkill MCP server. FastSkill's job is to install the right skills onto disk and\nkeep them reconciled with your manifest — there is no metadata file to generate or keep in sync."},"2316":{"id":"/integration/cursor-integration-12","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#overview","content":"Modern agents (Cursor, Claude Code, …) read installed skills from the skills directory natively.\nJust `fastskill project install` (or `fastskill skill add`) and the skills are available. Register the MCP\nserver below for richer, tool-based access from inside Cursor."},"2