s/` > default `.claude/skills/`"},"1905":{"id":"/configuration/init-command-60","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#schema-version","content":"`project init` writes the current manifest schema. Use the generated file as the\nstarting point and keep project configuration in version control."},"1906":{"id":"/configuration/init-command-61","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#embedding-configuration","content":"Semantic search uses OpenAI-compatible embeddings, configured under `[tool.fastskill.embedding]` in `skill-project.toml` (not created by `project init` — add it when you need it):"},"1907":{"id":"/configuration/init-command-62","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#embedding-configuration","content":"Set the API key via the environment; if it is unset, semantic search is silently skipped:"},"1908":{"id":"/configuration/init-command-63","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`skill-project.toml` is committed and shared by everyone on the project, so it is\nthe wrong place to record that *your* machine — or one CI job — talks to a\ndifferent embedding endpoint. Both non-secret fields can be overridden from the\nenvironment, and the environment wins:"},"1909":{"id":"/configuration/init-command-64","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"Variable"},"1910":{"id":"/configuration/init-command-65","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"Overrides"},"1911":{"id":"/configuration/init-command-66","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/in