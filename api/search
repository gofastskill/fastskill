ntent":"`--format <FORMAT>`"},"613":{"id":"/cli-reference/eval-command-50","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`table` or `json` only"},"614":{"id":"/cli-reference/eval-command-51","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--json`"},"615":{"id":"/cli-reference/eval-command-52","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Shorthand for `--format json`"},"616":{"id":"/cli-reference/eval-command-53","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--no-fail`"},"617":{"id":"/cli-reference/eval-command-54","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Exit zero even when the suite fails"},"618":{"id":"/cli-reference/eval-command-55","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--trials <N>`"},"619":{"id":"/cli-reference/eval-command-56","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override `trials_per_case` from the config for this run (1–1000)"},"620":{"id":"/cli-reference/eval-command-57","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--threshold <F>`"},"621":{"id":"/cli-reference/eval-command-58","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override `pass_threshold` from the config for this run (0.0–1.0)"},"622":{"id":"/cli-reference/eval-command-59","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--ci`"},"623":{"id":"/cli-reference/eval-command-60","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"CI mode: the suite passes when its overall pass rate meets the threshold, instead of requiring zero failed cases"},"624":{"id":"/cli-reference/eval-command-61","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--no-isolation`"},"625":{"id":"/cli-reference/eval-command-62","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run in the project root against the ambient agent environment (disables per-case isolation)"},"626":{"id":"/cli-reference/eval-command-63","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--judge`"},"627":{"id":"/cli-reference/eval-command-64","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Judge the run after scoring it, with the judges the checks file declares. Same function as `eval judge`"},"628":{"id":"/cli-reference/eval-command-65","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--judge-model <MODEL>`"},"629":{"id":"/cli-reference/eval-command-66","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override every judge's model, and record the override"},"630":{"id":"/cli-reference/eval-command-67","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"By default every case runs **isolated**: the skill next to `skill-project.toml` is deployed alone into a per-case scratch workspace, and the agent's user-level skill discovery is suppressed where the backend supports it (claude, codex, pi). Scores then measure the skill under test rather than whatever else is installed on your machine. Isolation needs a `SKILL.md` beside `skill-project.toml` and a `[metadata].id` naming the skill — missing either is a `EVAL_ISOLATION_NO_SKILL` error, not a silent fallback."},"631":{"id":"/cli-reference/eval-command-68","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"The summary reports what each run actually got (`isolation:` line in table output, `isolation` object in `summary.json`), and a failed case's scratch workspace is kept under `<run-dir>/workspaces/` for debugging. Pass `--no-isolation` to restore the old inherit-everything behaviour."},"632":{"id":"/cli-reference/eval-command-69","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"Scores recorded before isolation existed were measured against the ambient environment — expect trigger rates to re-baseline on the first isolated run."},"633":{"id":"/cli-reference/eval-command-70","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Scores a completed run with the LLM judges its checks file declares. `eval run --judge` calls the same function right after the run's own scoring — there is one judging implementation, so a run judged either way is judged identically."},"634":{"id":"/cli-reference/eval-command-71","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Option"},"635":{"id":"/cli-reference/eval-command-72","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Description"},"636":{"id":"/cli-reference/eval-command-73","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--run-dir <DIR>`"},"637":{"id":"/cli-reference/eval-command-74","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"**Required.** The per-agent run directory (`<output-dir>/<timestamp>/<agent>`)"},"638":{"id":"/cli-reference/eval-command-75","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--checks <FILE>`"},"639":{"id":"/cli-reference/eval-command-76","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Read `[[judge]]` from this file instead of the one the run recorded"},"640":{"id":"/cli-reference/eval-command-77","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--judge-model <MODEL>`"},"641":{"id":"/cli-reference/eval-command-78","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Override every judge's model, and record the override"},"642":{"id":"/cli-reference/eval-command-79","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--judge-parallel <N>`"},"643":{"id":"/cli-reference/eval-command-80","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Concurrent judge requests (1–1000); defaults to the run's recorded `parallel`"},"644":{"id":"/cli-reference/eval-command-81","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--rejudge`"},"645":{"id":"/cli-reference/eval-command-82","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Judge again even when the same request already has a judgment"},"646":{"id":"/cli-reference/eval-command-83","page_id":"/cli-r