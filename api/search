marketplacejson","content":"`--output <path>`: Output file path (default: `.claude-plugin/marketplace.json`)"},"3039":{"id":"/registry/marketplace-json-113","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--name <name>`: Repository name (required, or inferred from directory name)"},"3040":{"id":"/registry/marketplace-json-114","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--owner-name <name>`: Owner name (optional)"},"3041":{"id":"/registry/marketplace-json-115","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--owner-email <email>`: Owner email (optional)"},"3042":{"id":"/registry/marketplace-json-116","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--description <text>`: Repository description (optional)"},"3043":{"id":"/registry/marketplace-json-117","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--repo-version <version>`: Repository version (optional)"},"3044":{"id":"/registry/marketplace-json-118","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--base-url <url>`: Base URL for skill download links (optional)"},"3045":{"id":"/registry/marketplace-json-119","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"**Note**: The output file is automatically placed at `.claude-plugin/marketplace.json` (unless `--output` is specified)."},"3046":{"id":"/registry/marketplace-json-120","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"The command:"},"3047":{"id":"/registry/marketplace-json-121","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Scans for `SKILL.md` files"},"3048":{"id":"/registry/marketplace-json-122","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Reads `skill-project.toml` if present (takes priority for all fields)"},"3049":{"id":"/registry/marketplace-json-123","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Extracts metadata from `SKILL.md` YAML frontmatter as fallback"},"3050":{"id":"/registry/marketplace-json-124","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Applies field-by-field priority: skill-project.toml > SKILL.md"},"3051":{"id":"/registry/marketplace-json-125","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Generates the marketplace.json file in Claude Code format"},"3052":{"id":"/registry/marketplace-json-126","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"**Note**: `skill-project.toml` provides metadata support (id, version, description, author, tags, capabilities, download\\_url). The `id` field is required and must not contain slashes. The `name` field is not used in skill-project.toml - skill names for display come from `SKILL.md` frontmatter only. All fields in skill-project.toml take priority over SKILL.md frontmatter."},"3053":{"id":"/registry/marketplace-json-127","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"When generating `marketplace.json`, all metadata fields follow this priority order:"},"3054":{"id":"/registry/marketplace-json-128","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**skill-project.toml** `[metadata]` section (highest priority)"},"3055":{"id":"/registry/marketplace-json-129","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Fields: `id` (required, no slashes), `version` (required), `description`, `author`, `tags`, `capabilities`, `download_url`"},"3056":{"id":"/registry/marketplace-json-130","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"All fields from skill-project.toml take precedence over SKILL.md"},"3057":{"id":"/registry/marketplace-json-131","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"The `id` field is required and must not contain slashes or scope information"},"3058":{"id":"/registry/marketplace-json-132","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**SKILL.md** frontmatter (fallback)"},"3059":{"id":"/registry/marketplace-json-133","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Used for: `name` (display only), `description`, `author`, `tags`, `capabilities`"},"3060":{"id":"/registry/marketplace-json-134","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"`name` in SKILL.md is for display purposes only, not for package identification"},"3061":{"id":"/registry/marketplace-json-135","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"This field-by-field priority allows skill authors to:"},"3062":{"id":"/registry/marketplace-json-136","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Override specific fields in skill-project.toml while keeping others in SKILL.md"},"3063":{"id":"/registry/marketplace-json-137","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Supplement SKILL.md metadata with additional fields in skill-project.toml"},"3064":{"id":"/registry/marketplace-json-138","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Maintain version control separately from SKILL.md content"},"3065":{"id":"/registry/marketplace-json-139","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**Example**: If skill-project.toml has `version = \"2.0.0\"` but SKILL.md has `version: \"1.0.0\"`, the marketplace.json will use `\"2.0.0\"`. Similarly, if skill-project.toml has `author = \"New Author\"`, it will override the author from SKILL.md. The `name` field always comes from SKILL.md frontmatter for display purposes, as it is not present in skill-project.toml."},"3066":{"id":"/registry/marketplace-json-140","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"The registry validates `marketplace.json` files:"},"3067":{"id":"/registry/marketplace-json-141","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"All required fields must be present"},"3068":{"id":"/registry/marketplace-json-142","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"`id`, `name`, and `description` must not be empty"},"3069":{"id":"/registry/marketplace-json-143","page_id":"/registry/marketplace-j