elcome-6","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Skill"},"356":{"id":"/welcome-7","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Instructions and resources for a task"},"357":{"id":"/welcome-8","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"`skill-project.toml`"},"358":{"id":"/welcome-9","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Desired dependencies, sources, groups, and installation directory"},"359":{"id":"/welcome-10","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"`skills.lock`"},"360":{"id":"/welcome-11","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Selected versions, revisions, integrity evidence, and ownership"},"361":{"id":"/welcome-12","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Installed directory"},"362":{"id":"/welcome-13","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Files the agent can discover and read"},"363":{"id":"/welcome-14","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Bundle"},"364":{"id":"/welcome-15","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"A versioned ZIP containing a team skill set and its dependency closure"},"365":{"id":"/welcome-16","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill add` declares and installs a skill from a source."},"366":{"id":"/welcome-17","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install` restores compatible locked selections and resolves missing coverage."},"367":{"id":"/welcome-18","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install --lock` restores the locked selection without updating the lock."},"368":{"id":"/welcome-19","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill update` deliberately resolves changes allowed by the recorded constraints."},"369":{"id":"/welcome-20","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill remove` removes a direct owner; shared requirements can keep a skill installed."},"370":{"id":"/welcome-21","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill list --check` verifies the desired, locked, and installed state."},"371":{"id":"/welcome-22","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"Start with your first skill. Continue with\nmanifests and scope,\nteam bundles, or agent access."},"372":{"id":"/cli-reference/bundle-command","page_id":"/cli-reference/bundle-command","type":"page","content":"Bundle commands","breadcrumbs":["Docs","Share with teams"],"tags":[],"url":"/cli-reference/bundle-command"},"373":{"id":"/cli-reference/bundle-command-0","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command","content":"Build, install, update, restore, and customize self-contained team skill bundles."},"374":{"id":"/cli-reference/bundle-command-1","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#bundle-commands","content":"`bundle` commands"},"375":{"id":"/cli-reference/bundle-command-2","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#build-a-bundle","content":"Build a bundle"},"376":{"id":"/cli-reference/bundle-command-3","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#install-and-inspect","content":"Install and inspect"},"377":{"id":"/cli-reference/bundle-command-4","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#update-a-bundle","content":"Update a bundle"},"378":{"id":"/cli-reference/bundle-command-5","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove a bundle"},"379":{"id":"/cli-reference/bundle-command-6","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#personal-overrides","content":"Personal overrides"},"380":{"id":"/cli-reference/bundle-command-7","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#bundle-commands","content":"Bundles turn a selected team setup into one versioned ZIP. The artifact contains the selected\nskills, their installed dependency closure, resource files, and content digests. A recipient can\ninstall it without access to the original repositories."},"381":{"id":"/cli-reference/bundle-command-8","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Complete the quickstart, then add this declaration to that project's\nexisting `skill-project.toml`. Keep its `[dependencies]` and `[tool.fastskill]` sections."},"382":{"id":"/cli-reference/bundle-command-9","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Every bundle member must also appear in `[dependencies]`. The installed member version must\nsatisfy that declaration. FastSkill stops before writing an artifact when a declared member is\nmissing, has invalid frontmatter, or has a different version."},"383":{"id":"/cli-reference/bundle-command-10","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Build the release:"},"384":{"id":"/cli-reference/bundle-command-11","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"The result is `dist/notes-team-1.0.0.zip`. Its embedded identity, version, membership, and\ndigests are authoritative, so renaming the download does not change the release."},"385":{"id":"/cli-reference/bundle-command-12","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"In a second project initialized with `project init --yes --skills-dir .claude/skills`,\ninstall the artifact with `bundle add`. Replace the local path with the artifact you\nbuilt. The HTTPS URL below is an example for an artifact hosted by your team:"},"386":{"id":"/cli-reference/bundle-command-13","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Installation copies the artifact into `.fastskill/bundles/`, adds its declaration to\n`skill-project.toml`, and records the exact release and members in `skills.lock`."},"387":{"id":"/cli-reference/bundle-command-14","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Commit these files when teammates and CI need the same setup:"},"388":{"id":"/cli-reference/bundle-command-15","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Then restore the exact locked release:"},"389":{"id":"/cli-reference/bundle-command-16","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"`--lock` uses the bundle artifact, version, digest, and membership recorded in `skills.lock`.\nIt does not switch to a different release if the manifest has drifted. `--offline` additionally\nguarantees that restore does not contact a repository or embedding provider."},"390":{"id":"/cli-reference/bundle-command-17","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"Bundle updates are explicit. After building version `1.1.0` of your bundle, preview\nand apply that replacement:"},"391":{"id":"/cli-reference/bundle-command-18","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"FastSkill checks the new artifact, shared ownership, local modifications, and release immutability\nbefore it changes installed members. The preview runs the same validation as apply and reports\npolicy-only changes, such as a member becoming non-overridable, even when its bytes are unchanged."},"392":{"id":"/cli-reference/bundle-command-19","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove the bundle identity and the members that have no other owner:"},"393":{"id":"/cli-reference/bundle-command-20","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Removing a direct declaration detaches that owner. FastSkill retains the installed member while a\nbundle or another dependency root still requires it. An ID that is only a transitive requirement\ncannot be removed directly; the error names the roots that require it. A member is deleted only\nafter its final direct, transitive, bundle, and override owner is gone."},"394":{"id":"/cli-reference/bundle-command-21","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"An edited installed file is not an approved override. Put the customized skill in a separate\ndirectory and declare it explicitly. Every installed bundle that owns the skill must mark the\nmember as `overridable = true`."},"395":{"id":"/cli-reference/bundle-command-22","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"`fastskill project install` and `fastskill project install --lock` restore valid personal overrides after\nbundle members. Updates stop when a new bundle policy no longer permits an existing override."},"396":{"id":"/cli-reference/bundle-command-23","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"Return to the packaged member and clear the override records in one operation:"},"397":{"id":"/cli-reference/bundle-command-24","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"Reset is blocked if retained bundles disagree on the packaged bytes or if the installed member has\nuntracked edits. Removing the last bundle owner of a personal replacement keeps that replacement\nas an individual requirement instead of deleting it. FastSkill validates the replacement's complete\ndependency closure first; bundle removal is blocked if that closure cannot be retained."},"398":{"id":"/cli-reference/bundle-command-25","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"Every bundle action except `bundle list` changes files. The MCP server hides and refuses these\ntools unless it starts with `fastskill mcp serve --enable-write`."},"399":{"id":"/cli-reference/cache-command","page_id":"/cli-reference/cache-command","type":"page","content":"cache Command","breadcrumbs":["Docs","Reference","CLI commands","Operations"],"tags":[],"url":"/cli-reference/cache-command"},"400":{"id":"/cli-reference/cache-command-0","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command","content":"Inspect and reclaim the on-disk skill content cache with fastskill cache."},"401":{"id":"/cli-reference/cache-command-1","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#cache-command","content":"cache Command"},"402":{"id":"/cli-reference/cache-command-2","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#usage","content":"Usage"},"403":{"id":"/cli-reference/cache-command-3","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#subcommands","content":"Subcommands"},"404":{"id":"/cli-reference/cache-command-4","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#info","content":"info"},"405":{"id":"/cli-reference/cache-command-5","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#clean","content":"clean"},"406":{"id":"/cli-reference/cache-command-6","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#when-to-run-it","content":"When to run it"},"407":{"id":"/cli-reference/cache-command-7","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#see-also","content":"See Also"},"408":{"id":"/cli-reference/cache-command-8","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Inspect and reclaim the on-disk cache that `skill add`, `project install`, and `skill update` use so a skill's\ncontent is fetched once per machine instead of once per project."},"409":{"id":"/cli-reference/cache-command-9","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Every git, registry, or local skill fetch is checked against this cache before touching the\nnetwork again. `fastskill cache` is how to see what has accumulated there and reclaim disk\nspace -- fastskill never evicts cache entries on its own."},"410":{"id":"/cli-reference/cache-command-10","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"Show the cache location plus entry counts and disk usage, broken down by source kind (git,\nregistry, or local)."},"411":{"id":"/cli-reference/cache-command-11","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Example output**:"},"412":{"id":"/cli-reference/cache-command-12","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Options**:"},"413":{"id":"/cli-reference/cache-command-13","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--format <table|json>`: Output format (default: table)"},"414":{"id":"/cli-reference/cache-command-14","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--json`: Shorthand for `--format json` (mutually exclusive with `--format`)"},"415":{"id":"/cli-reference/cache-command-15","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"Remove cached skill content and print how many bytes were reclaimed."},"416":{"id":"/cli-reference/cache-command-16","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Options**:"},"417":{"id":"/cli-reference/cache-command-17","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--source <git|registry|local>`: Limit cleaning to one source kind (default: all)"},"418":{"id":"/cli-reference/cache-command-18","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--json`: Print the result as JSON instead of a summary line"},"419":{"id":"/cli-reference/cache-command-19","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**What it removes**: Only cached skill content -- the record of what a repository currently\nadvertises (what `repo refresh` writes) is left alone, so `repo refresh` output stays valid\nafter a clean. There is nothing to undo: the next `skill add`/`project install`/`skill update` that needs a removed\nentry re-fetches it from its original source."},"420":{"id":"/cli-reference/cache-command-20","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Safe with other fastskill processes running**: `clean` never removes an entry another process\nis mid-write on, and every write elsewhere is atomic. In the worst case, a fetch running at the\nexact moment of a clean simply re-fetches -- it never sees partial or corrupted content."},"421":{"id":"/cli-reference/cache-command-21","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache info`**: Before a `clean`, to see what is actually taking up space, or when disk\nusage seems higher than expected."},"422":{"id":"/cli-reference/cache-command-22","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache clean`**: To reclaim disk space after finishing with skills from a source no longer\nin use, or as routine cleanup on a machine used for many short-lived projects."},"423":{"id":"/cli-reference/cache-command-23","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"`repo` commands -- refresh what a repository advertises\n(`repo refresh`), independent of the content cache `cache` manages"},"424":{"id":"/cli-reference/cache-command-24","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"Install Command -- installs that hit this cache"},"425":{"id":"/cli-reference/discovery-commands","page_id":"/cli-reference/discovery-commands","type":"page","content":"Discover and inspect skills","breadcrumbs":["Docs","Reference","CLI commands","Sources and distribution"],"tags":[],"url":"/cli-reference/discovery-commands"},"426":{"id":"/cli-reference/discovery-commands-0","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Find a catalog result, inspect its origin, and install it explicitly."},"427":{"id":"/cli-reference/discovery-commands-1","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-installed-skills","content":"Search installed skills"},"428":{"id":"/cli-reference/discovery-commands-2","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-a-catalog","content":"Search a catalog"},"429":{"id":"/cli-reference/discovery-commands-3","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Complete the quickstart for local skills, or configure a real\ncatalog. Examples below use placeholder repository and skill IDs."},"430":{"id":"/cli-reference/discovery-commands-4","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-installed-skills","content":"Local keyword search needs no API key. Semantic search is optional and requires an\nindex and embedding provider."},"431":{"id":"/cli-reference/discovery-commands-5","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"Remote search is the default when `--local` is absent. Results identify the\ncanonical skill ID, repository, version, and installation command. Empty catalogs,\nmissing configuration, and partial failures are distinct outcomes; inspect both\nJSON diagnostics and exit status."},"432":{"id":"/cli-reference/discovery-commands-6","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"See search reference for filters and output formats,\nand repository reference for catalog operations."},"433":{"id":"/cli-reference/eval-command","page_id":"/cli-reference/eval-command","type":"page","content":"eval Command","breadcrumbs":["Docs","Reference","CLI commands","Quality"],"tags":[],"url":"/cli-reference/eval-command"},"434":{"id":"/cli-reference/eval-command-0","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command","content":"Validate, run, report, and score skill evaluation suites defined in skill-project.toml."},"435":{"id":"/cli-reference/eval-command-1","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#overview","content":"Overview"},"436":{"id":"/cli-reference/eval-command-2","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#usage","content":"Usage"},"437":{"id":"/cli-reference/eval-command-3","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-validate","content":"eval validate"},"438":{"id":"/cli-reference/eval-command-4","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-run","content":"eval run"},"439":{"id":"/cli-reference/eval-command-5","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#environment-isolation","content":"Environment isolation"},"440":{"id":"/cli-reference/eval-command-6","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-judge","content":"eval judge"},"441":{"id":"/cli-reference/eval-command-7","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-report","content":"eval report"},"442":{"id":"/cli-reference/eval-command-8","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-score","content":"eval score"},"443":{"id":"/cli-reference/eval-command-9","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-scorecard","content":"eval scorecard"},"444":{"id":"/cli-reference/eval-command-10","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-metrics-file","content":"The metrics file"},"445":{"id":"/cli-reference/eval-command-11","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Identity: what the numbers are about"},"446":{"id":"/cli-reference/eval-command-12","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-json-document","content":"The JSON document"},"447":{"id":"/cli-reference/eval-command-13","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-html-report","content":"The HTML report"},"448":{"id":"/cli-reference/eval-command-14","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"What is excluded, and why"},"449":{"id":"/cli-reference/eval-command-15","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#see-also","content":"See also"},"450":{"id":"/cli-reference/eval-command-16","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`fastskill eval` runs skill quality checks using prompts and rubrics under `[tool.fastskill.eval]` in `skill-project.toml`. Subcommands are `validate`, `run`, `judge`, `report`, `score`, and `scorecard`."},"451":{"id":"/cli-reference/eval-command-17","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`eval run` requires an agent on `PATH` for the chosen `--agent` key. Known keys are `aikit`, `claude`, `codex`, `cursor`, `gemini`, and `pi`. A key is accepted only when its CLI is detected on the current machine, so a typo and an uninstalled agent both error with `RUNTIME_UNKNOWN_ID`, which lists what was detected. Use `eval validate --agent <key>` or `--all` to verify availability."},"452":{"id":"/cli-reference/eval-command-18","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Checks eval configuration and files (optional agent presence check)."},"453":{"id":"/cli-reference/eval-command-19","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Option"},"454":{"id":"/cli-reference/eval-command-20","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Description"},"455":{"id":"/cli-reference/eval-command-21","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--agent <AGENT>`"},"456":{"id":"/cli-reference/eval-command-22","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify the given agent(s) are available; repeatable. Mutually exclusive with `--all`"},"457":{"id":"/cli-reference/eval-command-23","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--all`"},"458":{"id":"/cli-reference/eval-command-24","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify availability of every installed agent. Mutually exclusive with `--agent`"},"459":{"id":"/cli-reference/eval-command-25","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--model <MODEL>`"},"460":{"id":"/cli-reference/eval-command-26","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"The model `eval run` will target; a judge declaring the same one is reported as self-preference"},"461":{"id":"/cli-reference/eval-command-27","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--format <FORMAT>`"},"462":{"id":"/cli-reference/eval-command-28","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`table` or `json` only (eval does not support `grid`/`xml`)"},"463":{"id":"/cli-reference/eval-command-29","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--json`"},"464":{"id":"/cli-reference/eval-command-30","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Shorthand for `--format json`"},"465":{"id":"/cli-reference/eval-command-31","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Every `[[judge]]` in the checks file is validated from file content alone, so validate gives the same answer on a laptop and in CI. Errors: no resolvable `model`; neither or both of `prompt` / `prompt_file` (likewise for the system and retry pairs); an unknown `{{variable}}`; a `cases` id matching no case; duplicate criterion names; `scale` below 2; `min_score` outside `[0, 1]`; a prompt that never renders `{{output_contract}}`; any unknown key. Warnings: a prompt without `{{rubric}}`, and a judge sharing `--model`. Endpoint reachability and API keys are not checked here — judging checks those before its first request."},"466":{"id":"/cli-reference/eval-command-32","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"With `--agent` or `--all`, both outputs report each selected agent:\nthe table prints one `agent '<key>': available|unavailable` line per agent, and the JSON document carries an `agents` object keyed by agent id (`{\"agents\": {\"claude\": true}}`). An unavailable agent is an error unless `fail_on_missing_agent = false` is set in the eval config."},"467":{"id":"/cli-reference/eval-command-33","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Runs eval cases against an agent; writes artifacts under `--output-dir`."},"468":{"id":"/cli-reference/eval-command-34","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`)."},"469":{"id":"/cli-reference/eval-command-35","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Option"},"470":{"id":"/cli-reference/eval-command-36","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Description"},"471":{"id":"/cli-reference/eval-command-37","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <AGENT>`"},"472":{"id":"/cli-r