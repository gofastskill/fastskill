uality/setup-45","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"integer"},"2240":{"id":"/evals-quality/setup-46","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2241":{"id":"/evals-quality/setup-47","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`1`"},"2242":{"id":"/evals-quality/setup-48","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Trials run per case; validated to `[1, 1000]` (`EVAL_INVALID_TRIALS_CONFIG` otherwise)."},"2243":{"id":"/evals-quality/setup-49","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`parallel`"},"2244":{"id":"/evals-quality/setup-50","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"integer"},"2245":{"id":"/evals-quality/setup-51","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2246":{"id":"/evals-quality/setup-52","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"unset (CPU core count)"},"2247":{"id":"/evals-quality/setup-53","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Max concurrent trials for one case."},"2248":{"id":"/evals-quality/setup-54","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`pass_threshold`"},"2249":{"id":"/evals-quality/setup-55","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"float"},"2250":{"id":"/evals-quality/setup-56","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2251":{"id":"/evals-quality/setup-57","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`1.0`"},"2252":{"id":"/evals-quality/setup-58","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Fraction of trials that must pass for a case to be marked passed; validated to `[0.0, 1.0]` (`EVAL_INVALID_THRESHOLD` otherwise)."},"2253":{"id":"/evals-quality/setup-59","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`fail_on_missing_agent`"},"2254":{"id":"/evals-quality/setup-60","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"bool"},"2255":{"id":"/evals-quality/setup-61","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2256":{"id":"/evals-quality/setup-62","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"**`true`**"},"2257":{"id":"/evals-quality/setup-63","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"If true, `eval run` and `eval validate --agent <key>` error with `EVAL_AGENT_UNAVAILABLE` when the chosen agent isn't installed."},"2258":{"id":"/evals-quality/setup-64","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"**Defaults verified against source** (`crates/fastskill-core/src/core/manifest.rs::EvalConfigToml`): `timeout_seconds` defaults to **900**, and `fail_on_missing_agent` defaults to **true** — the CLI refuses to run against a missing agent unless you explicitly set it to `false`. Don't assume otherwise from older examples."},"2259":{"id":"/evals-quality/setup-65","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"With no `checks` file configured, each case still receives the required skill-consultation expectation implied by `should_trigger`. A successful process exit alone is not enough. Add a checks file for further deterministic outcome or adherence evidence."},"2260":{"id":"/evals-quality/setup-66","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#validate-the-config","content":"Real output against a working config (this one set `timeout_seconds = 120` and `fail_on_missing_agent = false`):"},"2261":{"id":"/evals-quality/setup-67","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#validate-the-config","content":"(`parallel: 0` here just means \"unset\" in the table renderer — the runner still falls back to CPU core count.) A broken `checks.toml` fails validation immediately, e.g.:"},"2262":{"id":"/evals-quality/setup-68","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#validate-the-config","content":"A prompts CSV missing a required column fails the same way:"},"2263":{"id":"/evals-quality/setup-69","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"The suite loader (`aikit-evals::suite`) reads a header row with **required** columns `id`, `prompt`, `should_trigger`, plus optional `tags` and `workspace_subdir`."},"2264":{"id":"/evals-quality/setup-70","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Column"},"2265":{"id":"/evals-quality/setup-71","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Required"},"2266":{"id":"/evals-quality/setup-72","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Meaning"},"2267":{"id":"/evals-quality/setup-73","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`id`"},"2268":{"id":"/evals-quality/setup-74","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"yes"},"2269":{"id":"/evals-quality/setup-75","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Non-empty identifier per row. Used for `--case`, artifact folder names, and reports."},"2270":{"id":"/evals-quality/setup-76","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`prompt`"},"2271":{"id":"/evals-quality/setup-77","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"yes"},"2272":{"id":"/evals-quality/setup-78","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Text sent to the agent. Use CSV quoting (`\"...\"`, doubled `\"\"` for an embedded quote) for commas or newlines."},"2273":{"id":"/evals-quality/setup-79","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`should_trigger`"},"2274":{"id":"/evals-quality/setup-80","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"yes"},"2275":{"id":"/evals-quality/setup-81","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`true`/`1` (case-insensitive `true`) or anything else counts as `false`. It creates a required per-case skill-consultation expectation; see below."},"2276":{"id":"/evals-quality/setup-82","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`tags`"},"2277":{"id":"/evals-quality/setup-83","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"no"},"2278":{"id":"/evals-quality/setup-84","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Comma-separated tags inside the cell (e.g. `\"smoke,basic\"`). Used by `eval run --tag <name>`."},"2279":{"id":"/evals-quality/setup-85","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`workspace_subdir`"},"2280":{"id":"/evals-quality/setup-86","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"no"},"2281":{"id":"/evals-quality/setup-87","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Relative path that becomes the agent's working directory for the case. Under the default isolation it is created **inside the case's scratch workspace**, with fixture files copied in from the same path under the project root; under `--no-isolation` it resolves directly under the project root. Empty or omitted → workspace root."},"2282":{"id":"/evals-quality/setup-88","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Empty lines are skipped."},"2283":{"id":"/evals-quality/setup-89","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"**`should_trigger` affects pass/fail.** The engine creates an implicit required `skill_invoked` check for each case, with `expected` equal to the CSV value. An explicit `skill_invoked` check that applies to the case replaces the implicit one; `eval validate` rejects a contradictory polarity. Therefore `false` tests non-consultation and `true` tests consultation, subject to the selected backend's observability."},"2284":{"id":"/evals-quality/setup-90","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"This is adherence/selection evidence, not outcome correctness. A structured `Skill` call is direct evidence; supported decoders may also recognize a tool input that references the staged skill-document path. The path proxy indicates consultation, not that the instructions were read or followed. Pair positive cases with outcome checks or judges."},"2285":{"id":"/evals-quality/setup-91","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#3-checks-checkstoml-optional","content":"Point `checks` at a TOML file with one or more `[[check]]` tables, keyed by the required `name` field. There are exactly five check types (`aikit_evals::checks::CheckDefinition`):"},"2286":{"id":"/evals-quality/setup-92","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#3-checks-checkstoml-optional","content":"**Checks score the canonical trace, never raw stdout.** Every check below matches against the run's `trace.jsonl` — the parsed, structured event stream. Raw stdout is deliberately excluded: with the `claude` agent it opens with a `system`/`project init` event listing **every skill installed in the environment**, which used to make any skill-name pattern pass vacuously. Assistant text still reaches the trace as message events, so matching on what the agent actually said continues to work."},"2287":{"id":"/evals-quality/setup-93","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"The check you almost certainly want for \"did my skill fire?\"."},"2288":{"id":"/evals-quality/setup-94","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Field"},"2289":{"id":"/evals-quality/setup-95","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Type"},"2290":{"id":"/evals-quality/setup-96","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Required"},"2291":{"id":"/evals-quality/setup-97","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Default"},"2292":{"id":"/evals-quality/setup-98","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`skill`"},"2293":{"id":"/evals-quality/setup-99","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"string"},"2294":{"id":"/evals-quality/setup-100","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2295":{"id":"/evals-quality/setup-101","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"— (omit to match *any* skill invocation)"},"2296":{"id":"/evals-quality/setup-102","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`expected`"},"2297":{"id":"/evals-quality/setup-103","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"bool"},"2298":{"id":"/evals-quality/setup-104","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2299":{"id":"/evals-quality/setup-105","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`true` (`false` asserts the skill did **not** run)"},"2300":{"id":"/evals-quality/setup-106","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`required`"},"2301":{"id":"/evals-quality/setup-107","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"bool"},"2302":{"id":"/evals-quality/setup-108","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2303":{"id":"/evals-quality/setup-109","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`true`"},"2304":{"id":"/evals-quality/setup-110","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`cases`"},"2305":{"id":"/evals-quality/setup-111","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"string array"},"2306":{"id":"/evals-quality/setup-112","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2307":{"id":"/evals-quality/setup-113","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"all cases (exact case IDs)"},"2308":{"id":"/evals-quality/setup-114","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Matches a structured `Skill` invocation or, where the decoder supplies it, a tool input referring to the staged skill-document path. When `skill` is given, a structured invocation must exactly match its identifying field. A skill name merely mentioned in unrelated prose does not count. Path-reference matching improves portability but remains a consultation proxy rather than proof of adherence."},"2309":{"id":"/evals-quality/setup-115","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Every check type supports `cases = [\"case-id\", ...]`, selecting exact case IDs. An absent selector applies to every case. Use selectors for checks that should not run across a mixed suite."},"2310":{"id":"/evals-quality/setup-116","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Field"},"2311":{"id":"/evals-quality/setup-117","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Type"},"2312":{"id":"/evals-quality/setup-118","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Required"},"2313":{"id":"/evals-quality/setup-119","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Default"},"2314":{"id":"/evals-quality/setup-120","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`pattern`"},"2315":{"id":"/evals-quality/setup-121","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"string"},"2316":{"id":"/evals-quality/setup-122","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"yes"},"2317":{"id":"/evals-quality/setup-123","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"—"},"2318":{"id":"/evals-quality/setup-124","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`expected`"},"2319":{"id":"/evals-quality/setup-125","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"bool"},"2320":{"id":"/evals-quality/setup-126","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"yes"},"2321":{"id":"/evals-quality/setup-127","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"— (`true` = pattern must appear, `false` = must NOT appear)"},"2322":{"id":"/evals-quality/setup-128","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`required`"},"2323":{"id":"/evals-quality/setup-129","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"bool"},"2324":{"id":"/evals-quality/setup-130","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"no"},"2325":{"id":"/evals-quality/setup-131","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`true`"},"2326":{"id":"/evals-quality/setup-132","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Matches `pattern` as a **plain substring** against the JSONL trace. Prefer `skill_invoked` for asserting that a skill ran; treat `trigger_expectation` as the escape hatch for matching arbitrary text the agent produced."},"2327":{"id":"/evals-quality/setup-133","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"Field"},"2328":{"id":"/evals-quality/setup-134","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"Type"},"2329":{"id":"/evals-quality/setup-135","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"Required"},"2330":{"id":"/evals-quality/setup-136","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"Default"},"2331":{"id":"/evals-quality/setup-137","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"`pattern`"},"2332":{"id":"/evals-quali