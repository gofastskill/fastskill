lls"},"3192":{"id":"/registry/marketplace-json-107","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#internal-processing","content":"Constructing download URLs from base repository URL + skill path"},"3193":{"id":"/registry/marketplace-json-108","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#internal-processing","content":"The conversion preserves all available metadata and enables FastSkill to work with Claude Code standard repositories."},"3194":{"id":"/registry/marketplace-json-109","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"Use the `fastskill marketplace create` command to generate `marketplace.json` in Claude Code format from a directory of skills:"},"3195":{"id":"/registry/marketplace-json-110","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"**Options:**"},"3196":{"id":"/registry/marketplace-json-111","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`<path>`: Directory to scan for skills (default: current directory)"},"3197":{"id":"/registry/marketplace-json-112","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--output <path>`: Output file path (default: `.claude-plugin/marketplace.json`)"},"3198":{"id":"/registry/marketplace-json-113","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--name <name>`: Repository name (required, or inferred from directory name)"},"3199":{"id":"/registry/marketplace-json-114","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--owner-name <name>`: Owner name (optional)"},"3200":{"id":"/registry/marketplace-json-115","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--owner-email <email>`: Owner email (optional)"},"3201":{"id":"/registry/marketplace-json-116","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--description <text>`: Repository description (optional)"},"3202":{"id":"/registry/marketplace-json-117","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--repo-version <version>`: Repository version (optional)"},"3203":{"id":"/registry/marketplace-json-118","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"`--base-url <url>`: Base URL for skill download links (optional)"},"3204":{"id":"/registry/marketplace-json-119","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#generating-marketplacejson","content":"**Note**: The output file is automatically placed at `.claude-plugin/marketplace.json` (unless `--output` is specified)."},"3205":{"id":"/registry/marketplace-json-120","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"The command:"},"3206":{"id":"/registry/marketplace-json-121","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Scans for `SKILL.md` files"},"3207":{"id":"/registry/marketplace-json-122","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Reads `skill-project.toml` if present (takes priority for all fields)"},"3208":{"id":"/registry/marketplace-json-123","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Extracts metadata from `SKILL.md` YAML frontmatter as fallback"},"3209":{"id":"/registry/marketplace-json-124","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Applies field-by-field priority: skill-project.toml > SKILL.md"},"3210":{"id":"/registry/marketplace-json-125","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"Generates the marketplace.json file in Claude Code format"},"3211":{"id":"/registry/marketplace-json-126","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#command-behavior","content":"**Note**: `skill-project.toml` provides metadata support (id, version, description, author, tags, capabilities, download\\_url). The `id` field is required and must not contain slashes. The `name` field is not used in skill-project.toml - skill names for display come from `SKILL.md` frontmatter only. All fields in skill-project.toml take priority over SKILL.md frontmatter."},"3212":{"id":"/registry/marketplace-json-127","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"When generating `marketplace.json`, all metadata fields follow this priority order:"},"3213":{"id":"/registry/marketplace-json-128","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**skill-project.toml** `[metadata]` section (highest priority)"},"3214":{"id":"/registry/marketplace-json-129","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Fields: `id` (required, no slashes), `version` (required), `description`, `author`, `tags`, `capabilities`, `download_url`"},"3215":{"id":"/registry/marketplace-json-130","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"All fields from skill-project.toml take precedence over SKILL.md"},"3216":{"id":"/registry/marketplace-json-131","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"The `id` field is required and must not contain slashes or scope information"},"3217":{"id":"/registry/marketplace-json-132","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**SKILL.md** frontmatter (fallback)"},"3218":{"id":"/registry/marketplace-json-133","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Used for: `name` (display only), `description`, `author`, `tags`, `capabilities`"},"3219":{"id":"/registry/marketplace-json-134","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"`name` in SKILL.md is for display purposes only, not for package identification"},"3220":{"id":"/registry/marketplace-json-135","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"This field-by-field priority allows skill authors to:"},"3221":{"id":"/registry/marketplace-json-136","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Override specific fields in skill-project.toml while keeping others in SKILL.md"},"3222":{"id":"/registry/marketplace-json-137","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Supplement SKILL.md metadata with additional fields in skill-project.toml"},"3223":{"id":"/registry/marketplace-json-138","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Maintain version control separately from SKILL.md content"},"3224":{"id":"/registry/marketplace-json-139","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**Example**: If skill-project.toml has `version = \"2.0.0\"` but SKILL.md has `version: \"1.0.0\"`, the marketplace.json will use `\"2.0.0\"`. Similarly, if skill-project.toml has `author = \"New Author\"`, it will override the author from SKILL.md. The `name` field always comes from SKILL.md frontmatter for display purposes, as it is not present in skill-project.toml."},"3225":{"id":"/registry/marketplace-json-140","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"The registry validates `marketplace.json` files:"},"3226":{"id":"/registry/marketplace-json-141","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"All required fields must be present"},"3227":{"id":"/registry/marketplace-json-142","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"`id`, `name`, and `description` must not be empty"},"3228":{"id":"/registry/marketplace-json-143","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"Skills with invalid data are skipped"},"3229":{"id":"/registry/marketplace-json-144","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Marketplace.json files are cached for 5 minutes to reduce network requests. To force a refresh:"},"3230":{"id":"/registry/marketplace-json-145","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Wait 5 minutes for cache expiry"},"3231":{"id":"/registry/marketplace-json-146","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Restart the server"},"3232":{"id":"/registry/marketplace-json-147","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Clear cache manually (future feature)"},"3233":{"id":"/registry/marketplace-json-148","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Keep it updated**: Regenerate `marketplace.json` when skills change"},"3234":{"id":"/registry/marketplace-json-149","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Use semantic versioning**: Use clear version identifiers"},"3235":{"id":"/registry/marketplace-json-150","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Include all metadata**: Provide tags, capabilities, and author information"},"3236":{"id":"/registry/marketplace-json-151","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Test accessibility**: Verify the URL is accessible from your environment"},"3237":{"id":"/registry/marketplace-json-152","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Version control**: Commit `marketplace.json` to your repository"},"3238":{"id":"/registry/marketplace-json-153","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#see-also","content":"Repository Command"},"3239":{"id":"/registry/marketplace-json-154","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#see-also","content":"Sources Configuration"},"3240":{"id":"/registry/marketplace-json-155","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#see-also","content":"Registry Overview"},"3241":{"id":"/registry/overview","page_id":"/registry/overview","type":"page","content":"Sources and catalogs","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/overview"},"3242":{"id":"/registry/overview-0","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview","content":"Discover skills from configured sources and choose how to distribute a team setup."},"3243":{"id":"/registry/overview-1","page_id":"/registry/overview","type":"heading","tags":[],"url":"/registry/overview#choose-a-source","content":"Choose a source"},"3244":{"id":"/registry/overview-2","page_id":"/registry/overview","type":"heading","tags":[],"url":"/registry/overview#discover-and-install","content":"Discover and install"},"3245":{"id":"/registry/overview-3","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview","content":"A repository configuration gives FastSkill a named source for discovering and\ninstalling skills. It is separate from the installed skill directory and from the\nlocal browser console."},"3246":{"id":"/registry/overview-4","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**Git marketplace**: a Git repository with a marketplace document."},"3247":{"id":"/registry/overview-5","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**HTTP registry**: an HTTP index and downloadable skill artifacts."},"3248":{"id":"/registry/overview-6","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**ZIP catalog**: a base URL exposing marketplace metadata and ZIP downloads."},"3249":{"id":"/registry/overview-7","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**Local catalog**: skill content and catalog metadata on disk."},"3250":{"id":"/registry/overview-8","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"See source configuration for the manifest fields, authentication,\nand direct Git origins. For an exact portable team setup, use\nbundles."},"3251":{"id":"/registry/overview-9","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#discover-and-install","content":"The following commands assume a configured repository named `team`; replace the\nexample skill ID with a result from that repository:"},"3252":{"id":"/registry/overview-10","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#discover-and-install","content":"Search discovers candidates; installation records a selected origin and content.\nCommit the manifest and lock together so teammates can restore the intended state.\nSee repository commands for management actions\nand marketplace.json for catalog authoring."},"3253":{"id":"/registry/repository-architecture","page_id":"/registry/repository-architecture","type":"page","content":"Choose a distribution model","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/repository-architecture"},"3254":{"id":"/registry/repository-architecture-0","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Decide between direct sources, catalogs, and self-contained team bundles."},"3255":{"id":"/registry/repository-architecture-1","page_id":"/registry/repository-architecture","type":"heading","tags":[],"url":"/registry/repository-architecture#discovery-and-installation","content":"Discovery and installation"},"3256":{"id":"/registry/repository-architecture-2","page_id":"/registry/repository-architecture","type":"heading","tags":[],"url":"/registry/repository-architecture#team-reproducibility","content":"Team reproducibility"},"3257":{"id":"/registry/repository-architecture-3","page_id":"/registry/repository-architecture","type":"heading","tags":[],"url":"/registry/repository-architecture#trust","content":"Trust"},"3258":{"id":"/registry/repository-architecture-4","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Need"},"3259":{"id":"/registry/repository-architecture-5","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Use"},"3260":{"id":"/registry/repository-architecture-6","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Iterate on one skill locally"},"3261":{"id":"/registry/repository-architecture-7","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A local dependency, optionally editable"},"3262":{"id":"/registry/repository-architecture-8","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Install a skill from a source repository"},"3263":{"id":"/registry/repository-architecture-9","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A Git origin with a branch or tag"},"3264":{"id":"/registry/repository-architecture-10","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Discover and select skills across a team"},"3265":{"id":"/registry/repository-architecture-11","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A Git marketplace, local catalog, HTTP registry, or ZIP catalog"},"3266":{"id":"/registry/repository-architecture-12","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Share an exact skill set without original source access"},"3267":{"id":"/registry/repository-architecture-13","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A self-contained bundle"},"3268":{"id":"/registry/repository-architecture-14","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#discovery-and-installation","content":"Catalog search returns metadata and an install reference. It does not install a\nskill. Adding a result records its origin and materializes the selected content.\nLocks record the resolved selection so restoration does not silently pick a newer\ncatalog version or Git commit."},"3269":{"id":"/registry/repository-architecture-15","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#discovery-and-installation","content":"A project's manifest defines its repository configuration. Give each catalog a\nunique name and use explicit repository selection where IDs overlap. See\nconfiguration examples."},"3270":{"id":"/registry/repository-architecture-16","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#team-reproducibility","content":"Commit the manifest and lock together. Preserve any local source files and bundled\nartifacts required for restoration. A fresh machine still needs network access for\nuncached remote dependencies; `--offline` cannot download missing content."},"3271":{"id":"/registry/repository-architecture-17","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#team-reproducibility","content":"For an artifact recipients can install without access to private source repositories,\nbuild a bundle. Bundles retain ownership so removing\none package does not remove a skill that another package still requires."},"3272":{"id":"/registry/repository-architecture-18","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#trust","content":"A digest proves that selected content has not changed; it does not establish that\nthe instructions or scripts are safe. Review sources before making them available\nto agents. See the security model."},"3273":{"id":"/registry/sources","page_id":"/registry/sources","type":"page","content":"Configure skill sources","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/sources"},"3274":{"id":"/registry/sources-0","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources","content":"Add skills from Git and configure local, Git marketplace, HTTP, and ZIP catalogs."},"3275":{"id":"/registry/sources-1","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#install-directly-from-git","content":"Install directly from Git"},"3276":{"id":"/registry/sources-2","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#migrating-from-tree-urls","content":"Migrating from `/tree/` URLs"},"3277":{"id":"/registry/sources-3","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#configure-a-catalog","content":"Configure a catalog"},"3278":{"id":"/registry/sources-4","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#registry-authentication","content":"Registry authentication"},"3279":{"id":"/registry/sources-5","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#publish-a-catalog","content":"Publish a catalog"},"3280":{"id":"/registry/sources-6","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources","content":"Complete the quickstart first. Commands below use example URLs and\nIDs: replace them with a repository you can access and a skill it actually contains."},"3281":{"id":"/registry/sources-7","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#install-directly-from-git","content":"Use one ref selector for a source. For a skill in a subdirectory, declare the clean\nclone URL and `subdir` in the manifest, then install it:"},"3282":{"id":"/registry/sources-8","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#install-directly-from-git","content":"Use this manifest form as the portable source of truth for subdirectories. It keeps the clone URL,\nbranch, and subdirectory explicit in committed project state.\nFastSkill uses system Git; install Git and ensure it can access the repository before\nadding private sources. Git credentials come from your Git configuration."},"3283":{"id":"/registry/sources-9","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"Manifests written by fastskill 0.9.221 and earlier recorded a GitHub browser link as the\ngit `url`, e.g., `https://github.com/your-org/skills/tree/main/review-notes`. Git cannot\nclone such a URL. Manifest `schema_version = \"2\"` splits it into the three fields shown\nabove, and fastskill performs that split while reading — no manual edit is needed. The\nrewritten form reaches disk the next time a command saves the manifest, e.g.,\n`skill add` or `skill remove` (`project install` reads it and updates only `skills.lock`). A `/tree/` URL in a manifest that\nalready declares `schema_version = \"2\"` is an error, and the message shows the corrected\nTOML."},"3284":{"id":"/registry/sources-10","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"One consequence is worth planning for: a manifest saved by a current fastskill declares\n`schema_version = \"2\"`, and fastskill 0.9.232 and earlier refuse to read it. Upgrade every\nmachine and CI job that shares the project before the first save."},"3285":{"id":"/registry/sources-11","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"The manifest records the requested origin/ref; the lock records the selected commit\nand integrity evidence. `project install --lock` restores that selection even when\na branch advances. `skill update` deliberately refreshes the origin. Repository\nversion/strategy controls do not apply to Git origins."},"3286":{"id":"/registry/sources-12","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"Offline restoration needs the verified source content in the local cache. A lockfile\nalone does not contain the source files. Run an online install first, or distribute\nself-contained bundles."},"3287":{"id":"/registry/sources-13","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"A catalog lets you discover skills and add them by their canonical IDs. Each\nrepository is an entry in `[[tool.fastskill.repositories]]` in `skill-project.toml`.\nLower priority numbers are searched first. Explicit `--repository NAME` selection\navoids ambiguity when several catalogs offer the same ID."},"3288":{"id":"/registry/sources-14","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"Relative local repository paths are resolved from the directory containing\n`skill-project.toml`. They therefore keep the same meaning when FastSkill is invoked from a\nnested project directory."},"3289":{"id":"/registry/sources-15","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"`zip_url` is the manifest field for a ZIP catalog's base URL. Direct ZIP dependency\norigins use `origin.type = \"zip-url\"` and `origin.url` instead. These are different\nconfiguration objects."},"3290":{"id":"/registry/sources-16","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"Omit `auth` for public catalogs. Never put a token in a committed manifest:\n`auth` names where the token comes from, not the token itself. Repository auth does\nnot replace system Git authentication."},"3291":{"id":"/registry/sources-17","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`auth.type`"},"3292":{"id":"/registry/sources-18","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"Token source"},"3293":{"id":"/registry/sources-19","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"Header sent"},"3294":{"id":"/registry/sources-20","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"Where it may be configured"},"3295":{"id":"/registry/sources-21","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`pat`"},"3296":{"id":"/registry/sources-22","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`env_var`"},"3297":{"id":"/registry/sources-23","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`Authorization: token …`"},"3298":{"id":"/registry/sources-24","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`skill-project.toml` or user file"},"3299":{"id":"/registry/sources-25","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`bearer`"},"3300":{"id":"/registry/sources-26","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`env_var`"},"3301":{"id":"/registry/sources-27","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`Authorization: Bearer …`"},"3302":{"id":"/registry/sources-28","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`skill-project.toml` or user file"},"3303":{"id":"/registry/sources-29","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`command`"},"3304":{"id":"/registry/sources-30","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"first line printed by `command`"},"3305":{"id":"/registry/sources-31","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`Authorization: Bearer …`"},"3306":{"id":"/registry/sources-32","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"user file only"},"3307":{"id":"/registry/sources-33","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"`bearer` and `command` apply to `http-registry` repositories. With either one, a\nmissing variable or a failing command is an error; FastSkill never retries the\nrequest without credentials. `pat` keeps its existing behaviour and sends no header\nwhen its variable is unset."},"3308":{"id":"/registry/sources-34","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"For a registry that requires a bearer token, name the variable in the manifest:"},"3309":{"id":"/registry/sources-35","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"When the token is short-lived, let a program print it, such as an identity provider\nCLI or a CI job's token exchange. A credential command can only be configured in your\nuser repositories file, `repositories.toml` in FastSkill's configuration directory\n(`$XDG_CONFIG_HOME/fastskill/` when set, otherwise the platform config directory). A\n`skill-project.toml` that names a command is refused, so cloning a project can never\nmake FastSkill run a program."},"3310":{"id":"/registry/sources-36","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"A user entry replaces a project entry with the same name, for listing, resolution\nand install alike. How the command runs:"},"3311":{"id":"/registry/sources-37","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"It runs directly, without a shell, from FastSkill's configuration directory, and is\nstopped after 30 seconds."},"3312":{"id":"/registry/sources-38","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"The token is the first line of standard output with the trailing line ending\nremoved. Output over 16 KiB, an empty token, or a non-zero exit is an error. Errors\nname the program and its exit status, never the token."},"3313":{"id":"/registry/sources-39","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"Standard error reaches your terminal only when there is one, so the command can\nprompt you to sign in. When standard input or standard error is not a terminal,\nFastSkill sets `FASTSKILL_INTERACTIVE=0`: the command must then print a token\nwithout prompting, or exit non-zero."},"3314":{"id":"/registry/sources-40","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"It runs at most once per FastSkill process for each repository. The token stays in\nmemory; FastSkill never writes it to disk or prints it."},"3315":{"id":"/registry/sources-41","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"The token is sent only to the origin (scheme, host and port) of `index_url`. A\ndownload on another origin gets no token and must carry its own authorization, such\nas a pre-signed URL. A redirect to another origin is followed without the token, and\na redirect from `https` to `http` is refused."},"3316":{"id":"/registry/sources-42","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"You can also manage sources through the CLI:"},"3317":{"id":"/registry/sources-43","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#registry-authentication","content":"Search results identify the repository, canonical skill ID, version, and install\ncommand. Remote search can fail partially; inspect the exit status and diagnostics\ninstead of treating partial results as a complete catalog response."},"3318":{"id":"/registry/sources-44","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#publish-a-catalog","content":"Git marketplaces and ZIP catalogs describe skills using\nmarketplace.json. HTTP registries expose an\nindex. FastSkill does not provide a CLI publish service;\nhost catalog files and artifacts using your distribution infrastructure."},"3319":{"id":"/registry/sources-45","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#publish-a-catalog","content":"For sharing an already installed set without access to its original sources, use\nbundles. For all repository actions and flags, see\nrepository reference."},"3320":{"id":"/registry/web-ui","page_id":"/registry/web-ui","type":"page","content":"Local browser console","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/web-ui"},"3321":{"id":"/registry/web-ui-0","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui","content":"Inspect installed skills and manage a project through the optional HTTP server."},"3322":{"id":"/registry/web-ui-1","page_id":"/registry/web-ui","type":"heading","tags":[],"url":"/registry/web-ui#write-operations","content":"Write operations"},"3323":{"id":"/registry/web-ui-2","page_id":"/registry/web-ui","type":"heading","tags":[],"url":"/registry/web-ui#troubleshooting","content":"Troubleshooting"},"3324":{"id":"/registry/web-ui-3","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui","content":"Complete the quickstart or open an existing configured project, then run:"},"3325":{"id":"/registry/web-ui-4","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui","content":"Open `http://localhost:8080/`. The console loads project information and the installed\nskills table. Type in the search field to filter the loaded rows; select a skill\nfor its details. Catalog discovery is available through repository commands\nand the registry HTTP endpoints."},"3326":{"id":"/registry/web-ui-5","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#write-operations","content":"The console reads server capabilities before exposing write controls. Start with\nwrite access only when you intend to change installed skills:"},"3327":{"id":"/registry/web-ui-6","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#write-operations","content":"With writes enabled, the console provides an install form, eligible skill updates,\nremoval controls, and an update-all action. Reindexing additionally requires an\nembedding provider. A successful operation refreshes the displayed state; inspect\nerrors when a source cannot resolve or ownership prevents removal."},"3328":{"id":"/registry/web-ui-7","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#write-operations","content":"The server has no built-in authentication. Use it locally, or put authentication\nand network restrictions in front of it when exposing it to other users. Read-only\naccess still reveals skill content. See the security model."},"3329":{"id":"/registry/web-ui-8","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If the table does not load, check that the server is running in the correct project\nand inspect `fastskill cli doctor` output."},"3330":{"id":"/registry/web-ui-9","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If write controls are absent, verify that you started with `--enable-write`."},"3331":{"id":"/registry/web-ui-10","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If reindexing is unavailable, configure the optional embedding provider."},"3332":{"id":"/registry/web-ui-11","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If a skill cannot be removed, inspect its owners and reconciliation state."},"3333":{"id":"/registry/web-ui-12","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"For the HTTP contract, health checks, and server flags, see\nserver reference."},"3334":{"id":"/security/best-practices","page_id":"/security/best-practices","type":"page","content":"Security Best Practices","breadcrumbs":["Docs","Reference","Security"],"tags":[],"url":"/security/best-practices"},"3335":{"id":"/security/best-practices-0","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices","content":"Operational guidance for running FastSkill safely: read-only serve, auth proxies, PAT env-var indirection, and locked CI installs."},"3336":{"id":"/security/best-practices-1","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#overview","content":"Overview"},"3337":{"id":"/security/best-practices-2","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#running-fastskill-server-serve","content":"Running `fastskill server serve`"},"3338":{"id":"/security/best-practices-3","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#repository-credentials","content":"Repository credentials"},"3339":{"id":"/security/best-practices-4","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#reproducible-installs-in-ci","content":"Reproducible installs in CI"},"3340":{"id":"/security/best-practices-5","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#verify-configuration","content":"Verify configuration"},"3341":{"id":"/security/best-practices-6","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#overview","content":"These are the concrete, source-backed practices for operating FastSkill safely. They follow directly\nfrom the security model: FastSkill is a package manager with no in-app auth, so\nprotection comes from *how you run and expose it*."},"3342":{"id":"/security/best-practices-7","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Expose read-only.** For a browsable UI or REST view over your skills, run `fastskill server serve`\n**without** `--enable-write`. Every mutation endpoint returns HTTP 403, so an exposed instance\ncannot install, update, delete, reindex, or refresh anything."},"3343":{"id":"/security/best-practices-8","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Only pass `--enable-write` when you mean it.** Enable writes for local skill management from the\nbrowser/API — ideally on `localhost` only. Do not combine `--enable-write` with an open,\nunfronted port."},"3344":{"id":"/security/best-practices-9","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Front an exposed port with an authenticating proxy.** `server serve` enforces no authentication of its\nown and is *not* a security boundary. If the port is reachable off your machine, put a reverse\nproxy or sidecar in front that owns authentication, and make sure the app port is not directly\nreachable. Binding a non-loopback address is fine and expected behind such a proxy."},"3345":{"id":"/security/best-practices-10","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Use the health probes for orchestration**, not for security: `GET /healthz` (liveness) and\n`GET /readyz` (readiness)."},"3346":{"id":"/security/best-practices-11","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Use PAT env-var indirection.** Reference tokens by environment variable in\n`skill-project.toml`, never inline:"},"3347":{"id":"/security/best-practices-12","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Never commit plaintext tokens.** Keep them in your shell profile, CI secret store, or a secrets\nmanager. Commit `skill-project.toml`; keep the token value out of the repo."},"3348":{"id":"/security/best-practices-13","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Registry credentials stay on the registry origin.** FastSkill sends the configured PAT or\nbearer token to index and artifact URLs only when they have the same scheme, host, and port as\n`index_url`. Use a pre-signed URL or separately authenticated delivery layer when artifacts are\nhosted on another origin."},"3349":{"id":"/security/best-practices-14","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Prefer short-lived tokens from a credential command.** Configure it with\n`fastskill repo add --user --auth-type command --credential-command <program>`; it is saved to\nyour user `repositories.toml`, never to the project. In CI and hooks the command sees\n`FASTSKILL_INTERACTIVE=0`, so it must print a token without prompting or exit non-zero."},"3350":{"id":"/security/best-practices-15","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Set `OPENAI_API_KEY` via secrets** where semantic search / reindex is used. If it is unset,\nembedding-based features silently skip rather than failing — but do not paste the key into config\nor version control."},"3351":{"id":"/security/best-practices-16","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#reproducible-installs-in-ci","content":"**Commit `skill-project.toml` and `skills.lock`.**"},"3352":{"id":"/security/best-practices-17","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#reproducible-installs-in-ci","content":"**Use `fastskill project install --lock` in CI** so builds install the exact locked versions rather than\nre-resolving. This makes installs reproducible and verifiable across environments. See the\ncheatsheet for the full manifest workflow."},"3353":{"id":"/security/best-practices-18","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#verify-configuration","content":"Run `fastskill cli doctor` (add `--json` for machine output) to confirm the skills directory,\n`skill-project.toml`, embedding configuration, `OPENAI_API_KEY`, and auth token are set up as\nexpected before deploying. See Debugging."},"3354":{"id":"/security/best-practices-19","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#verify-configuration","content":"FastSkill deliberately has **no audit-logging feature** and **no in-app auth** — do not rely on it\nfor either. Request logging, authentication, and network policy belong to the proxy and platform\nthat front an exposed instance."},"3355":{"id":"/security/managed-machines","page_id":"/security/managed-machines","type":"page","content":"Hardening managed machines","breadcrumbs":["Docs","Reference","Security"],"tags":[],"url":"/security/managed-machines"},"3356":{"id":"/security/managed-machines-0","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines","content":"What FastSkill enforces on a machine that follows a managed state, what it cannot, and what an administrator pins through device management: the system file, keys, hooks and the machine-wide timer."},"3357":{"id":"/security/managed-machines-1","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#hardening-managed-machines","content":"Hardening managed machines"},"3358":{"id":"/security/managed-machines-2","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#what-fastskill-enforces","content":"What FastSkill enforces"},"3359":{"id":"/security/managed-machines-3","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#how-fast-a-block-lands","content":"How fast a block lands"},"3360":{"id":"/security/managed-machines-4","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#the-system-file","content":"The system file"},"3361":{"id":"/security/managed-machines-5","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#keys","content":"Keys"},"3362":{"id":"/security/managed-machines-6","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#the-credential-command","content":"The credential command"},"3363":{"id":"/security/managed-machines-7","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#administrator-level-hooks","content":"Administrator-level hooks"},"3364":{"id":"/security/managed-machines-8","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#the-machine-wide-timer","content":"The machine-wide timer"},"3365":{"id":"/security/managed-machines-9","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#agents","content":"Agents"},"3366":{"id":"/security/managed-machines-10","page_id":"/security/managed-machines","type":"heading","tags":[],"url":"/security/managed-machines#several-users-on-one-machine","content":"Several users on one machine"},"3367":{"id":"/security/managed-machines-11","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#hardening-managed-machines","content":"`fastskill managed` is cooperative configuration management\nwith integrity checks. It is not a sandbox. This page says where FastSkill enforces a\nmanaged state, where it can't, and what an administrator pins so\nthat following the state is the default path on every machine."},"3368":{"id":"/security/managed-machines-12","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"FastSkill enforces the state at its own operations, and nowhere else:"},"3369":{"id":"/security/managed-machines-13","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"**`managed apply`** deploys the listed skills into each agent's user skills folder, removes the\nones it placed that are no longer listed, and moves blocked content into the quarantine. With\n`allowed = listed` and `exclusive_targets = true`, content in an agent folder that the state\ndoesn't allow is quarantined too."},"3370":{"id":"/security/managed-machines-14","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"**Installs** are checked by digest before anything changes: `skill add`, `skill update`,\n`bundle add`, `bundle update`, `bundle override`, `project install` and restoring personal\noverrides, and the same through `server serve` and `mcp serve`. Blocked content is refused;\nwith `allowed = listed`, so is anything the state doesn't list."},"3371":{"id":"/security/managed-machines-15","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"**`skill list --check`** fails on `managed-blocked` and `managed-not-allowed`."},"3372":{"id":"/security/managed-machines-16","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"What this protects against:"},"3373":{"id":"/security/managed-machines-17","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"a state that was altered, replayed, or issued for another source or another subject, whether\nit arrives over the network, from a cache, from a file or git source, or from a mirror"},"3374":{"id":"/security/managed-machines-18","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"a repository that tries to change the managed source, or run a command, through project\nconfiguration: managed settings in a project file are refused, with an error naming the file"},"3375":{"id":"/security/managed-machines-19","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"other users on the same machine who aren't its administrator"},"3376":{"id":"/security/managed-machines-20","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"a user installing blocked content by mistake, directly or through a project"},"3377":{"id":"/security/managed-machines-21","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"What it doesn't protect against:"},"3378":{"id":"/security/managed-machines-22","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"**The machine's administrator.**"},"3379":{"id":"/security/managed-machines-23","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"**The user acting deliberately.** They can copy files into an agent folder between applies,\nmove the clock, or start an agent without hooks. `required = true` makes following the state\nthe default path and refuses FastSkill's own operations until a valid state is cached. It\ndoesn't stop a determined user. Hard enforcement means configuring the agent itself, through\ndevice management, to load only the folders FastSkill manages; few agents can be configured that\nway today (see Agents)."},"3380":{"id":"/security/managed-machines-24","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#what-fastskill-enforces","content":"**Whoever holds a pinned signing key.** A key holder decides what enrolled machines install."},"3381":{"id":"/security/managed-machines-25","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#how-fast-a-block-lands","content":"A blocked digest reaches a machine at its next successful apply: at login, hourly, and at every\nagent session start where a hook exists. A machine that is on and can sign in applies it within\nabout 70 minutes, and its agents drop the skill from their next session. A machine that stops\napplying keeps what it has, however long that lasts: off, offline, or waiting for a sign-in.\nExpiry limits how long FastSkill keeps allowing installs under an old state, not how long\ninstalled content stays. The report tells a source\nwhich machines haven't applied recently."},"3382":{"id":"/security/managed-machines-26","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"Device management deploys the system file at a fixed location:"},"3383":{"id":"/security/managed-machines-27","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"Platform"},"3384":{"id":"/security/managed-machines-28","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"Path"},"3385":{"id":"/security/managed-machines-29","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"Linux"},"3386":{"id":"/security/managed-machines-30","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"`/etc/fastskill/managed.toml`"},"3387":{"id":"/security/managed-machines-31","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"macOS"},"3388":{"id":"/security/managed-machines-32","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"`/Library/Application Support/FastSkill/managed.toml`"},"3389":{"id":"/security/managed-machines-33","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"Windows"},"3390":{"id":"/security/managed-machines-34","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"`%ProgramData%\\FastSkill\\managed.toml`"},"3391":{"id":"/security/managed-machines-35","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"FastSkill honors it only when the file and its folder are owned by the administrator account\n(root, or Administrators or SYSTEM) and nobody else can write to them; otherwise it refuses to run\nand names the problem. A value in the system file wins over the same value in the user file, and\nno managed setting is ever read from a project, an environment variable or a flag."},"3392":{"id":"/security/managed-machines-36","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-system-file","content":"When the system file names the source, the first apply enrolls each user: nobody has to run\n`fastskill managed enroll`. With `required = true`, `fastskill managed unenroll` is refused."},"3393":{"id":"/security/managed-machines-37","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#keys","content":"Pin the verification keys in the system file, so that no user can add one. Pin a new key before\nthe source signs with it, and unpin a key to revoke it: FastSkill verifies the cached state every\ntime it uses it, so a state signed only by an unpinned key stops counting at the next command.\nKeep the private key where the machines never reach it. FastSkill never needs it; only the source\nsigns."},"3394":{"id":"/security/managed-machines-38","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-credential-command","content":"When the source needs a sign-in, name the credential command in the system file by absolute\npath, pointing at a program only the administrator can change. It runs without a shell, and the\ntoken it prints goes only to the source's origin. From a hook or the timer there is no terminal,\nso `FASTSKILL_INTERACTIVE=0` is set and the command should fail at once instead of prompting; the\nuser's next `fastskill managed apply` from a terminal signs in again."},"3395":{"id":"/security/managed-machines-39","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`fastskill managed hooks --system` prints, for each agent that runs a command at session start,\nthe entry to merge into the agent's administrator-level settings. Device management places those\nfiles; FastSkill never writes them. When an administrator-level FastSkill hook is present for an\nagent, apply registers no user-level one, so there is no hook for the user to approve."},"3396":{"id":"/security/managed-machines-40","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"Agent"},"3397":{"id":"/security/managed-machines-41","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"Linux"},"3398":{"id":"/security/managed-machines-42","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"macOS"},"3399":{"id":"/security/managed-machines-43","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"Windows"},"3400":{"id":"/security/managed-machines-44","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"Claude Code"},"3401":{"id":"/security/managed-machines-45","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`/etc/claude-code/managed-settings.json`"},"3402":{"id":"/security/managed-machines-46","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`/Library/Application Support/ClaudeCode/managed-settings.json`"},"3403":{"id":"/security/managed-machines-47","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`C:\\Program Files\\ClaudeCode\\managed-settings.json`"},"3404":{"id":"/security/managed-machines-48","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"Gemini CLI"},"3405":{"id":"/security/managed-machines-49","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`/etc/gemini-cli/settings.json`"},"3406":{"id":"/security/managed-machines-50","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`/Library/Application Support/GeminiCli/settings.json`"},"3407":{"id":"/security/managed-machines-51","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#administrator-level-hooks","content":"`C:\\ProgramData\\gemini-cli\\settings.json`"},"3408":{"id":"/security/managed-machines-52","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"The same command prints the machine-wide timer: the files to place, and the commands to run\nafter placing them. When a machine-wide timer is present, apply installs no per-user one."},"3409":{"id":"/security/managed-machines-53","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"Platform"},"3410":{"id":"/security/managed-machines-54","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"What device management places"},"3411":{"id":"/security/managed-machines-55","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"Linux"},"3412":{"id":"/security/managed-machines-56","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"`/etc/systemd/user/fastskill-managed-apply.timer` and `.service`, a systemd user unit for every user"},"3413":{"id":"/security/managed-machines-57","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"macOS"},"3414":{"id":"/security/managed-machines-58","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"`/Library/LaunchAgents/dev.fastskill.managed-apply.plist`, loaded at each user's next login"},"3415":{"id":"/security/managed-machines-59","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"Windows"},"3416":{"id":"/security/managed-machines-60","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"`C:\\ProgramData\\fastskill\\managed-apply-task.xml`, registered with `schtasks`"},"3417":{"id":"/security/managed-machines-61","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#the-machine-wide-timer","content":"Each run applies at login and then every hour, after a random wait of up to ten minutes, so a\nfleet doesn't fetch all at once."},"3418":{"id":"/security/managed-machines-62","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Hard enforcement lives in the agent: one configured, through device management, to load skills\nonly from the folders FastSkill manages. What each agent allows, as checked against its\ndocumentation on 2026-09-24. \"Shared folder\" says whether the agent reads `~/.agents/skills`;\n\"same session\" says whether a skill written by its session-start hook shows up in that session."},"3419":{"id":"/security/managed-machines-63","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Agent"},"3420":{"id":"/security/managed-machines-64","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Shared folder"},"3421":{"id":"/security/managed-machines-65","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Command hook at session start"},"3422":{"id":"/security/managed-machines-66","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Administrator-level hooks"},"3423":{"id":"/security/managed-machines-67","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Same session"},"3424":{"id":"/security/managed-machines-68","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Claude Code"},"3425":{"id":"/security/managed-machines-69","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3426":{"id":"/security/managed-machines-70","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes; output reaches the model"},"3427":{"id":"/security/managed-machines-71","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"managed settings"},"3428":{"id":"/security/managed-machines-72","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3429":{"id":"/security/managed-machines-73","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Cursor (IDE and CLI)"},"3430":{"id":"/security/managed-machines-74","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3431":{"id":"/security/managed-machines-75","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes, not awaited; output not shown"},"3432":{"id":"/security/managed-machines-76","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"`/etc/cursor/hooks.json`"},"3433":{"id":"/security/managed-machines-77","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3434":{"id":"/security/managed-machines-78","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Codex CLI"},"3435":{"id":"/security/managed-machines-79","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3436":{"id":"/security/managed-machines-80","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes; user hooks need approval"},"3437":{"id":"/security/managed-machines-81","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"managed hooks, no approval"},"3438":{"id":"/security/managed-machines-82","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"later"},"343