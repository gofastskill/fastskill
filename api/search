-42","page_id":"/optimize/running","tags":[],"type":"text","url":"/optimize/running#run-directory-layout","content":"Step directories are `steps/step_{NNNN}` — zero-padded and **0-based**, matching the `step`\ncolumn in `optimization status` and the `--step` argument to `optimization inspect`. Skill versions\nare numbered by *accepted* steps, not by step index, so they diverge from step numbers once\nany step has been rejected."},"2875":{"id":"/optimize/running-43","page_id":"/optimize/running","tags":[],"type":"text","url":"/optimize/running#run-directory-layout","content":"The run directory is safe to copy, archive, or share. Resume and inspect commands only need this directory."},"2876":{"id":"/optimize/running-44","page_id":"/optimize/running","tags":[],"type":"text","url":"/optimize/running#see-also","content":"Inspecting and exporting results"},"2877":{"id":"/optimize/running-45","page_id":"/optimize/running","tags":[],"type":"text","url":"/optimize/running#see-also","content":"Configuration reference"},"2878":{"id":"/optimize/setup","page_id":"/optimize/setup","type":"page","content":"Setup: Eval Data and Grading","breadcrumbs":["Docs","Evaluate and optimize","Optimization"],"tags":[],"url":"/optimize/setup"},"2879":{"id":"/optimize/setup-0","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup","content":"Prepare the suite CSV and checks TOML that drive skill optimization."},"2880":{"id":"/optimize/setup-1","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#setup-eval-data-and-grading","content":"Setup: Eval Data and Grading"},"2881":{"id":"/optimize/setup-2","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#1-create-the-suite-csv","content":"1\\. Create the suite CSV"},"2882":{"id":"/optimize/setup-3","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#the-three-splits","content":"The three splits"},"2883":{"id":"/optimize/setup-4","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#tips-for-writing-cases","content":"Tips for writing cases"},"2884":{"id":"/optimize/setup-5","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#2-create-the-checks-toml-grading","content":"2\\. Create the checks TOML (grading)"},"2885":{"id":"/optimize/setup-6","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#how-checks-become-a-score","content":"How checks become a score"},"2886":{"id":"/optimize/setup-7","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#should_trigger-is-not-the-grading-signal","content":"`should_trigger` is not the grading signal"},"2887":{"id":"/optimize/setup-8","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#3-directory-layout","content":"3\\. Directory layout"},"2888":{"id":"/optimize/setup-9","page_id":"/optimize/setup","type":"heading","tags":[],"url":"/optimize/setup#next-configure-the-run","content":"Next: configure the run"},"2889":{"id":"/optimize/setup-10","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#setup-eval-data-and-grading","content":"Before you run `fastskill optimization`, you need two data files:"},"2890":{"id":"/optimize/setup-11","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#setup-eval-data-and-grading","content":"**Suite CSV** — the eval cases the optimizer learns from."},"2891":{"id":"/optimize/setup-12","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#setup-eval-data-and-grading","content":"**Checks TOML*&#x2A; — the grading rules that score each response. &#x2A;(Optional, but without it there is no real grading signal — see below.)*"},"2892":{"id":"/optimize/setup-13","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"The suite is a CSV file with one row per eval case. Required columns:"},"2893":{"id":"/optimize/setup-14","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Column"},"2894":{"id":"/optimize/setup-15","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Required"},"2895":{"id":"/optimize/setup-16","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Description"},"2896":{"id":"/optimize/setup-17","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`id`"},"2897":{"id":"/optimize/setup-18","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Yes"},"2898":{"id":"/optimize/setup-19","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Unique stable identifier for the case. Used in progress reporting and step artifacts."},"2899":{"id":"/optimize/setup-20","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`prompt`"},"2900":{"id":"/optimize/setup-21","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Yes"},"2901":{"id":"/optimize/setup-22","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"The user message sent to the target agent."},"2902":{"id":"/optimize/setup-23","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`should_trigger`"},"2903":{"id":"/optimize/setup-24","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Yes"},"2904":{"id":"/optimize/setup-25","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`true` if the skill should activate on this prompt, `false` if not. This column is required by the CSV loader, but **no scorer reads it** — see `should_trigger` is not the grading signal below."},"2905":{"id":"/optimize/setup-26","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`split`"},"2906":{"id":"/optimize/setup-27","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"No"},"2907":{"id":"/optimize/setup-28","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`train`, `selection`, or `test`. Defaults to `train` if absent or empty. Any value that isn't exactly `selection` or `test` is also treated as `train`."},"2908":{"id":"/optimize/setup-29","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"`tags`"},"2909":{"id":"/optimize/setup-30","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"No"},"2910":{"id":"/optimize/setup-31","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#1-create-the-suite-csv","content":"Space-separated tags. You can encode the split here instead of a `split` column, as a `split:<value>` tag."},"2911":{"id":"/optimize/setup-32","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"The optimizer uses **three** splits, not two:"},"2912":{"id":"/optimize/setup-33","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"Split"},"2913":{"id":"/optimize/setup-34","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"Used for"},"2914":{"id":"/optimize/setup-35","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"`train`"},"2915":{"id":"/optimize/setup-36","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"The cases the training loop actually steps over each epoch to produce patch proposals."},"2916":{"id":"/optimize/setup-37","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"`selection`"},"2917":{"id":"/optimize/setup-38","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"The accept/reject gate — before and after each candidate patch, the gate re-scores this set to decide whether to accept it."},"2918":{"id":"/optimize/setup-39","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"`test`"},"2919":{"id":"/optimize/setup-40","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"Held out entirely. Never used to pick or gate patches; only useful for your own out-of-loop evaluation of the final skill."},"2920":{"id":"/optimize/setup-41","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"A row's split comes from the `split` column if present, or a `split:<value>` tag if not, and defaults to `train` if neither is given. &#x2A;*Any unrecognized split value also falls back to `train`** — so a typo like `split = \"trian\"` silently becomes a training case rather than erroring."},"2921":{"id":"/optimize/setup-42","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"**Rule: a suite needs at least one `train` row AND at least one `selection` row.**"},"2922":{"id":"/optimize/setup-43","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"Zero `selection` rows → `fastskill optimization run` exits with:"},"2923":{"id":"/optimize/setup-44","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"Zero `train` rows → it exits with:"},"2924":{"id":"/optimize/setup-45","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"These are two independent checks — a suite that has plenty of `train` rows but no `selection` row is just as broken as one with no `train` rows, because the gate has nothing to score."},"2925":{"id":"/optimize/setup-46","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#the-three-splits","content":"**Example `suite.csv`** (has both `train` and `selection` rows, plus a held-out `test` row):"},"2926":{"id":"/optimize/setup-47","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#tips-for-writing-cases","content":"Keep prompts realistic — use the same phrasing a real user would."},"2927":{"id":"/optimize/setup-48","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#tips-for-writing-cases","content":"Include both positive cases (`should_trigger: true`) and negative cases (`should_trigger: false`) in your `train` and `selection` sets. A mix helps you notice via checks if the skill starts triggering on everything."},"2928":{"id":"/optimize/setup-49","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#tips-for-writing-cases","content":"Aim for 20–50 `train` cases for a focused skill, more for broader skills."},"2929":{"id":"/optimize/setup-50","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#tips-for-writing-cases","content":"Keep the `selection` set small but representative — it gets re-run on every candidate patch, so it directly drives token spend per step."},"2930":{"id":"/optimize/setup-51","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#tips-for-writing-cases","content":"Optionally hold out a `test` slice entirely — it's never used by the loop, so it's only useful if you score it yourself afterward."},"2931":{"id":"/optimize/setup-52","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Checks are the **only** grading signal the optimizer uses. Pass/fail for each case comes entirely from `checks.toml` — see `should_trigger` is not the grading signal below for why that CSV column doesn't do what it looks like it does."},"2932":{"id":"/optimize/setup-53","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"The checks file is loaded by `aikit_evals::checks::ChecksToml`: an array of `[[check]]` tables, each identified by a `name` field. There are exactly five check types:"},"2933":{"id":"/optimize/setup-54","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`name`"},"2934":{"id":"/optimize/setup-55","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Fields"},"2935":{"id":"/optimize/setup-56","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Description"},"2936":{"id":"/optimize/setup-57","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`skill_invoked`"},"2937":{"id":"/optimize/setup-58","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`skill` (string, optional), `expected` (bool, default `true`), `required` (bool, default `true`)"},"2938":{"id":"/optimize/setup-59","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Passes if a structured `Skill` tool invocation appears in the trace, matching `expected`. With `skill` set, it must exactly equal the invocation's skill-identifying input field (`skill`, `name`, or `skillName`). &#x2A;*Prefer this for asserting your skill fired.**"},"2939":{"id":"/optimize/setup-60","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`trigger_expectation`"},"2940":{"id":"/optimize/setup-61","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`pattern` (string), `expected` (bool), `required` (bool, default `true`)"},"2941":{"id":"/optimize/setup-62","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Passes if `pattern` appearing in the trace matches `expected` (found == expected)."},"2942":{"id":"/optimize/setup-63","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`command_contains`"},"2943":{"id":"/optimize/setup-64","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`pattern` (string), `required` (bool, default `true`)"},"2944":{"id":"/optimize/setup-65","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Passes if `pattern` appears anywhere in the trace."},"2945":{"id":"/optimize/setup-66","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`file_exists`"},"2946":{"id":"/optimize/setup-67","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`path` (string), `required` (bool, default `true`)"},"2947":{"id":"/optimize/setup-68","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Passes if `path` exists under the run's working directory after execution."},"2948":{"id":"/optimize/setup-69","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`max_tool_calls`"},"2949":{"id":"/optimize/setup-70","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"`limit` (int), `required` (bool, default `true`)"},"2950":{"id":"/optimize/setup-71","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"Passes if the number of tool invocations the agent made does not exceed `limit`. A tool invocation is a structured `tool_use` trace event or a `raw_json` trace line; assistant text and token-usage events are not counted."},"2951":{"id":"/optimize/setup-72","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"All pattern matching runs against the canonical `trace.jsonl`, never raw stdout — raw stdout carries the agent's capability listing, which would make any skill-name pattern pass vacuously."},"2952":{"id":"/optimize/setup-73","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"There is **no** `type`, `id`, or `weight` field, and there is no LLM-judge/rubric check type — scoring is purely deterministic pattern/file/count matching against the captured transcript."},"2953":{"id":"/optimize/setup-74","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#2-create-the-checks-toml-grading","content":"**Example `checks.toml`:**"},"2954":{"id":"/optimize/setup-75","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#how-checks-become-a-score","content":"Every check in the file runs against every case's captured output. The gate then reduces each case's list of pass/fail results to a single number using `gate_metric` (configured in `optimize.toml` — see the configuration reference):"},"2955":{"id":"/optimize/setup-76","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#how-checks-become-a-score","content":"`hard` — 1.0 if every required check passed for that case, else 0.0."},"2956":{"id":"/optimize/setup-77","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#how-checks-become-a-score","content":"`soft` — the fraction of required checks that passed for that case."},"2957":{"id":"/optimize/setup-78","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#how-checks-become-a-score","content":"`mixed` — a weighted blend of the hard and soft scores."},"2958":{"id":"/optimize/setup-79","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#how-checks-become-a-score","content":"Checks marked `required = false` are reported in the artifacts but excluded from the score, so they cannot drag the gate around. There is no per-check weighting — every required check counts equally within a case."},"2959":{"id":"/optimize/setup-80","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#should_trigger-is-not-the-grading-signal","content":"`should_trigger` is a **required CSV column**, but it is not read by any scorer. Pass/fail is determined entirely by `checks.toml`. If you want the optimizer to actually check that a case did or didn't trigger the skill, encode that as a `skill_invoked` check with `expected` set to match — the CSV column alone does nothing."},"2960":{"id":"/optimize/setup-81","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#should_trigger-is-not-the-grading-signal","content":"**If you omit `checks` from `optimize.toml` entirely, there is no grading signal at all**: with zero checks configured, every case's result list is empty, and an empty list scores `1.0` under every `gate_metric` (vacuously — \"zero required checks passed\" is trivially true). In that configuration every candidate patch looks perfect, so the gate has nothing meaningful to accept or reject on. Always configure `checks` for a real run."},"2961":{"id":"/optimize/setup-82","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#should_trigger-is-not-the-grading-signal","content":"The same trap applies if every check you configure is `required = false`: scoring filters to required checks, so an all-advisory file leaves nothing to score and every case reads `1.0`. Keep at least one required check."},"2962":{"id":"/optimize/setup-83","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#3-directory-layout","content":"We recommend this layout to keep things organized:"},"2963":{"id":"/optimize/setup-84","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#next-configure-the-run","content":"Once you have your suite and checks files ready, write the `optimize.toml` config and start the run."},"2964":{"id":"/optimize/setup-85","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#next-configure-the-run","content":"Configuration reference"},"2965":{"id":"/optimize/setup-86","page_id":"/optimize/setup","tags":[],"type":"text","url":"/optimize/setup#next-configure-the-run","content":"Running and monitoring"},"2966":{"id":"/progressive-loading/performance","page_id":"/progressive-loading/performance","type":"page","content":"Context Resolution API","breadcrumbs":["Docs","Reference","Reading skill content"],"tags":[],"url":"/progressive-loading/performance"},"2967":{"id":"/progressive-loading/performance-0","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance","content":"How agents get the most relevant skills for a prompt via `POST /api/v1/resolve`, and the embedding index that powers ranking."},"2968":{"id":"/progressive-loading/performance-1","page_id":"/progressive-loading/performance","type":"heading","tags":[],"url":"/progressive-loading/performance#overview","content":"Overview"},"2969":{"id":"/progressive-loading/performance-2","page_id":"/progressive-loading/performance","type":"heading","tags":[],"url":"/progressive-loading/performance#post-apiv1resolve","content":"`POST /api/v1/resolve`"},"2970":{"id":"/progressive-loading/performance-3","page_id":"/progressive-loading/performance","type":"heading","tags":[],"url":"/progressive-loading/performance#how-ranking-works","content":"How ranking works"},"2971":{"id":"/progressive-loading/performance-4","page_id":"/progressive-loading/performance","type":"heading","tags":[],"url":"/progressive-loading/performance#performance-characteristics","content":"Performance characteristics"},"2972":{"id":"/progressive-loading/performance-5","page_id":"/progressive-loading/performance","type":"heading","tags":[],"url":"/progressive-loading/performance#see-also","content":"See also"},"2973":{"id":"/progressive-loading/performance-6","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#overview","content":"Progressive loading in FastSkill means **context resolution**: an agent sends a prompt and gets back\nthe most relevant installed skills, so it can load only what it needs instead of every skill. This is\nserved **over HTTP only** by `fastskill server serve` — there is no CLI subcommand for it."},"2974":{"id":"/progressive-loading/performance-7","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"Start the server and call the resolve endpoint:"},"2975":{"id":"/progressive-loading/performance-8","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"Request body:"},"2976":{"id":"/progressive-loading/performance-9","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"Field"},"2977":{"id":"/progressive-loading/performance-10","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"Type"},"2978":{"id":"/progressive-loading/performance-11","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"Notes"},"2979":{"id":"/progressive-loading/performance-12","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"`prompt`"},"2980":{"id":"/progressive-loading/performance-13","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"string"},"2981":{"id":"/progressive-loading/performance-14","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"The task text to resolve against. Must not be empty (`RESOLVE_EMPTY_PROMPT`)."},"2982":{"id":"/progressive-loading/performance-15","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"`limit`"},"2983":{"id":"/progressive-loading/performance-16","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"integer"},"2984":{"id":"/progressive-loading/performance-17","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"Maximum number of skills to return. Must be greater than 0 (`RESOLVE_LIMIT_ZERO`)."},"2985":{"id":"/progressive-loading/performance-18","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#post-apiv1resolve","content":"The response ranks installed skills by relevance to the prompt so the agent can pull just the top\nmatches into context. `resolve` is a **read** endpoint — it works whether or not `server serve` was started\nwith `--enable-write`."},"2986":{"id":"/progressive-loading/performance-19","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#how-ranking-works","content":"**Embeddings power ranking when available.** With `OPENAI_API_KEY` set (and\n`[tool.fastskill.embedding]` configured), FastSkill ranks skills semantically using the embedding\nindex."},"2987":{"id":"/progressive-loading/performance-20","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#how-ranking-works","content":"**Keyword fallback otherwise.** If no embedding provider is configured, semantic ranking silently\nskips and resolution falls back to keyword matching — the endpoint still returns results, it just\nranks them without embeddings."},"2988":{"id":"/progressive-loading/performance-21","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#how-ranking-works","content":"You can confirm whether an embedding provider is active from `GET /api/v1/status`\n(`embeddingProvider` flag) or with `fastskill cli doctor`."},"2989":{"id":"/progressive-loading/performance-22","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#performance-characteristics","content":"**Local vector index.** Skill embeddings are stored in a local SQLite vector index (path set by\n`index_path` under `[tool.fastskill.embedding]`), so resolution queries run against on-disk vectors\nwith no external service call at query time."},"2990":{"id":"/progressive-loading/performance-23","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#performance-characteristics","content":"**Incremental index rebuilding.** A change-detection cache (`.fastskill/build-cache.json`) lets\nFastSkill\nre-embed only what actually changed, so keeping the index current is cheap."},"2991":{"id":"/progressive-loading/performance-24","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#performance-characteristics","content":"**Automatic rebuilding keeps the index fresh.** After `skill add`, `project install`,\n`skill update`, or `skill remove`, FastSkill\nreindexes automatically (unless `auto_reindex = false` or `--no-reindex`, and only when an\nembedding provider is available), so `resolve` reflects the current skill set."},"2992":{"id":"/progressive-loading/performance-25","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#performance-characteristics","content":"There are no cache-size, eviction, or tuning knobs to configure. Resolution is driven by the prompt,\nthe `limit`, and the embedding index — not by a configurable runtime cache."},"2993":{"id":"/progressive-loading/performance-26","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#see-also","content":"Loading strategies — when to rebuild and search locally."},"2994":{"id":"/progressive-loading/performance-27","page_id":"/progressive-loading/performance","tags":[],"type":"text","url":"/progressive-loading/performance#see-also","content":"`server serve` — full endpoint reference."},"2995":{"id":"/progressive-loading/strategies","page_id":"/progressive-loading/strategies","type":"page","content":"Loading Strategies","breadcrumbs":["Docs","Reference","Reading skill content"],"tags":[],"url":"/progressive-loading/strategies"},"2996":{"id":"/progressive-loading/strategies-0","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies","content":"Configure embeddings, decide when to rebuild the index, and search installed skills."},"2997":{"id":"/progressive-loading/strategies-1","page_id":"/progressive-loading/strategies","type":"heading","tags":[],"url":"/progressive-loading/strategies#overview","content":"Overview"},"2998":{"id":"/progressive-loading/strategies-2","page_id":"/progressive-loading/strategies","type":"heading","tags":[],"url":"/progressive-loading/strategies#enable-semantic-ranking","content":"Enable semantic ranking"},"2999":{"id":"/progressive-loading/strategies-3","page_id":"/progressive-loading/strategies","type":"heading","tags":[],"url":"/progressive-loading/strategies#when-to-rebuild-the-index","content":"When to rebuild the index"},"3000":{"id":"/progressive-loading/strategies-4","page_id":"/progressive-loading/strategies","type":"heading","tags":[],"url":"/progressive-loading/strategies#search-locally-without-the-server","content":"Search locally without the server"},"3001":{"id":"/progressive-loading/strategies-5","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#overview","content":"Context resolution (the resolve API) lets an agent load only the\nskills relevant to a prompt. This page covers the practical setup and habits that keep resolution\nfast and accurate. These are real knobs and commands — FastSkill has no configurable cache or\neviction policy to tune."},"3002":{"id":"/progressive-loading/strategies-6","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#enable-semantic-ranking","content":"Semantic ranking is what makes resolution useful. To turn it on:"},"3003":{"id":"/progressive-loading/strategies-7","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#enable-semantic-ranking","content":"Configure an embedding provider in `skill-project.toml`:"},"3004":{"id":"/progressive-loading/strategies-8","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#enable-semantic-ranking","content":"Set `OPENAI_API_KEY` in the environment (via a secret, never in config)."},"3005":{"id":"/progressive-loading/strategies-9","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#enable-semantic-ranking","content":"If no provider is configured, `resolve` and `skill search` still work but fall back to keyword matching.\nVerify the setup with `fastskill cli doctor`."},"3006":{"id":"/progressive-loading/strategies-10","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#when-to-rebuild-the-index","content":"FastSkill **auto-reindexes** after `skill add`, `project install`, `skill update`, and `skill remove` (unless\n`auto_reindex = false` in `[tool.fastskill]` or you pass `--no-reindex`), so day to day you rarely\nreindex by hand. Reindex explicitly when:"},"3007":{"id":"/progressive-loading/strategies-11","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#when-to-rebuild-the-index","content":"you edited a skill's `SKILL.md` in place (for example an editable `skill add -e` skill) without going\nthrough install/update,"},"3008":{"id":"/progressive-loading/strategies-12","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#when-to-rebuild-the-index","content":"you set `auto_reindex = false` and manage indexing yourself,"},"3009":{"id":"/progressive-loading/strategies-13","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#when-to-rebuild-the-index","content":"you first configure embeddings for a skills directory that already has content."},"3010":{"id":"/progressive-loading/strategies-14","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#when-to-rebuild-the-index","content":"Reindex needs an embedding provider; without `OPENAI_API_KEY` it skips silently. A change-detection\ncache (`.fastskill/build-cache.json`) lets reindex re-embed only what changed."},"3011":{"id":"/progressive-loading/strategies-15","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#search-locally-without-the-server","content":"For a quick, offline relevance check over skills already on disk, use `skill search --local` instead of the\nHTTP resolve endpoint:"},"3012":{"id":"/progressive-loading/strategies-16","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#search-locally-without-the-server","content":"`resolve` (server) is for agents pulling context at runtime; `skill search --local` (CLI) is for\ninteractive and scripted lookups over the local index. Both use the same embedding index when one is\nconfigured."},"3013":{"id":"/progressive-loading/strategies-17","page_id":"/progressive-loading/strategies","tags":[],"type":"text","url":"/progressive-loading/strategies#search-locally-without-the-server","content":"Keep the embedding index fresh (auto-reindex or an explicit `fastskill index rebuild`) — that single habit\ncovers essentially all resolution performance and quality concerns."},"3014":{"id":"/registry/index-system","page_id":"/registry/index-system","type":"page","content":"Registry Index System","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/index-system"},"3015":{"id":"/registry/index-system-0","page_id":"/registry/index-system","tags":[],"type":"text","url":"/registry/index-system","content":"Understanding the on-disk registry index format read by fastskill server serve and registry search"},"3016":{"id":"/registry/index-system-1","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#registry-index-system","content":"Registry Index System"},"3017":{"id":"/registry/index-system-2","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#overview","content":"Overview"},"3018":{"id":"/registry/index-system-3","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#registry-structure","content":"Registry Structure"},"3019":{"id":"/registry/index-system-4","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#directory-naming","content":"Directory Naming"},"3020":{"id":"/registry/index-system-5","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#version-metadata-format","content":"Version Metadata Format"},"3021":{"id":"/registry/index-system-6","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#field-descriptions","content":"Field Descriptions"},"3022":{"id":"/registry/index-system-7","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#accessing-the-registry","content":"Accessing the Registry"},"3023":{"id":"/registry/index-system-8","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#hosted-registry-server-external","content":"Hosted registry server (external)"},"3024":{"id":"/registry/index-system-9","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#from-fastskill-server-serve","content":"From `fastskill server serve`"},"3025":{"id":"/registry/index-system-10","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#from-fastskill-cli","content":"From FastSkill CLI"},"3026":{"id":"/registry/index-system-11","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#version-management","content":"Version Management"},"3027":{"id":"/registry/index-system-12","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#version-history","content":"Version History"},"3028":{"id":"/registry/index-system-13","page_id":"/registry/index-system","type":"heading","tags":[],"url":"/registry/index-system#skill-organization","content":"Skill Organization"},"3029":{"id":"/registry/index-system-14","p