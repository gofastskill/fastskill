ation/init-command","type":"heading","tags":[],"url":"/configuration/init-command#integration-with-cicd","content":"Integration with CI/CD"},"1863":{"id":"/configuration/init-command-18","page_id":"/configuration/init-command","type":"heading","tags":[],"url":"/configuration/init-command#next-steps-after-init","content":"Next steps after init"},"1864":{"id":"/configuration/init-command-19","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"`fastskill project init` creates a single file: `skill-project.toml` in the current directory. If a `SKILL.md` is present, it extracts metadata (version, description, author) from its frontmatter; anything missing is either taken from CLI flags or prompted for interactively."},"1865":{"id":"/configuration/init-command-20","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"`project init` writes **only** `skill-project.toml`. It does not create a skills directory, example skills, or any other file. All FastSkill configuration lives in `skill-project.toml`."},"1866":{"id":"/configuration/init-command-21","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"**Context detection**: `project init` detects whether you're in a skill directory or a project root:"},"1867":{"id":"/configuration/init-command-22","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"**Skill-level**: run in a directory containing `SKILL.md` — writes a `[metadata]` section for skill authors. `skills_directory` is optional."},"1868":{"id":"/configuration/init-command-23","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"**Project-level**: run at a project root — writes `[dependencies]` for skill consumers. A skills directory is required (via `--skills-dir`, or the prompt)."},"1869":{"id":"/configuration/init-command-24","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Checks for an existing file**: refuses to overwrite `skill-project.toml` unless `--force` is given."},"1870":{"id":"/configuration/init-command-25","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Reads `SKILL.md`** (if present): pulls `version`, `description`, and `author` from the frontmatter."},"1871":{"id":"/configuration/init-command-26","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Resolves missing fields**: from CLI flags, or by prompting (unless `--yes`)."},"1872":{"id":"/configuration/init-command-27","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Writes `skill-project.toml`**: with `[metadata]`, `[dependencies]`, and — when a skills directory is set — `[tool.fastskill]`."},"1873":{"id":"/configuration/init-command-28","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Validates**: the skill ID (derived from the directory name) and the version (must be valid semver)."},"1874":{"id":"/configuration/init-command-29","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#interactive-setup","content":"Prompts for each missing field. For example, at a project root:"},"1875":{"id":"/configuration/init-command-30","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#non-interactive-setup","content":"At a project root, `--yes` requires `--skills-dir <path>`. Without it, either drop `--yes` to be prompted or pass the flag."},"1876":{"id":"/configuration/init-command-31","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Option"},"1877":{"id":"/configuration/init-command-32","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Description"},"1878":{"id":"/configuration/init-command-33","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Default"},"1879":{"id":"/configuration/init-command-34","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--yes`"},"1880":{"id":"/configuration/init-command-35","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Skip interactive prompts and use defaults"},"1881":{"id":"/configuration/init-command-36","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`false`"},"1882":{"id":"/configuration/init-command-37","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--force`"},"1883":{"id":"/configuration/init-command-38","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Overwrite an existing `skill-project.toml`"},"1884":{"id":"/configuration/init-command-39","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`false`"},"1885":{"id":"/configuration/init-command-40","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--set-version <VER>`"},"1886":{"id":"/configuration/init-command-41","page_id":"/configuration/init-command","tags":[],"type":"text","url"