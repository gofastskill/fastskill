/troubleshooting#best-practices","content":"**Commit project lock to git**:"},"374":{"id":"/troubleshooting-54","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#best-practices","content":"**Don't commit global lock**:"},"375":{"id":"/troubleshooting-55","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#best-practices","content":"**Use `--lock` in CI** for reproducible builds:"},"376":{"id":"/troubleshooting-56","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#best-practices","content":"**Don't manually edit lock files** unless you understand the TOML schema"},"377":{"id":"/troubleshooting-57","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#best-practices","content":"**Regenerate rather than fix** if the lock becomes corrupted"},"378":{"id":"/troubleshooting-58","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#best-practices","content":"**Keep FastSkill up to date** to get lock file improvements and bug fixes"},"379":{"id":"/troubleshooting-59","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"If you encounter lock file issues not covered here:"},"380":{"id":"/troubleshooting-60","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Check lock file format: `head -20 skills.lock`"},"381":{"id":"/troubleshooting-61","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Validate TOML syntax with a validator"},"382":{"id":"/troubleshooting-62","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Try regenerating with `rm skills.lock && fastskill project install`"},"383":{"id":"/troubleshooting-63","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Report the issue at: https\\://github.com/gofastskill/fastskill/issues"},"384":{"id":"/troubleshooting-64","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Include:"},"385":{"id":"/troubleshooting-65","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"FastSkill version (`fastskill --version`)"},"386":{"id":"/troubleshooting-66","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Lock file version (`grep '^version = ' skills.lock`)"},"387":{"id":"/troubleshooting-67","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Full error message"},"388":{"id":"/troubleshooting-68","page_id":"/troubleshooting","tags":[],"type":"text","url":"/troubleshooting#getting-help","content":"Lock file content (redact sensitive URLs if needed)"},"389":{"id":"/welcome","page_id":"/welcome","type":"page","content":"Understand FastSkill","breadcrumbs":["Docs","Start here"],"tags":[],"url":"/welcome"},"390":{"id":"/welcome-0","page_id":"/welcome","tags":[],"type":"text","url":"/welcome","content":"Skills, projects, locks, and bundles in one workflow."},"391":{"id":"/welcome-1","page_id":"/welcome","type":"heading","tags":[],"url":"/welcome#the-pieces","content":"The pieces"},"392":{"id":"/welcome-2","page_id":"/welcome","type":"heading","tags":[],"url":"/welcome#choose-the-operation","content":"Choose the operation"},"393":{"id":"/welcome-3","page_id":"/welcome","tags":[],"type":"text","url":"/welcome","content":"FastSkill installs and manages directories containing `SKILL.md` and supporting\nresources. Agents read these instructions when relevant to a task. FastSkill does\nnot run skills as a sandbox or guarantee that an agent follows their instructions."},"394":{"id":"/welcome-4","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Piece"},"395":{"id":"/welcome-5","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Purpose"},"396":{"id":"/welcome-6","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Skill"},"397":{"id":"/welcome-7","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Instructions and resources for a task"},"398":{"id":"/welcome-8","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"`skill-project.toml`"},"399":{"id":"/welcome-9","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Desired dependencies, sources, groups, and installation directory"},"400":{"id":"/welcome-10","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"`skills.lock`"},"401":{"id":"/welcome-11","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Selected versions, revisions, integrity evidence, and ownership"},"402":{"id":"/welcome-12","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Installed directory"},"403":{"id":"/welcome-13","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Files the agent can discover and read"},"404":{"id":"/welcome-14","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Bundle"},"405":{"id":"/welcome-15","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"A versioned ZIP containing a team skill set and its dependency closure"},"406":{"id":"/welcome-16","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill add` declares and installs a skill from a source."},"407":{"id":"/welcome-17","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install` restores compatible locked selections and resolves missing coverage."},"408":{"id":"/welcome-18","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install --lock` restores the locked selection without updating the lock."},"409":{"id":"/welcome-19","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill update` deliberately resolves changes allowed by the recorded constraints."},"410":{"id":"/welcome-20","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill remove` removes a direct owner; shared requirements can keep a skill installed."},"411":{"id":"/welcome-21","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill list --check` verifies the desired, locked, and installed state."},"412":{"id":"/welcome-22","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"Start with your first skill. Continue with\nmanifests and scope,\nteam bundles, or agent access."},"413":{"id":"/cli-reference/bundle-command","page_id":"/cli-reference/bundle-command","type":"page","content":"Bundle commands","breadcrumbs":["Docs","Share with teams"],"tags":[],"url":"/cli-reference/bundle-command"},"414":{"id":"/cli-reference/bundle-command-0","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command","content":"Build, install, update, and restore self-contained project exports."},"415":{"id":"/cli-reference/bundle-command-1","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#bundle-commands","content":"`bundle` commands"},"416":{"id":"/cli-reference/bundle-command-2","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#build-a-bundle","content":"Build a bundle"},"417":{"id":"/cli-reference/bundle-command-3","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#install-and-inspect","content":"Install and inspect"},"418":{"id":"/cli-reference/bundle-command-4","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#update-a-bundle","content":"Update a bundle"},"419":{"id":"/cli-reference/bundle-command-5","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove a bundle"},"420":{"id":"/cli-reference/bundle-command-6","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"Reuse a setup without packaging it"},"421":{"id":"/cli-reference/bundle-command-7","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Legacy member overrides"},"422":{"id":"/cli-reference/bundle-command-8","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#bundle-commands","content":"Bundles turn a skill project into one versioned ZIP. The artifact contains every declared skill,\nits installed dependency closure, resource files, and content digests. A recipient can\ninstall it without access to the original repositories. On Unix systems, executable files remain\nexecutable after bundle installation; other permission bits are normalized for portability."},"423":{"id":"/cli-reference/bundle-command-9","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Complete the quickstart, then give the project an identity and version in its existing\n`skill-project.toml`:"},"424":{"id":"/cli-reference/bundle-command-10","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Every dependency becomes a bundle member. Its installed version must satisfy the declaration.\nFastSkill stops before writing an artifact when a declared dependency is\nmissing, has invalid frontmatter, or has a different version."},"425":{"id":"/cli-reference/bundle-command-11","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Build the release:"},"426":{"id":"/cli-reference/bundle-command-12","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"The result is `dist/notes-team-1.0.0.zip`. Its embedded identity, version, membership, and\ndigests are authoritative, so renaming the download does not change the release."},"427":{"id":"/cli-reference/bundle-command-13","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"There is no `[bundle.members]` list to maintain. A source Manifest using the earlier `[bundle]`\nformat remains buildable for migration, while all new bundles should use `[metadata]`."},"428":{"id":"/cli-reference/bundle-command-14","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"In a second project initialized with `project init --yes --skills-dir .claude/skills`,\ninstall the artifact with `bundle add`. Replace the local path with the artifact you\nbuilt. The HTTPS URL below is an example for an artifact hosted by your team:"},"429":{"id":"/cli-reference/bundle-command-15","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Installation copies the artifact into `.fastskill/bundles/`, adds its declaration to\n`skill-project.toml`, and records the exact release and members in `skills.lock`."},"430":{"id":"/cli-reference/bundle-command-16","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Commit these files when teammates and CI need the same setup:"},"431":{"id":"/cli-reference/bundle-command-17","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Then restore the exact locked release:"},"432":{"id":"/cli-reference/bundle-command-18","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"`--lock` uses the bundle artifact, version, digest, and membership recorded in `skills.lock`.\nIt does not switch to a different release if the manifest has drifted. `--offline` additionally\nguarantees that restore does not contact a repository or embedding provider."},"433":{"id":"/cli-reference/bundle-command-19","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"Bundle updates are explicit. After building version `1.1.0` of your bundle, preview\nand apply that replacement:"},"434":{"id":"/cli-reference/bundle-command-20","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"FastSkill checks the new artifact, shared ownership, local modifications, and release immutability\nbefore it changes installed members. The preview runs the same validation as apply and reports\nmembership changes even when retained member bytes are unchanged."},"435":{"id":"/cli-reference/bundle-command-21","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove the bundle identity and the members that have no other owner:"},"436":{"id":"/cli-reference/bundle-command-22","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Removing a direct declaration detaches that owner. FastSkill retains the installed member while a\nbundle or another dependency root still requires it. An ID that is only a transitive requirement\ncannot be removed directly; the error names the roots that require it. A member is deleted only\nafter its final direct, transitive, or bundle owner is gone."},"437":{"id":"/cli-reference/bundle-command-23","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"A references-only bundle would duplicate a Manifest, so FastSkill uses Manifest composition for\nthat case. A consuming project references the shared file once:"},"438":{"id":"/cli-reference/bundle-command-24","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"The shared Manifest can declare skills from multiple Git repositories, configured repositories,\nZIP URLs, or shared paths. `project install` resolves the combined roots and the consuming project\nwrites the exact results to its own `skills.lock`. References may be nested. FastSkill rejects\nmissing files, reference cycles, and incompatible declarations of the same skill ID."},"439":{"id":"/cli-reference/bundle-command-25","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"Use a bundle when recipients need an offline-ready artifact. Use a composed Manifest when they\nhave access to the declared sources and should obtain the skills from those sources."},"440":{"id":"/cli-reference/bundle-command-26","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Bundles created with the earlier `[bundle.members]` format may permit a personal replacement.\nThose existing artifacts remain supported through `fastskill bundle override <skill-id> --from <directory>` and `fastskill bundle override <skill-id> --reset`. Manifest-driven builds make all\nmembers required and do not create new override policies."},"441":{"id":"/cli-reference/bundle-command-27","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Every bundle action except `bundle list` changes files. The MCP server hides and refuses these\ntools unless it starts with `fastskill mcp serve --enable-write`."},"442":{"id":"/cli-reference/cache-command","page_id":"/cli-reference/cache-command","type":"page","content":"cache Command","breadcrumbs":["Docs","Reference","CLI commands","Operations"],"tags":[],"url":"/cli-reference/cache-command"},"443":{"id":"/cli-reference/cache-command-0","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command","content":"Inspect and reclaim the on-disk skill content cache with fastskill cache."},"444":{"id":"/cli-reference/cache-command-1","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#cache-command","content":"cache Command"},"445":{"id":"/cli-reference/cache-command-2","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#usage","content":"Usage"},"446":{"id":"/cli-reference/cache-command-3","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#subcommands","content":"Subcommands"},"447":{"id":"/cli-reference/cache-command-4","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#info","content":"info"},"448":{"id":"/cli-reference/cache-command-5","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#clean","content":"clean"},"449":{"id":"/cli-reference/cache-command-6","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#when-to-run-it","content":"When to run it"},"450":{"id":"/cli-reference/cache-command-7","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#see-also","content":"See Also"},"451":{"id":"/cli-reference/cache-command-8","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Inspect and reclaim the on-disk cache that `skill add`, `project install`, and `skill update` use so a skill's\ncontent is fetched once per machine instead of once per project."},"452":{"id":"/cli-reference/cache-command-9","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Every git, registry, or local skill fetch is checked against this cache before touching the\nnetwork again. `fastskill cache` is how to see what has accumulated there and reclaim disk\nspace -- fastskill never evicts cache entries on its own."},"453":{"id":"/cli-reference/cache-command-10","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"Show the cache location plus entry counts and disk usage, broken down by source kind (git,\nregistry, or local)."},"454":{"id":"/cli-reference/cache-command-11","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Example output**:"},"455":{"id":"/cli-reference/cache-command-12","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Options**:"},"456":{"id":"/cli-reference/cache-command-13","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--format <table|json>`: Output format (default: table)"},"457":{"id":"/cli-reference/cache-command-14","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--json`: Shorthand for `--format json` (mutually exclusive with `--format`)"},"458":{"id":"/cli-reference/cache-command-15","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"Remove cached skill content and print how many bytes were reclaimed."},"459":{"id":"/cli-reference/cache-command-16","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Options**:"},"460":{"id":"/cli-reference/cache-command-17","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--source <git|registry|local>`: Limit cleaning to one source kind (default: all)"},"461":{"id":"/cli-reference/cache-command-18","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--json`: Print the result as JSON instead of a summary line"},"462":{"id":"/cli-reference/cache-command-19","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**What it removes**: Only cached skill content -- the record of what a repository currently\nadvertises (what `repo refresh` writes) is left alone, so `repo refresh` output stays valid\nafter a clean. There is nothing to undo: the next `skill add`/`project install`/`skill update` that needs a removed\nentry re-fetches it from its original source."},"463":{"id":"/cli-reference/cache-command-20","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Safe with other fastskill processes running**: `clean` never removes an entry another process\nis mid-write on, and every write elsewhere is atomic. In the worst case, a fetch running at the\nexact moment of a clean simply re-fetches -- it never sees partial or corrupted content."},"464":{"id":"/cli-reference/cache-command-21","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache info`**: Before a `clean`, to see what is actually taking up space, or when disk\nusage seems higher than expected."},"465":{"id":"/cli-reference/cache-command-22","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache clean`**: To reclaim disk space after finishing with skills from a source no longer\nin use, or as routine cleanup on a machine used for many short-lived projects."},"466":{"id":"/cli-reference/cache-command-23","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"`repo` commands -- refresh what a repository advertises\n(`repo refresh`), independent of the content cache `cache` manages"},"467":{"id":"/cli-reference/cache-command-24","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"Install Command -- installs that hit this cache"},"468":{"id":"/cli-reference/discovery-commands","page_id":"/cli-reference/discovery-commands","type":"page","content":"Discover and inspect skills","breadcrumbs":["Docs","Reference","CLI commands","Sources and distribution"],"tags":[],"url":"/cli-reference/discovery-commands"},"469":{"id":"/cli-reference/discovery-commands-0","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Find a catalog result, inspect its origin, and install it explicitly."},"470":{"id":"/cli-reference/discovery-commands-1","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-installed-skills","content":"Search installed skills"},"471":{"id":"/cli-reference/discovery-commands-2","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-a-catalo