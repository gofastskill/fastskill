evals-quality/setup-138","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"string"},"2362":{"id":"/evals-quality/setup-139","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"yes"},"2363":{"id":"/evals-quality/setup-140","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"—"},"2364":{"id":"/evals-quality/setup-141","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"`required`"},"2365":{"id":"/evals-quality/setup-142","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"bool"},"2366":{"id":"/evals-quality/setup-143","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"no"},"2367":{"id":"/evals-quality/setup-144","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"`true`"},"2368":{"id":"/evals-quality/setup-145","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#command_contains","content":"Same trace substring search as `trigger_expectation`, without the pass/fail inversion — passes if the pattern is found anywhere in the trace."},"2369":{"id":"/evals-quality/setup-146","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Field"},"2370":{"id":"/evals-quality/setup-147","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Type"},"2371":{"id":"/evals-quality/setup-148","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Required"},"2372":{"id":"/evals-quality/setup-149","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Default"},"2373":{"id":"/evals-quality/setup-150","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"`path`"},"2374":{"id":"/evals-quality/setup-151","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"path"},"2375":{"id":"/evals-quality/setup-152","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"yes"},"2376":{"id":"/evals-quality/setup-153","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"—"},"2377":{"id":"/evals-quality/setup-154","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"`required`"},"2378":{"id":"/evals-quality/setup-155","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"bool"},"2379":{"id":"/evals-quality/setup-156","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"no"},"2380":{"id":"/evals-quality/setup-157","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"`true`"},"2381":{"id":"/evals-quality/setup-158","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#file_exists","content":"Passes if `path` exists under the case's working directory — the case's scratch workspace under the default isolation (plus `workspace_subdir` when set), or the project root under `--no-isolation`."},"2382":{"id":"/evals-quality/setup-159","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Field"},"2383":{"id":"/evals-quality/setup-160","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Type"},"2384":{"id":"/evals-quality/setup-161","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Required"},"2385":{"id":"/evals-quality/setup-162","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Default"},"2386":{"id":"/evals-quality/setup-163","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"`limit`"},"2387":{"id":"/evals-quality/setup-164","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"integer"},"2388":{"id":"/evals-quality/setup-165","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"yes"},"2389":{"id":"/evals-quality/setup-166","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"—"},"2390":{"id":"/evals-quality/setup-167","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"`required`"},"2391":{"id":"/evals-quality/setup-168","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"bool"},"2392":{"id":"/evals-quality/setup-169","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"no"},"2393":{"id":"/evals-quality/setup-170","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"`true`"},"2394":{"id":"/evals-quality/setup-171","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Passes if the number of **tool invocations** the agent made is `<= limit`."},"2395":{"id":"/evals-quality/setup-172","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"A tool invocation is a structured `tool_use` trace event, plus any `raw_json` trace line — the\nlatter covers backends that still emit tool calls as raw JSON instead of decoded tool events.\nAssistant text output, token-usage events, and unmodelled SDK event variants are **not** counted."},"2396":{"id":"/evals-quality/setup-173","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#max_tool_calls-alias-max_command_count","content":"Results use `\"check_name\": \"max_tool_calls\"`. The per-case artifact field counting\nthese events is `command_count`."},"2397":{"id":"/evals-quality/setup-174","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#making-a-check-advisory-with-required","content":"Every check type accepts `required` (default `true`). Setting `required = false` makes the check **advisory**: it still runs, and its result still appears in the run artifacts with its own `passed` value, but a failure does not fail the case."},"2398":{"id":"/evals-quality/setup-175","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#making-a-check-advisory-with-required","content":"Use it for signal you want visible in reports without gating the suite on it."},"2399":{"id":"/evals-quality/setup-176","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"No `checks` file configured (or it loads zero explicit checks): the case still receives the required trigger expectation generated from `should_trigger`."},"2400":{"id":"/evals-quality/setup-177","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"Any checks loaded: the case **passes** only if every **required** check's `passed` is `true`. Checks marked `required = false` are reported but never fail the case. Among required checks there is no partial credit and no threshold — they are all-or-nothing per case."},"2401":{"id":"/evals-quality/setup-178","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"A case whose checks are **all** advisory (`required = false`) has nothing that can fail it, so it passes as long as it does not time out. That is intentional, but it means an all-optional `checks.toml` is not a safety net."},"2402":{"id":"/evals-quality/setup-179","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"A trial that times out is always `error`, independent of checks."},"2403":{"id":"/evals-quality/setup-180","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#how-a-cases-passfail-is-decided","content":"Across trials, `pass_threshold` decides the case's aggregated status: pass rate across trials must be `>= pass_threshold`."},"2404":{"id":"/evals-quality/setup-181","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"Once the manifest, CSV, and checks file exist:"},"2405":{"id":"/evals-quality/setup-182","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"`--output-dir` is **required** on `fastskill eval run` — there is no default. Omitting it fails argument parsing before anything else runs:"},"2406":{"id":"/evals-quality/setup-183","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive on both `eval run` and `eval validate` — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` additionally requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`); on `eval validate` both are optional — omit them to validate config without checking any agent's availability."},"2407":{"id":"/evals-quality/setup-184","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#4-validate-then-run-then-report","content":"See Run evals for the full day-to-day command set, artifact layout, and CI gating pattern."},"2408":{"id":"/evals-quality/setup-185","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"`[tool.fastskill.eval]` present with a `prompts` path that resolves."},"2409":{"id":"/evals-quality/setup-186","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Prompts CSV has `id`, `prompt`, `should_trigger` headers (plus `tags` / `workspace_subdir` if you use them)."},"2410":{"id":"/evals-quality/setup-187","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Each `should_trigger` value reflects the required consultation/non-consultation expectation; explicit `skill_invoked` checks do not contradict it."},"2411":{"id":"/evals-quality/setup-188","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Outcome correctness is measured separately where consultation alone is insufficient."},"2412":{"id":"/evals-quality/setup-189","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"`fastskill eval validate --all` passes and lists the agent you intend to run against as available."},"2413":{"id":"/evals-quality/setup-190","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#setup-checklist","content":"Output directory convention agreed for `--output-dir` (local + CI)."},"2414":{"id":"/evals-quality/setup-191","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#see-also","content":"Run evals"},"2415":{"id":"/evals-quality/setup-192","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#see-also","content":"Cluster analysis"},"2416":{"id":"/evals-quality/setup-193","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#see-also","content":"eval command"},"2417":{"id":"/examples/advanced-patterns","page_id":"/examples/advanced-patterns","type":"page","content":"Advanced Patterns","breadcrumbs":["Docs","Reference","Workflow examples"],"tags":[],"url":"/examples/advanced-patterns"},"2418":{"id":"/examples/advanced-patterns-0","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns","content":"Analyze overlap, optimize skills, filter project groups, and manage editable and global skills."},"2419":{"id":"/examples/advanced-patterns-1","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#overview","content":"Overview"},"2420":{"id":"/examples/advanced-patterns-2","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Find duplicate and overlapping skills"},"2421":{"id":"/examples/advanced-patterns-3","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#improve-a-skill-with-optimization","content":"Improve a skill with `optimization`"},"2422":{"id":"/examples/advanced-patterns-4","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#install-only-part-of-a-collection-with-groups","content":"Install only part of a collection with groups"},"2423":{"id":"/examples/advanced-patterns-5","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"Editable and recursive local skills"},"2424":{"id":"/examples/advanced-patterns-6","page_id":"/examples/advanced-patterns","type":"heading","tags":[],"url":"/examples/advanced-patterns#project-vs-global-scope","content":"Project vs. global scope"},"2425":{"id":"/examples/advanced-patterns-7","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#overview","content":"These are real, source-backed workflows for teams managing many skills. Every command below exists in\nthe CLI."},"2426":{"id":"/examples/advanced-patterns-8","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"As a collection grows, skills drift into overlap. `fastskill analysis` surfaces that:"},"2427":{"id":"/examples/advanced-patterns-9","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`analysis duplicates` supports filtering and output control:"},"2428":{"id":"/examples/advanced-patterns-10","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Flag"},"2429":{"id":"/examples/advanced-patterns-11","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Purpose"},"2430":{"id":"/examples/advanced-patterns-12","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--threshold`"},"2431":{"id":"/examples/advanced-patterns-13","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Minimum similarity to report"},"2432":{"id":"/examples/advanced-patterns-14","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--limit`"},"2433":{"id":"/examples/advanced-patterns-15","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Maximum number of pairs to show"},"2434":{"id":"/examples/advanced-patterns-16","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--severity`"},"2435":{"id":"/examples/advanced-patterns-17","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Filter by minimum severity: `critical`, `high`, `medium`, `all`"},"2436":{"id":"/examples/advanced-patterns-18","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--format`"},"2437":{"id":"/examples/advanced-patterns-19","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`table`, `json`, `grid`, or `xml` (`--json` is shorthand)"},"2438":{"id":"/examples/advanced-patterns-20","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#improve-a-skill-with-optimization","content":"`fastskill optimization` runs a text-gradient loop to iteratively improve a skill's content:"},"2439":{"id":"/examples/advanced-patterns-21","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#install-only-part-of-a-collection-with-groups","content":"Skills can be tagged into groups; installs can include or exclude them (poetry-style):"},"2440":{"id":"/examples/advanced-patterns-22","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"For local skill development, add without copying and add whole trees at once:"},"2441":{"id":"/examples/advanced-patterns-23","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"After editing an editable skill in place, run `fastskill index rebuild` so semantic search and resolve\nreflect the changes."},"2442":{"id":"/examples/advanced-patterns-24","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#project-vs-global-scope","content":"Most commands default to the current project. Use `--global` to operate on the shared user-level\nskills directory (`~/.config/fastskill/skills`, tracked by `global-skills.lock`):"},"2443":{"id":"/examples/advanced-patterns-25","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#project-vs-global-scope","content":"Use `analysis` to keep a collection tidy, `optimization` to sharpen individual skills, and group\nfilters\nplus `--global` to control what gets installed where."},"2444":{"id":"/examples/integration-tutorials","page_id":"/examples/integration-tutorials","type":"page","content":"Integration Tutorials","breadcrumbs":["Docs","Reference","Workflow examples"],"tags":[],"url":"/examples/integration-tutorials"},"2445":{"id":"/examples/integration-tutorials-0","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials","content":"Connect FastSkill to agents and pipelines: MCP into Claude Code and Cursor, the serve HTTP API, and locked installs in CI."},"2446":{"id":"/examples/integration-tutorials-1","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#overview","content":"Overview"},"2447":{"id":"/examples/integration-tutorials-2","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"1\\. MCP into Claude Code"},"2448":{"id":"/examples/integration-tutorials-3","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"2\\. MCP into Cursor"},"2449":{"id":"/examples/integration-tutorials-4","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"3\\. Call the HTTP API from an app"},"2450":{"id":"/examples/integration-tutorials-5","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"4\\. Reproducible installs in CI"},"2451":{"id":"/examples/integration-tutorials-6","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#overview","content":"These tutorials cover FastSkill's real integration surfaces: the **MCP** server for agents, the\n**HTTP API** from `fastskill server serve`, and **locked installs** in CI. Each uses commands and endpoints\nthat exist in the tool."},"2452":{"id":"/examples/integration-tutorials-7","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"Expose FastSkill to Claude Code as MCP tools — read-only unless you start the server with\n`--enable-write`."},"2453":{"id":"/examples/integration-tutorials-8","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"Claude Code will now see tools named after complete command paths, such as\n`fastskill_skill_search`, `fastskill_skill_list`, `fastskill_skill_read`, and\n`fastskill_repo_show`. Mutating tools such as `fastskill_project_install` and\n`fastskill_repo_add` are withheld until the server is started with `--enable-write`; see\nWrite access. To point the agent at a running HTTP MCP\nserver instead of spawning FastSkill itself:"},"2454":{"id":"/examples/integration-tutorials-9","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"Same flow, different agent key:"},"2455":{"id":"/examples/integration-tutorials-10","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"Supported agents: `claude`, `cursor`, `gemini`, `copilot`, `opencode`, `codex`. See the full\nMCP tool-calling guide."},"2456":{"id":"/examples/integration-tutorials-11","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"Run the server and use the versioned `/api/v1/...` REST surface. Start read-only:"},"2457":{"id":"/examples/integration-tutorials-12","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"These are all read endpoints and work without `--enable-write`. To manage skills over HTTP (install /\nupdate / delete), start with `fastskill server serve --enable-write`, and front the port with an\nauthenticating proxy if it is exposed — `server serve` enforces no auth of its own. See the\n`server serve` reference and security model."},"2458":{"id":"/examples/integration-tutorials-13","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"Commit `skill-project.toml` and `skills.lock`, then install exact locked versions in the pipeline:"},"2459":{"id":"/examples/integration-tutorials-14","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"Set `OPENAI_API_KEY` from a CI secret if the pipeline needs semantic search or reindex; without it\nthose steps skip silently rather than failing."},"2460":{"id":"/examples/integration-tutorials-15","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"For agents, install FastSkill as an MCP server. For services and pipelines, use the `server serve`\nHTTP API and `project install --lock`. There is no separate SDK to integrate — the CLI, MCP tools,\nand HTTP API are the surface."},"2461":{"id":"/integration/agents","page_id":"/integration/agents","type":"page","content":"Documentation and tools for agents","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/agents"},"2462":{"id":"/integration/agents-0","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents","content":"Retrieve current FastSkill documentation as Markdown and use the CLI or MCP safely."},"2463":{"id":"/integration/agents-1","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#read-the-documentation","content":"Read the documentation"},"2464":{"id":"/integration/agents-2","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#inspect-the-cli-contract","content":"Inspect the CLI contract"},"2465":{"id":"/integration/agents-3","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#preview-apply-verify","content":"Preview, apply, verify"},"2466":{"id":"/integration/agents-4","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#agent-skills-and-mcp","content":"Agent skills and MCP"},"2467":{"id":"/integration/agents-5","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#read-the-documentation","content":"This site documents one release. The release number appears on every page and in\nall Markdown exports. Start with llms.txt, follow its per-page Markdown\nlinks, or download llms-full.txt. These URLs need no authentication\nor browser JavaScript. Each page also provides View Markdown and Copy Markdown."},"2468":{"id":"/integration/agents-6","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#inspect-the-cli-contract","content":"Match the binary version to the documentation. `cli spec` describes the installed\nbinary's complete command tree and flags. Use only the flags supported by that\ncommand; `--json` is not a global flag."},"2469":{"id":"/integration/agents-7","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#preview-apply-verify","content":"Check the process exit status and the returned diagnostics. A valid JSON response\ncan describe failure or partial success. Dry runs validate a plan without changing\nmanaged state; online plans can still fetch inputs. Use `--offline` when supported\nand when required verified content is already available locally."},"2470":{"id":"/integration/agents-8","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#agent-skills-and-mcp","content":"Installed skills provide task instructions. FastSkill's MCP tools provide package\noperations. They are separate interfaces; reading a skill does not require an MCP\nserver. See Claude Code and\nCursor for installation locations and registration."},"2471":{"id":"/integration/agents-9","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#agent-skills-and-mcp","content":"The server exposes read-only tools by default. Mutating tools require\n`mcp serve --enable-write`. Tool names use the full command path, for example\n`fastskill_skill_read` and `fastskill_project_install`. See\nMCP tool access for write configuration."},"2472":{"id":"/integration/claude-code-integration","page_id":"/integration/claude-code-integration","type":"page","content":"Claude Code Integration","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/claude-code-integration"},"2473":{"id":"/integration/claude-code-integration-0","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration","content":"Integrate FastSkill with Claude Code for intelligent skill discovery."},"2474":{"id":"/integration/claude-code-integration-1","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#overview","content":"Overview"},"2475":{"id":"/integration/claude-code-integration-2","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#quick-start","content":"Quick start"},"2476":{"id":"/integration/claude-code-integration-3","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#how-it-works","content":"How it works"},"2477":{"id":"/integration/claude-code-integration-4","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#github-actions","content":"GitHub Actions"},"2478":{"id":"/integration/claude-code-integration-5","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#troubleshooting","content":"Troubleshooting"},"2479":{"id":"/integration/claude-code-integration-6","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#mcp-registration","content":"MCP Registration"},"2480":{"id":"/integration/claude-code-integration-7","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#http-api","content":"HTTP API"},"2481":{"id":"/integration/claude-code-integration-8","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#overview","content":"Claude Code reads skills **directly** from the skills directory (`.claude/skills/` by\ndefault). FastSkill's job is to get the right skills onto disk and keep them reconciled with\nyour manifest — once a skill is installed, Claude Code discovers it natively. There is no\nmetadata file to generate or keep in sync."},"2482":{"id":"/integration/claude-code-integration-9","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#quick-start","content":"That's it — the next time Claude Code runs in this project, the installed skills are available."},"2483":{"id":"/integration/claude-code-integration-10","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"`fastskill project install` / `fastskill skill add` materializes skills into the configured\n`skills_directory` (default `.claude/skills/`)."},"2484":{"id":"/integration/claude-code-integration-11","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Each skill is a folder containing `SKILL.md` plus its resources."},"2485":{"id":"/integration/claude-code-integration-12","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Claude Code scans that directory and loads skills by their `SKILL.md` frontmatter — no\nexport or sync step is involved."},"2486":{"id":"/integration/claude-code-integration-13","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Use `fastskill skill read <skill-id>` to see exactly what an agent loads, or\n`fastskill skill read <skill-id> --meta` for just the metadata."},"2487":{"id":"/integration/claude-code-integration-14","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#github-actions","content":"Keep the skills directory reconciled in CI so commits always carry the resolved skill set:"},"2488":{"id":"/integration/claude-code-integration-15","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#troubleshooting","content":"**Claude Code doesn't see a skill:** Confirm it is installed with `fastskill skill list`, and that\nthe skills directory contains a valid `SKILL.md` for it. `fastskill skill read <skill-id>` should\nprint its content."},"2489":{"id":"/integration/claude-code-integration-16","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#troubleshooting","content":"**Wrong skills directory:** Claude Code and FastSkill must agree on the location. The default\nis `.claude/skills/`; override it via `skills_directory` under `[tool.fastskill]` in\n`skill-project.toml` or the `--skills-dir` flag."},"2490":{"id":"/integration/claude-code-integration-17","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#mcp-registration","content":"Register `fastskill` as an MCP server inside Claude Code with a single command:"},"2491":{"id":"/integration/claude-code-integration-18","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#mcp-registration","content":"After running the command, reload Claude Code. The tools exposed by\n`fastskill mcp serve --transport stdio` will be callable from the agent — the read-only ones only.\nMutating tools (`fastskill_project_install`, `fastskill_skill_add`,\n`fastskill_skill_remove`, …) require `mcp serve --enable-write`; see\nWrite access."},"2492":{"id":"/integration/claude-code-integration-19","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"`fastskill server serve` exposes FastSkill's versioned application API under `/api/v1/…`, for example `GET /api/v1/status` and `GET /api/v1/skills`."},"2493":{"id":"/integration/claude-code-integration-20","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"The old Claude-compatible `/v1/skills…` HTTP surface is no longer part of the public server. Use the MCP integration above for Claude Code and use `/api/v1/…` for HTTP clients."},"2494":{"id":"/integration/claude-code-integration-21","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"See the agent’s skill documentation for native discovery behavior."},"2495":{"id":"/integration/cursor-integration","page_id":"/integration/cursor-integration","type":"page","content":"Cursor Integration","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/cursor-integration"},"2496":{"id":"/integration/cursor-integration-0","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration","content":"Integrate FastSkill with Cursor IDE for intelligent skill discovery and tool recommendations."},"2497":{"id":"/integration/cursor-integration-1","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#overview","content":"Overview"},"2498":{"id":"/integration/cursor-integration-2","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#quick-start","content":"Quick start"},"2499":{"id":"/integration/cursor-integration-3","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#mcp-registration","content":"MCP registration"},"2500":{"id":"/integration/cursor-integration-4","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"How Cursor uses the skills"},"2501":{"id":"/integration/cursor-integration-5","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#example","content":"Example"},"2502":{"id":"/integration/cursor-integration-6","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#configuration","content":"Configuration"},"2503":{"id":"/integration/cursor-integration-7","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#multiple-skill-directories","content":"Multiple skill directories"},"2504":{"id":"/integration/cursor-integration-8","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#automation","content":"Automation"},"2505":{"id":"/integration/cursor-integration-9","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#troubleshooting","content":"Troubleshooting"},"2506":{"id":"/integration/cursor-integration-10","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#summary","content":"Summary"},"2507":{"id":"/integration/cursor-integration-11","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#overview","content":"Cursor discovers skills **directly** from the skills directory (`.claude/skills/` by default)\nand via the FastSkill MCP server. FastSkill's job is to install the right skills onto disk and\nkeep them reconciled with your manifest — there is no metadata file to generate or keep in sync."},"2508":{"id":"/integration/cursor-integration-12","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#overview","content":"Modern agents (Cursor, Claude Code, …) read installed skills from the skills directory natively.\nJust `fastskill project install` (or `fastskill skill add`) and the skills are available. Register the MCP\nserver below for richer, tool-based access from inside Cursor."},"2509":{"id":"/integration/cursor-integration-13","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#mcp-registration","content":"Register `fastskill` as an MCP server inside Cursor with a single command:"},"2510":{"id":"/integration/cursor-integration-14","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#mcp-registration","content":"After running the command, reload Cursor. The tools exposed by\n`fastskill mcp serve --transport stdio` will be callable from the agent — the read-only ones only.\nMutating tools (`fastskill_project_install`, `fastskill_skill_add`,\n`fastskill_skill_remove`, …) require\n`mcp serve --enable-write`; see Write access."},"2511":{"id":"/integration/cursor-integration-15","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"When you ask Cursor to perform a task, it:"},"2512":{"id":"/integration/cursor-integration-16","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"**Reads available skills** from the skills directory (and the FastSkill MCP server, if\nregistered)."},"2513":{"id":"/integration/cursor-integration-17","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"**Matches task requirements** against each skill's `description` frontmatter."},"2514":{"id":"/integration/cursor-integration-18","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"**Loads the full `SKILL.md`** for relevant skills to get instructions and parameters —\nthe same content `fastskill skill read <skill-id>` prints."},"2515":{"id":"/integration/cursor-integration-19","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#example","content":"**User query:*&#x2A; &#x2A;\"Help me create a PowerPoint presentation for my quarterly review.\"*"},"2516":{"id":"/integration/cursor-integration-20","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#example","content":"Cursor scans installed skills for presentation-related descriptions, finds a match (e.g.\n`pptx`), loads its `SKILL.md`, and follows the skill's instructions to complete the task."},"2517":{"id":"/integration/cursor-integration-21","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#configuration","content":"Ensure your project has a `skill-project.toml` and that Cursor and FastSkill agree on the\nskills directory. The default is `.claude/skills/`; override it via `skills_directory` under\n`[tool.fastskill]` in `skill-project.toml` or the `--skills-dir` flag."},"2518":{"id":"/integration/cursor-integration-22","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#automation","content":"Keep the skills directory reconciled in CI so commits always carry the resolved skill set:"},"2519":{"id":"/integration/cursor-integration-23","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#troubleshooting","content":"**Cursor doesn't see a skill**"},"2520":{"id":"/integration/cursor-integration-24","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#troubleshooting","content":"**Semantic search returns nothing**"},"2521":{"id":"/integration/cursor-integration-25","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#troubleshooting","content":"**Check environment readiness**"},"2522":{"id":"/integration/cursor-integration-26","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"FastSkill's Cursor integration provides:"},"2523":{"id":"/integration/cursor-integration-27","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"**Direct skill discovery** — Cursor reads installed skills from the skills directory, no sync step"},"2524":{"id":"/integration/cursor-integration-28","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"**MCP access** — register the FastSkill MCP server for tool-based access inside Cursor"},"2525":{"id":"/integration/cursor-integration-29","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"**Reproducible installs** — `skill-project.toml` + `skills.lock` keep the skill set consistent across the team"},"2526":{"id":"/integration/cursor-integration-30","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"**Optional semantic search** — `fastskill index rebuild` + `fastskill skill search --local` when an embedding provider is configured"},"2527":{"id":"/integration/cursor-integration-31","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"See the agent’s skill documentation for native discovery behavior."},"2528":{"id":"/optimize/configuration","page_id":"/optimize/configuration","type":"page","content":"Configuration Reference","breadcrumbs":["Docs","Evaluate and optimize","Optimization"],"tags":[],"url":"/optimize/configuration"},"2529":{"id":"/optimize/configuration-0","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration","content":"All fields in optimize.toml, with valid ranges, defaults, and guidance on choosing values."},"2530":{"id":"/optimize/configuration-1","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#configuration-reference","content":"Configuration Reference"},"2531":{"id":"/optimize/configuration-2","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#minimal-example","content":"Minimal example"},"2532":{"id":"/optimize/configuration-3","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#full-reference","content":"Full reference"},"2533":{"id":"/optimize/configuration-4","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#artifacts-and-data","content":"Artifacts and data"},"2534":{"id":"/optimize/configuration-5","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#agents","content":"Agents"},"2535":{"id":"/optimize/configuration-6","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#training-loop","content":"Training loop"},"2536":{"id":"/optimize/configuration-7","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#gate","content":"Gate"},"2537":{"id":"/optimize/configuration-8","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#epoch-boundary","content":"Epoch boundary"},"2538":{"id":"/optimize/configuration-9","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#worked-example-a-focused-deployment-skill","content":"Worked example: a focused deployment skill"},"2539":{"id":"/optimize/configuration-10","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#validation-errors","content":"Validation errors"},"2540":{"id":"/optimize/configuration-11","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#see-also","content":"See also"},"2541":{"id":"/optimize/configuration-12","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#configuration-reference","content":"Optimization runs are driven by a TOML config file. By convention this file is named `optimize.toml` (you can name it anything — pass the path with `--config`)."},"2542":{"id":"/optimize/configuration-13","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#minimal-example","content":"`SkillOptToml` has no `#[serde(default)]` on most fields, so serde requires them to be\npresent in the file — only `checks`, `target_model`, `optimizer_agent`, `optimizer_model`,\n`mixed_hard_weight`, and `parallel` are truly optional. This example is the smallest config\nthat actually parses (verified against the binary — a shorter version that omits any of\nthese fields fails with `OPTIMIZE_INVALID_TOML: ... missing field '<name>'`, one field at a\ntime):"},"2543":{"id":"/optimize/configuration-14","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Field"},"2544":{"id":"/optimize/configuration-15","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Type"},"2545":{"id":"/optimize/configuration-16","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Required"},"2546":{"id":"/optimize/configuration-17","page_id":"/optimize/c