gs":[],"url":"/testing/framework#see-also","content":"See also"},"3487":{"id":"/testing/framework-5","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#overview","content":"The way you test a skill in FastSkill is `fastskill eval`. You define eval cases in your project\nmanifest, run them against an agent, and score the results. There is no separate unit/mock harness —\neval is the testing framework."},"3488":{"id":"/testing/framework-6","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#configure-evals","content":"Evals are declared under `[tool.fastskill.eval]` in `skill-project.toml`:"},"3489":{"id":"/testing/framework-7","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#configure-evals","content":"`prompts` — path to a CSV of prompt cases to run."},"3490":{"id":"/testing/framework-8","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#configure-evals","content":"`checks` — path to a TOML file of checks applied to each result."},"3491":{"id":"/testing/framework-9","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#configure-evals","content":"`timeout_seconds` — per-case timeout."},"3492":{"id":"/testing/framework-10","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#configure-evals","content":"`fail_on_missing_agent` — when `true`, eval fails instead of skipping if the agent isn't found."},"3493":{"id":"/testing/framework-11","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Command"},"3494":{"id":"/testing/framework-12","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"What it does"},"3495":{"id":"/testing/framework-13","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"`fastskill eval validate`"},"3496":{"id":"/testing/framework-14","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Validates the eval configuration and referenced files before running"},"3497":{"id":"/testing/framework-15","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"`fastskill eval run`"},"3498":{"id":"/testing/framework-16","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Runs the eval cases against an agent"},"3499":{"id":"/testing/framework-17","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"`fastskill eval report`"},"3500":{"id":"/testing/framework-18","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Shows a report for a completed eval run"},"3501":{"id":"/testing/framework-19","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"`fastskill eval score`"},"3502":{"id":"/testing/framework-20","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Scores results"},"3503":{"id":"/testing/framework-21","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Eval output supports `--format table|json` (no grid/xml for eval)."},"3504":{"id":"/testing/framework-22","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#the-eval-subcommands","content":"Start by pinning down what \"good\" looks like in your `checks.toml`, then iterate: `eval run` →\n`eval report` → adjust the skill → repeat."},"3505":{"id":"/testing/framework-23","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#see-also","content":"Evals & quality overview — the quality workflow and concepts."},"3506":{"id":"/testing/framework-24","page_id":"/testing/framework","tags":[],"type":"text","url":"/testing/framework#see-also","content":"eval command reference — full flags and output details."},"3507":{"id":"/tool-calling/development","page_id":"/tool-calling/development","type":"page","content":"MCP Tool Calling","breadcrumbs":["Docs","Connect agents","MCP tools"],"tags":[],"url":"/tool-calling/development"},"3508":{"id":"/tool-calling/development-0","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development","content":"Expose FastSkill to agents as MCP tools with `fastskill mcp serve` (read-only by default, `--enable-write` to allow mutation), and wire them into Claude Code, Cursor, and other agents with `fastskill mcp install`."},"3509":{"id":"/tool-calling/development-1","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#overview","content":"Overview"},"3510":{"id":"/tool-calling/development-2","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"Serve FastSkill as an MCP server"},"3511":{"id":"/tool-calling/development-3","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#write-access","content":"Write access"},"3512":{"id":"/tool-calling/development-4","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#transports","content":"Transports"},"3513":{"id":"/tool-calling/development-5","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#install-into-an-agent","content":"Install into an agent"},"3514":{"id":"/tool-calling/development-6","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#list-configured-mcp-servers","content":"List configured MCP servers"},"3515":{"id":"/tool-calling/development-7","page_id":"/tool-calling/development","type":"heading","tags":[],"url":"/tool-calling/development#see-also","content":"See also"},"3516":{"id":"/tool-calling/development-8","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#overview","content":"FastSkill's tool/integration surface for agents is **MCP** (Model Context Protocol). You do not\nauthor custom tools inside FastSkill — instead, `fastskill mcp serve` exposes FastSkill CLI commands\nto an agent as MCP tools, and `fastskill mcp install` writes the server config into your agent's\nconfiguration."},"3517":{"id":"/tool-calling/development-9","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#overview","content":"The server is **read-only by default**: the mutating commands are not exported as tools unless you\nstart it with `--enable-write`. See Write access below."},"3518":{"id":"/tool-calling/development-10","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"Each exported CLI command is registered as an MCP tool named `fastskill_<path>`, where the command\npath has its separators replaced by underscores. For example:"},"3519":{"id":"/tool-calling/development-11","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"CLI command"},"3520":{"id":"/tool-calling/development-12","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"MCP tool name"},"3521":{"id":"/tool-calling/development-13","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill skill search`"},"3522":{"id":"/tool-calling/development-14","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill_skill_search`"},"3523":{"id":"/tool-calling/development-15","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill repo add`"},"3524":{"id":"/tool-calling/development-16","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill_repo_add`"},"3525":{"id":"/tool-calling/development-17","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill project install`"},"3526":{"id":"/tool-calling/development-18","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill_project_install`"},"3527":{"id":"/tool-calling/development-19","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill skill list`"},"3528":{"id":"/tool-calling/development-20","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"`fastskill_skill_list`"},"3529":{"id":"/tool-calling/development-21","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#serve-fastskill-as-an-mcp-server","content":"The `mcp` commands themselves, `server serve`, and the built-in `cli completion` and `cli spec` commands are not\nexported as tools."},"3530":{"id":"/tool-calling/development-22","page_id":"/tool-calling/development","tags":[],"type":"text","url":"/tool-calling/development#write-access","content":"`fastskill mcp serve` is read-only unless you pass `--enable-write`, spelled exactly as\n`fastskill server serve`'s flag because it means the same thing. Both gates