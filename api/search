 is configured"},"2340":{"id":"/integration/cursor-integration-31","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#summary","content":"See the agent’s skill documentation for native discovery behavior."},"2341":{"id":"/optimize/configuration","page_id":"/optimize/configuration","type":"page","content":"Configuration Reference","breadcrumbs":["Docs","Evaluate and optimize","Optimization"],"tags":[],"url":"/optimize/configuration"},"2342":{"id":"/optimize/configuration-0","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration","content":"All fields in optimize.toml, with valid ranges, defaults, and guidance on choosing values."},"2343":{"id":"/optimize/configuration-1","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#configuration-reference","content":"Configuration Reference"},"2344":{"id":"/optimize/configuration-2","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#minimal-example","content":"Minimal example"},"2345":{"id":"/optimize/configuration-3","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#full-reference","content":"Full reference"},"2346":{"id":"/optimize/configuration-4","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#artifacts-and-data","content":"Artifacts and data"},"2347":{"id":"/optimize/configuration-5","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#agents","content":"Agents"},"2348":{"id":"/optimize/configuration-6","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#training-loop","content":"Training loop"},"2349":{"id":"/optimize/configuration-7","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#gate","content":"Gate"},"2350":{"id":"/optimize/configuration-8","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#epoch-boundary","content":"Epoch boundary"},"2351":{"id":"/optimize/configuration-9","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#worked-example-a-focused-deployment-skill","content":"Worked example: a focused deployment skill"},"2352":{"id":"/optimize/configuration-10","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#validation-errors","content":"Validation errors"},"2353":{"id":"/optimize/configuration-11","page_id":"/optimize/configuration","type":"heading","tags":[],"url":"/optimize/configuration#see-also","content":"See also"},"2354":{"id":"/optimize/configuration-12","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#configuration-reference","content":"Optimization runs are driven by a TOML config file. By convention this file is named `optimize.toml` (you can name it anything — pass the path with `--config`)."},"2355":{"id":"/optimize/configuration-13","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#minimal-example","content":"`SkillOptToml` has no `#[serde(default)]` on most fields, so serde requires them to be\npresent in the file — only `checks`, `target_model`, `optimizer_agent`, `optimizer_model`,\n`mixed_hard_weight`, and `parallel` are truly optional. This example is the smallest config\nthat actually parses (verified against the binary — a shorter version that omits any of\nthese fields fails with `OPTIMIZE_INVALID_TOML: ... missing field '<name>'`, one field at a\ntime):"},"2356":{"id":"/optimize/configuration-14","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Field"},"2357":{"id":"/optimize/configuration-15","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuratio