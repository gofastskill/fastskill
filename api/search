","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Field"},"2385":{"id":"/optimize/configuration-15","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Type"},"2386":{"id":"/optimize/configuration-16","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Required"},"2387":{"id":"/optimize/configuration-17","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Description"},"2388":{"id":"/optimize/configuration-18","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"`skill`"},"2389":{"id":"/optimize/configuration-19","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"path"},"2390":{"id":"/optimize/configuration-20","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Yes"},"2391":{"id":"/optimize/configuration-21","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Path to the seed skill document (usually `SKILL.md`). This is the starting point — the optimizer modifies copies of this."},"2392":{"id":"/optimize/configuration-22","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"`skill_name`"},"2393":{"id":"/optimize/configuration-23","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"string"},"2394":{"id":"/optimize/configuration-24","page_id":"/optimize/configuration","tags":[],"type":"text","url":"/optimize/configuration#artifacts-and-data","content":"Yes"},"2395":{"id":"/opti