-reference/update-command-51","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#options","content":"Update the global skill set and `global-skills.lock`."},"1974":{"id":"/cli-reference/update-command-52","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#options","content":"`false`"},"1975":{"id":"/cli-reference/update-command-53","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#options","content":"`--to-version`, `--strategy`, and `--repository` apply only to repository-origin skills. The\ncommand rejects these controls without one `SKILL_ID`, controls applied to local/Git/ZIP origins,\nconflicting `--source` and `--repository` values, and `--check` with `--dry-run`."},"1976":{"id":"/cli-reference/update-command-54","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#preview-and-check","content":"Both preview modes resolve and validate the same candidates as an update, without changing files,\nthe manifest, lockfile, timestamps, repository indexes, or the vector index."},"1977":{"id":"/cli-reference/update-command-55","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#preview-and-check","content":"`--check` and `--dry-run` report the same validated target information; `--check` is the concise\ninspection form and `--dry-run` is the explicit lifecycle preview form."},"1978":{"id":"/cli-reference/update-command-56","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#apply-an-update","content":"The exact change labels can include `origin changed`, `resolved content changed`, `groups changed`,\nand `dependency ownership changed`. Ownership changes are calculated per selected root, so an\nunrelated root is not reported as updated when another root's closure changes."},"1979":{"id":"/cli-reference/update-command-57","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#version-controls","content":"An exact target can be a deliberate downgrade. `patch` stays within the current major/minor,\n`minor` stays within the current major, and `latest`/`major` use the recorded constraint. An exact\npin is never widened implicitly."},"1980":{"id":"/cli-reference/update-command-58","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#global-updates","content":"Global JSON uses the same lifecycle keys as project JSON: `scope`, `outcome`, `dry_run`, `targets`,\n`diagnostics`, `resolution`, and `indexing`. A missing global lock returns an unchanged document\nwith explicit skipped-indexing diagnostics rather than `null` lifecycle fields."},"1981":{"id":"/cli-reference/update-command-59","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#failure-and-recovery","content":"Before mutation, fastskill verifies selected managed content and refuses to replace local edits.\nEach affected closure is staged and validated. A failed application restores its prior files and\nstate, reports the failed target, and exits nonzero."},"1982":{"id":"/cli-reference/update-command-60","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#see-also","content":"Project install."},"1983":{"id":"/cli-reference/update-command-61","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#see-also","content":"Skill and project commands."},"1984":{"id":"/cli-reference/update-command-62","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#see-also","content":"Reconciliation."},"1985":{"id":"/configuration/init-command","page_id":"/configuration/init-command","type":"page","content":"