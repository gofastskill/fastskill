s":[],"type":"text","url":"/evals-quality/setup#prerequisites","content":"`skill-project.toml` exists (project root or skill directory — `fastskill` walks up the tree to find it)."},"2051":{"id":"/evals-quality/setup-20","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#prerequisites","content":"`SKILL.md` exists alongside it if you're authoring a single skill's suite."},"2052":{"id":"/evals-quality/setup-21","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#prerequisites","content":"For `fastskill eval run`: a supported agent CLI on `PATH`. Agent keys come from aikit-sdk: `aikit`, `claude`, `codex`, `cursor`, `gemini`, and `pi`. A key is accepted only when its CLI is detected on the current machine; a typo and an uninstalled agent both error with `RUNTIME_UNKNOWN_ID`. `fastskill eval validate --all` reports which keys are detected in *your* environment."},"2053":{"id":"/evals-quality/setup-22","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#prerequisites","content":"Deterministic validation and scoring need no model credential. Target execution needs the\nselected runtime's authentication; native judges separately need their configured endpoint,\nmodel, and credential environment variable. Embedding configuration is unrelated."},"2054":{"id":"/evals-quality/setup-23","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Add this table to `skill-project.toml`. Every path is resolved relative to the **skill project root** (the directory containing `skill-project.toml`) unless it's absolute."},"2055":{"id":"/evals-quality/setup-24","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Field"},"2056":{"id":"/evals-quality/setup-25","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Type"},"2057":{"id":"/evals-quality/setup-26","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Required"},"2058":{"id":"/evals-quality/setup-27","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Default"},"2059":{"id":"/evals-quality/setup-28","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Meaning"},"2060":{"id":"/evals-quality/setup-29","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`prompts`"},"2061":{"id":"/evals-quality/setup-30","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"path"},"2062":{"id":"/evals-quality/setup-31","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"**yes**"},"2063":{"id":"/evals-quality/setup-32","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"—"},"2064":{"id":"/evals-quality/setup-33","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Path to the prompts CSV."},"2065":{"id":"/evals-quality/setup-34","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`checks`"},"2066":{"id":"/evals-quality/setup-35","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"path"},"2067":{"id":"/evals-quality/setup-36","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2068":{"id":"/evals-quality/setup-37","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"none"},"2069":{"id":"/evals-quality/setup-38","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Path to the checks TOML. Even when omitted, `should_trigger` produces a per-case trigger expectation — see the callout below."},"2070":{"id":"/evals-quality/setup-39","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`timeout_seconds`"},"2071":{"id":"/evals-quality/setup-40","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"integer"},"2072":{"id":"/evals-quality/setup-41","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2073":{"id":"/evals-quality/setup-42","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`900`"},"2074":{"id":"/evals-quality/setup-43","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Per-case timeout passed to the agent run."},"2075":{"id":"/evals-quality/setup-44","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`trials_per_case`"},"2076":{"id":"/evals-quality/setup-45","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"integer"},"2077":{"id":"/evals-quality/setup-46","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2078":{"id":"/evals-quality/setup-47","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`1`"},"2079":{"id":"/evals-quality/setup-48","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Trials run per case; validated to `[1, 1000]` (`EVAL_INVALID_TRIALS_CONFIG` otherwise)."},"2080":{"id":"/evals-quality/setup-49","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`parallel`"},"2081":{"id":"/evals-quality/setup-50","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"integer"},"2082":{"id":"/evals-quality/setup-51","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2083":{"id":"/evals-quality/setup-52","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"unset (CPU core count)"},"2084":{"id":"/evals-quality/setup-53","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Max concurrent trials for one case."},"2085":{"id":"/evals-quality/setup-54","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`pass_threshold`"},"2086":{"id":"/evals-quality/setup-55","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"float"},"2087":{"id":"/evals-quality/setup-56","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2088":{"id":"/evals-quality/setup-57","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`1.0`"},"2089":{"id":"/evals-quality/setup-58","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Fraction of trials that must pass for a case to be marked passed; validated to `[0.0, 1.0]` (`EVAL_INVALID_THRESHOLD` otherwise)."},"2090":{"id":"/evals-quality/setup-59","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`fail_on_missing_agent`"},"2091":{"id":"/evals-quality/setup-60","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"bool"},"2092":{"id":"/evals-quality/setup-61","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"no"},"2093":{"id":"/evals-quality/setup-62","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"**`true`**"},"2094":{"id":"/evals-quality/setup-63","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"If true, `eval run` and `eval validate --agent <key>` error with `EVAL_AGENT_UNAVAILABLE` when the chosen agent isn't installed."},"2095":{"id":"/evals-quality/setup-64","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"**Defaults verified against source** (`crates/fastskill-core/src/core/manifest.rs::EvalConfigToml`): `timeout_seconds` defaults to **900**, and `fail_on_missing_agent` defaults to **true** — the CLI refuses to run against a missing agent unless you explicitly set it to `false`. Don't assume otherwise from older examples."},"2096":{"id":"/evals-quality/setup-65","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"With no `checks` file configured, each case still receives the required skill-consultation expectation implied by `should_trigger`. A successful process exit alone is not enough. Add a checks file for further deterministic outcome or adherence evidence."},"2097":{"id":"/evals-quality/setup-66","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#validate-the-config","content":"Real output against a working config (this one set `timeout_seconds = 120` and `fail_on_missing_agent = false`):"},"2098":{"id":"/evals-quality/setup-67","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#validate-the-config","content":"(`parallel: 0` here just means \"unset\" in the table renderer — the runner still falls back to CPU core count.) A broken `checks.toml` fails validation immediately, e.g.:"},"2099":{"id":"/evals-quality/setup-68","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#validate-the-config","content":"A prompts CSV missing a required column fails the same way:"},"2100":{"id":"/evals-quality/setup-69","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"The suite loader (`aikit-evals::suite`) reads a header row with **required** columns `id`, `prompt`, `should_trigger`, plus optional `tags` and `workspace_subdir`."},"2101":{"id":"/evals-quality/setup-70","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Column"},"2102":{"id":"/evals-quality/setup-71","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Required"},"2103":{"id":"/evals-quality/setup-72","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Meaning"},"2104":{"id":"/evals-quality/setup-73","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`id`"},"2105":{"id":"/evals-quality/setup-74","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"yes"},"2106":{"id":"/evals-quality/setup-75","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Non-empty identifier per row. Used for `--case`, artifact folder names, and reports."},"2107":{"id":"/evals-quality/setup-76","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`prompt`"},"2108":{"id":"/evals-quality/setup-77","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"yes"},"2109":{"id":"/evals-quality/setup-78","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Text sent to the agent. Use CSV quoting (`\"...\"`, doubled `\"\"` for an embedded quote) for commas or newlines."},"2110":{"id":"/evals-quality/setup-79","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`should_trigger`"},"2111":{"id":"/evals-quality/setup-80","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"yes"},"2112":{"id":"/evals-quality/setup-81","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`true`/`1` (case-insensitive `true`) or anything else counts as `false`. It creates a required per-case skill-consultation expectation; see below."},"2113":{"id":"/evals-quality/setup-82","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`tags`"},"2114":{"id":"/evals-quality/setup-83","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"no"},"2115":{"id":"/evals-quality/setup-84","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Comma-separated tags inside the cell (e.g. `\"smoke,basic\"`). Used by `eval run --tag <name>`."},"2116":{"id":"/evals-quality/setup-85","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"`workspace_subdir`"},"2117":{"id":"/evals-quality/setup-86","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"no"},"2118":{"id":"/evals-quality/setup-87","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Relative path that becomes the agent's working directory for the case. Under the default isolation it is created **inside the case's scratch workspace**, with fixture files copied in from the same path under the project root; under `--no-isolation` it resolves directly under the project root. Empty or omitted → workspace root."},"2119":{"id":"/evals-quality/setup-88","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"Empty lines are skipped."},"2120":{"id":"/evals-quality/setup-89","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"**`should_trigger` affects pass/fail.** The engine creates an implicit required `skill_invoked` check for each case, with `expected` equal to the CSV value. An explicit `skill_invoked` check that applies to the case replaces the implicit one; `eval validate` rejects a contradictory polarity. Therefore `false` tests non-consultation and `true` tests consultation, subject to the selected backend's observability."},"2121":{"id":"/evals-quality/setup-90","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#2-the-prompts-csv","content":"This is adherence/selection evidence, not outcome correctness. A structured `Skill` call is direct evidence; supported decoders may also recognize a tool input that references the staged skill-document path. The path proxy indicates consultation, not that the instructions were read or followed. Pair positive cases with outcome checks or judges."},"2122":{"id":"/evals-quality/setup-91","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#3-checks-checkstoml-optional","content":"Point `checks` at a TOML file with one or more `[[check]]` tables, keyed by the required `name` field. There are exactly five check types (`aikit_evals::checks::CheckDefinition`):"},"2123":{"id":"/evals-quality/setup-92","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#3-checks-checkstoml-optional","content":"**Checks score the canonical trace, never raw stdout.** Every check below matches against the run's `trace.jsonl` — the parsed, structured event stream. Raw stdout is deliberately excluded: with the `claude` agent it opens with a `system`/`project init` event listing **every skill installed in the environment**, which used to make any skill-name pattern pass vacuously. Assistant text still reaches the trace as message events, so matching on what the agent actually said continues to work."},"2124":{"id":"/evals-quality/setup-93","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"The check you almost certainly want for \"did my skill fire?\"."},"2125":{"id":"/evals-quality/setup-94","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Field"},"2126":{"id":"/evals-quality/setup-95","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Type"},"2127":{"id":"/evals-quality/setup-96","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Required"},"2128":{"id":"/evals-quality/setup-97","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Default"},"2129":{"id":"/evals-quality/setup-98","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`skill`"},"2130":{"id":"/evals-quality/setup-99","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"string"},"2131":{"id":"/evals-quality/setup-100","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2132":{"id":"/evals-quality/setup-101","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"— (omit to match *any* skill invocation)"},"2133":{"id":"/evals-quality/setup-102","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`expected`"},"2134":{"id":"/evals-quality/setup-103","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"bool"},"2135":{"id":"/evals-quality/setup-104","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2136":{"id":"/evals-quality/setup-105","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`true` (`false` asserts the skill did **not** run)"},"2137":{"id":"/evals-quality/setup-106","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`required`"},"2138":{"id":"/evals-quality/setup-107","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"bool"},"2139":{"id":"/evals-quality/setup-108","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2140":{"id":"/evals-quality/setup-109","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`true`"},"2141":{"id":"/evals-quality/setup-110","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"`cases`"},"2142":{"id":"/evals-quality/setup-111","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"string array"},"2143":{"id":"/evals-quality/setup-112","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"no"},"2144":{"id":"/evals-quality/setup-113","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"all cases (exact case IDs)"},"2145":{"id":"/evals-quality/setup-114","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Matches a structured `Skill` invocation or, where the decoder supplies it, a tool input referring to the staged skill-document path. When `skill` is given, a structured invocation must exactly match its identifying field. A skill name merely mentioned in unrelated prose does not count. Path-reference matching improves portability but remains a consultation proxy rather than proof of adherence."},"2146":{"id":"/evals-quality/setup-115","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#skill_invoked","content":"Every check type supports `cases = [\"case-id\", ...]`, selecting exact case IDs. An absent selector applies to every case. Use selectors for checks that should not run across a mixed suite."},"2147":{"id":"/evals-quality/setup-116","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Field"},"2148":{"id":"/evals-quality/setup-117","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Type"},"2149":{"id":"/evals-quality/setup-118","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Required"},"2150":{"id":"/evals-quality/setup-119","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"Default"},"2151":{"id":"/evals-quality/setup-120","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`pattern`"},"2152":{"id":"/evals-quality/setup-121","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"string"},"2153":{"id":"/evals-quality/setup-122","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"yes"},"2154":{"id":"/evals-quality/setup-123","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"—"},"2155":{"id":"/evals-quality/setup-124","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`expected`"},"2156":{"id":"/evals-quality/setup-125","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"bool"},"2157":{"id":"/evals-quality/setup-126","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"yes"},"2158":{"id":"/evals-quality/setup-127","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"— (`true` = pattern must appear, `false` = must NOT appear)"},"2159":{"id":"/evals-quality/setup-128","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expectation","content":"`required`"},"2160":{"id":"/evals-quality/setup-129","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#trigger_expec