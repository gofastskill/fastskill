.md has `version: \"1.0.0\"`, the marketplace.json will use `\"2.0.0\"`. Similarly, if skill-project.toml has `author = \"New Author\"`, it will override the author from SKILL.md. The `name` field always comes from SKILL.md frontmatter for display purposes, as it is not present in skill-project.toml."},"3033":{"id":"/registry/marketplace-json-140","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"The registry validates `marketplace.json` files:"},"3034":{"id":"/registry/marketplace-json-141","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"All required fields must be present"},"3035":{"id":"/registry/marketplace-json-142","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"`id`, `name`, and `description` must not be empty"},"3036":{"id":"/registry/marketplace-json-143","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#validation","content":"Skills with invalid data are skipped"},"3037":{"id":"/registry/marketplace-json-144","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Marketplace.json files are cached for 5 minutes to reduce network requests. To force a refresh:"},"3038":{"id":"/registry/marketplace-json-145","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Wait 5 minutes for cache expiry"},"3039":{"id":"/registry/marketplace-json-146","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Restart the server"},"3040":{"id":"/registry/marketplace-json-147","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#caching","content":"Clear cache manually (future feature)"},"3041":{"id":"/registry/marketplace-json-148","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Keep it updated**: Regenerate `marketplace.json` when skills change"},"3042":{"id":"/registry/marketplace-json-149","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Use semantic versioning**: Use clear version identifiers"},"3043":{"id":"/registry/marketplace-json-150","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Include all metadata**: Provide tags, capabilities, and author information"},"3044":{"id":"/registry/marketplace-json-151","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Test accessibility**: Verify the URL is accessible from your environment"},"3045":{"id":"/registry/marketplace-json-152","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#best-practices","content":"**Version control**: Commit `marketplace.json` to your repository"},"3046":{"id":"/registry/marketplace-json-153","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#see-also","content":"Repository Command"},"3047":{"id":"/registry/marketplace-json-154","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#see-also","content":"Sources Configuration"},"3048":{"id":"/registry/marketplace-json-155","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#see-also","content":"Registry Overview"},"3049":{"id":"/registry/overview","page_id":"/registry/overview","type":"page","content":"Sources and catalogs","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/overview"},"3050":{"id":"/registry/overview-0","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview","content":"Discover skills from configured sources and choose how to distribute a team setup."},"3051":{"id":"/registry/overview-1","page_id":"/registry/overview","type":"heading","tags":[],"url":"/registry/overview#choose-a-source","content":"Choose a source"},"3052":{"id":"/registry/overview-2","page_id":"/registry/overview","type":"heading","tags":[],"url":"/registry/overview#discover-and-install","content":"Discover and install"},"3053":{"id":"/registry/overview-3","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview","content":"A repository configuration gives FastSkill a named source for discovering and\ninstalling skills. It is separate from the installed skill directory and from the\nlocal browser console."},"3054":{"id":"/registry/overview-4","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**Git marketplace**: a Git repository with a marketplace document."},"3055":{"id":"/registry/overview-5","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**HTTP registry**: an HTTP index and downloadable skill artifacts."},"3056":{"id":"/registry/overview-6","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**ZIP catalog**: a base URL exposing marketplace metadata and ZIP downloads."},"3057":{"id":"/registry/overview-7","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"**Local catalog**: skill content and catalog metadata on disk."},"3058":{"id":"/registry/overview-8","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#choose-a-source","content":"See source configuration for the manifest fields, authentication,\nand direct Git origins. For an exact portable team setup, use\nbundles."},"3059":{"id":"/registry/overview-9","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#discover-and-install","content":"The following commands assume a configured repository named `team`; replace the\nexample skill ID with a result from that repository:"},"3060":{"id":"/registry/overview-10","page_id":"/registry/overview","tags":[],"type":"text","url":"/registry/overview#discover-and-install","content":"Search discovers candidates; installation records a selected origin and content.\nCommit the manifest and lock together so teammates can restore the intended state.\nSee repository commands for management actions\nand marketplace.json for catalog authoring."},"3061":{"id":"/registry/repository-architecture","page_id":"/registry/repository-architecture","type":"page","content":"Choose a distribution model","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/repository-architecture"},"3062":{"id":"/registry/repository-architecture-0","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Decide between direct sources, catalogs, and self-contained team bundles."},"3063":{"id":"/registry/repository-architecture-1","page_id":"/registry/repository-architecture","type":"heading","tags":[],"url":"/registry/repository-architecture#discovery-and-installation","content":"Discovery and installation"},"3064":{"id":"/registry/repository-architecture-2","page_id":"/registry/repository-architecture","type":"heading","tags":[],"url":"/registry/repository-architecture#team-reproducibility","content":"Team reproducibility"},"3065":{"id":"/registry/repository-architecture-3","page_id":"/registry/repository-architecture","type":"heading","tags":[],"url":"/registry/repository-architecture#trust","content":"Trust"},"3066":{"id":"/registry/repository-architecture-4","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Need"},"3067":{"id":"/registry/repository-architecture-5","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Use"},"3068":{"id":"/registry/repository-architecture-6","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Iterate on one skill locally"},"3069":{"id":"/registry/repository-architecture-7","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A local dependency, optionally editable"},"3070":{"id":"/registry/repository-architecture-8","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Install a skill from a source repository"},"3071":{"id":"/registry/repository-architecture-9","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A Git origin with a branch or tag"},"3072":{"id":"/registry/repository-architecture-10","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Discover and select skills across a team"},"3073":{"id":"/registry/repository-architecture-11","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A Git marketplace, local catalog, HTTP registry, or ZIP catalog"},"3074":{"id":"/registry/repository-architecture-12","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"Share an exact skill set without original source access"},"3075":{"id":"/registry/repository-architecture-13","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture","content":"A self-contained bundle"},"3076":{"id":"/registry/repository-architecture-14","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#discovery-and-installation","content":"Catalog search returns metadata and an install reference. It does not install a\nskill. Adding a result records its origin and materializes the selected content.\nLocks record the resolved selection so restoration does not silently pick a newer\ncatalog version or Git commit."},"3077":{"id":"/registry/repository-architecture-15","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#discovery-and-installation","content":"A project's manifest defines its repository configuration. Give each catalog a\nunique name and use explicit repository selection where IDs overlap. See\nconfiguration examples."},"3078":{"id":"/registry/repository-architecture-16","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#team-reproducibility","content":"Commit the manifest and lock together. Preserve any local source files and bundled\nartifacts required for restoration. A fresh machine still needs network access for\nuncached remote dependencies; `--offline` cannot download missing content."},"3079":{"id":"/registry/repository-architecture-17","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#team-reproducibility","content":"For an artifact recipients can install without access to private source repositories,\nbuild a bundle. Bundles retain ownership so removing\none package does not remove a skill that another package still requires."},"3080":{"id":"/registry/repository-architecture-18","page_id":"/registry/repository-architecture","tags":[],"type":"text","url":"/registry/repository-architecture#trust","content":"A digest proves that selected content has not changed; it does not establish that\nthe instructions or scripts are safe. Review sources before making them available\nto agents. See the security model."},"3081":{"id":"/registry/sources","page_id":"/registry/sources","type":"page","content":"Configure skill sources","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/sources"},"3082":{"id":"/registry/sources-0","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources","content":"Add skills from Git and configure local, Git marketplace, HTTP, and ZIP catalogs."},"3083":{"id":"/registry/sources-1","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#install-directly-from-git","content":"Install directly from Git"},"3084":{"id":"/registry/sources-2","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#migrating-from-tree-urls","content":"Migrating from `/tree/` URLs"},"3085":{"id":"/registry/sources-3","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#configure-a-catalog","content":"Configure a catalog"},"3086":{"id":"/registry/sources-4","page_id":"/registry/sources","type":"heading","tags":[],"url":"/registry/sources#publish-a-catalog","content":"Publish a catalog"},"3087":{"id":"/registry/sources-5","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources","content":"Complete the quickstart first. Commands below use example URLs and\nIDs: replace them with a repository you can access and a skill it actually contains."},"3088":{"id":"/registry/sources-6","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#install-directly-from-git","content":"Use one ref selector for a source. For a skill in a subdirectory, declare the clean\nclone URL and `subdir` in the manifest, then install it:"},"3089":{"id":"/registry/sources-7","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#install-directly-from-git","content":"Use this manifest form as the portable source of truth for subdirectories. It keeps the clone URL,\nbranch, and subdirectory explicit in committed project state.\nFastSkill uses system Git; install Git and ensure it can access the repository before\nadding private sources. Git credentials come from your Git configuration."},"3090":{"id":"/registry/sources-8","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"Manifests written by fastskill 0.9.221 and earlier recorded a GitHub browser link as the\ngit `url`, e.g., `https://github.com/your-org/skills/tree/main/review-notes`. Git cannot\nclone such a URL. Manifest `schema_version = \"2\"` splits it into the three fields shown\nabove, and fastskill performs that split while reading — no manual edit is needed. The\nrewritten form reaches disk the next time a command saves the manifest, e.g.,\n`skill add` or `skill remove` (`project install` reads it and updates only `skills.lock`). A `/tree/` URL in a manifest that\nalready declares `schema_version = \"2\"` is an error, and the message shows the corrected\nTOML."},"3091":{"id":"/registry/sources-9","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"One consequence is worth planning for: a manifest saved by a current fastskill declares\n`schema_version = \"2\"`, and fastskill 0.9.232 and earlier refuse to read it. Upgrade every\nmachine and CI job that shares the project before the first save."},"3092":{"id":"/registry/sources-10","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"The manifest records the requested origin/ref; the lock records the selected commit\nand integrity evidence. `project install --lock` restores that selection even when\na branch advances. `skill update` deliberately refreshes the origin. Repository\nversion/strategy controls do not apply to Git origins."},"3093":{"id":"/registry/sources-11","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#migrating-from-tree-urls","content":"Offline restoration needs the verified source content in the local cache. A lockfile\nalone does not contain the source files. Run an online install first, or distribute\nself-contained bundles."},"3094":{"id":"/registry/sources-12","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"A catalog lets you discover skills and add them by their canonical IDs. Each\nrepository is an entry in `[[tool.fastskill.repositories]]` in `skill-project.toml`.\nLower priority numbers are searched first. Explicit `--repository NAME` selection\navoids ambiguity when several catalogs offer the same ID."},"3095":{"id":"/registry/sources-13","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"`zip_url` is the manifest field for a ZIP catalog's base URL. Direct ZIP dependency\norigins use `origin.type = \"zip-url\"` and `origin.url` instead. These are different\nconfiguration objects."},"3096":{"id":"/registry/sources-14","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"The manifest's repository authentication supports `pat` with a token environment\nvariable. Omit `auth` for public catalogs. Do not put credentials in a committed\nmanifest. This setting does not replace system Git authentication."},"3097":{"id":"/registry/sources-15","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"You can also manage sources through the CLI:"},"3098":{"id":"/registry/sources-16","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#configure-a-catalog","content":"Search results identify the repository, canonical skill ID, version, and install\ncommand. Remote search can fail partially; inspect the exit status and diagnostics\ninstead of treating partial results as a complete catalog response."},"3099":{"id":"/registry/sources-17","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#publish-a-catalog","content":"Git marketplaces and ZIP catalogs describe skills using\nmarketplace.json. HTTP registries expose an\nindex. FastSkill does not provide a CLI publish service;\nhost catalog files and artifacts using your distribution infrastructure."},"3100":{"id":"/registry/sources-18","page_id":"/registry/sources","tags":[],"type":"text","url":"/registry/sources#publish-a-catalog","content":"For sharing an already installed set without access to its original sources, use\nbundles. For all repository actions and flags, see\nrepository reference."},"3101":{"id":"/registry/web-ui","page_id":"/registry/web-ui","type":"page","content":"Local browser console","breadcrumbs":["Docs","Share with teams","Sources and catalogs"],"tags":[],"url":"/registry/web-ui"},"3102":{"id":"/registry/web-ui-0","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui","content":"Inspect installed skills and manage a project through the optional HTTP server."},"3103":{"id":"/registry/web-ui-1","page_id":"/registry/web-ui","type":"heading","tags":[],"url":"/registry/web-ui#write-operations","content":"Write operations"},"3104":{"id":"/registry/web-ui-2","page_id":"/registry/web-ui","type":"heading","tags":[],"url":"/registry/web-ui#troubleshooting","content":"Troubleshooting"},"3105":{"id":"/registry/web-ui-3","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui","content":"Complete the quickstart or open an existing configured project, then run:"},"3106":{"id":"/registry/web-ui-4","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui","content":"Open `http://localhost:8080/`. The console loads project information and the installed\nskills table. Type in the search field to filter the loaded rows; select a skill\nfor its details. Catalog discovery is available through repository commands\nand the registry HTTP endpoints."},"3107":{"id":"/registry/web-ui-5","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#write-operations","content":"The console reads server capabilities before exposing write controls. Start with\nwrite access only when you intend to change installed skills:"},"3108":{"id":"/registry/web-ui-6","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#write-operations","content":"With writes enabled, the console provides an install form, eligible skill updates,\nremoval controls, and an update-all action. Reindexing additionally requires an\nembedding provider. A successful operation refreshes the displayed state; inspect\nerrors when a source cannot resolve or ownership prevents removal."},"3109":{"id":"/registry/web-ui-7","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#write-operations","content":"The server has no built-in authentication. Use it locally, or put authentication\nand network restrictions in front of it when exposing it to other users. Read-only\naccess still reveals skill content. See the security model."},"3110":{"id":"/registry/web-ui-8","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If the table does not load, check that the server is running in the correct project\nand inspect `fastskill cli doctor` output."},"3111":{"id":"/registry/web-ui-9","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If write controls are absent, verify that you started with `--enable-write`."},"3112":{"id":"/registry/web-ui-10","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If reindexing is unavailable, configure the optional embedding provider."},"3113":{"id":"/registry/web-ui-11","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"If a skill cannot be removed, inspect its owners and reconciliation state."},"3114":{"id":"/registry/web-ui-12","page_id":"/registry/web-ui","tags":[],"type":"text","url":"/registry/web-ui#troubleshooting","content":"For the HTTP contract, health checks, and server flags, see\nserver reference."},"3115":{"id":"/security/best-practices","page_id":"/security/best-practices","type":"page","content":"Security Best Practices","breadcrumbs":["Docs","Reference","Security"],"tags":[],"url":"/security/best-practices"},"3116":{"id":"/security/best-practices-0","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices","content":"Operational guidance for running FastSkill safely: read-only serve, auth proxies, PAT env-var indirection, and locked CI installs."},"3117":{"id":"/security/best-practices-1","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#overview","content":"Overview"},"3118":{"id":"/security/best-practices-2","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#running-fastskill-server-serve","content":"Running `fastskill server serve`"},"3119":{"id":"/security/best-practices-3","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#repository-credentials","content":"Repository credentials"},"3120":{"id":"/security/best-practices-4","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#reproducible-installs-in-ci","content":"Reproducible installs in CI"},"3121":{"id":"/security/best-practices-5","page_id":"/security/best-practices","type":"heading","tags":[],"url":"/security/best-practices#verify-configuration","content":"Verify configuration"},"3122":{"id":"/security/best-practices-6","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#overview","content":"These are the concrete, source-backed practices for operating FastSkill safely. They follow directly\nfrom the security model: FastSkill is a package manager with no in-app auth, so\nprotection comes from *how you run and expose it*."},"3123":{"id":"/security/best-practices-7","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Expose read-only.** For a browsable UI or REST view over your skills, run `fastskill server serve`\n**without** `--enable-write`. Every mutation endpoint returns HTTP 403, so an exposed instance\ncannot install, update, delete, reindex, or refresh anything."},"3124":{"id":"/security/best-practices-8","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Only pass `--enable-write` when you mean it.** Enable writes for local skill management from the\nbrowser/API — ideally on `localhost` only. Do not combine `--enable-write` with an open,\nunfronted port."},"3125":{"id":"/security/best-practices-9","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Front an exposed port with an authenticating proxy.** `server serve` enforces no authentication of its\nown and is *not* a security boundary. If the port is reachable off your machine, put a reverse\nproxy or sidecar in front that owns authentication, and make sure the app port is not directly\nreachable. Binding a non-loopback address is fine and expected behind such a proxy."},"3126":{"id":"/security/best-practices-10","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#running-fastskill-server-serve","content":"**Use the health probes for orchestration**, not for security: `GET /healthz` (liveness) and\n`GET /readyz` (readiness)."},"3127":{"id":"/security/best-practices-11","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Use PAT env-var indirection.** Reference tokens by environment variable in\n`skill-project.toml`, never inline:"},"3128":{"id":"/security/best-practices-12","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Never commit plaintext tokens.** Keep them in your shell profile, CI secret store, or a secrets\nmanager. Commit `skill-project.toml`; keep the token value out of the repo."},"3129":{"id":"/security/best-practices-13","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#repository-credentials","content":"**Set `OPENAI_API_KEY` via secrets** where semantic search / reindex is used. If it is unset,\nembedding-based features silently skip rather than failing — but do not paste the key into config\nor version control."},"3130":{"id":"/security/best-practices-14","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#reproducible-installs-in-ci","content":"**Commit `skill-project.toml` and `skills.lock`.**"},"3131":{"id":"/security/best-practices-15","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#reproducible-installs-in-ci","content":"**Use `fastskill project install --lock` in CI** so builds install the exact locked versions rather than\nre-resolving. This makes installs reproducible and verifiable across environments. See the\ncheatsheet for the full manifest workflow."},"3132":{"id":"/security/best-practices-16","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#verify-configuration","content":"Run `fastskill cli doctor` (add `--json` for machine output) to confirm the skills directory,\n`skill-project.toml`, embedding configuration, `OPENAI_API_KEY`, and auth token are set up as\nexpected before deploying. See Debugging."},"3133":{"id":"/security/best-practices-17","page_id":"/security/best-practices","tags":[],"type":"text","url":"/security/best-practices#verify-configuration","content":"FastSkill deliberately has **no audit-logging feature** and **no in-app auth** — do not rely on it\nfor either. Request logging, authentication, and network policy belong to the proxy and platform\nthat front an exposed instance."},"3134":{"id":"/security/model","page_id":"/security/model","type":"page","content":"Security Model","breadcrumbs":["Docs","Reference","Security"],"tags":[],"url":"/security/model"},"3135":{"id":"/security/model-0","page_id":"/security/model","tags":[],"type":"text","url":"/security/model","content":"How FastSkill treats trust boundaries: read-only-by-default serve, no in-app auth, env-var token indirection, and reproducible locked installs."},"3136":{"id":"/security/model-1","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#overview","content":"Overview"},"3137":{"id":"/security/model-2","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"`fastskill server serve` is read-only by default"},"3138":{"id":"/security/model-3","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#server-serve-is-not-a-security-boundary","content":"`server serve` is not a security boundary"},"3139":{"id":"/security/model-4","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#repository-credentials-env-var-indirection","content":"Repository credentials: env-var indirection"},"3140":{"id":"/security/model-5","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#reproducible-verifiable-installs","content":"Reproducible, verifiable installs"},"3141":{"id":"/security/model-6","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#what-fastskill-does-not-provide","content":"What FastSkill does not provide"},"3142":{"id":"/security/model-7","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#overview","content":"FastSkill is a skill **package manager**, not a runtime. It installs, indexes, and serves skill\ndirectories; it does **not** execute skills, so there is no sandbox, no resource governor, and no\nper-request audit log to speak of. Its security model is about two things: what the `fastskill server serve`\nHTTP surface lets a caller do, and how repository credentials are handled."},"3143":{"id":"/security/model-8","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"Per ADR-0003, `fastskill server serve` mounts **only read endpoints** unless you start it with\n`--enable-write`. Reads (list/get skills, `POST /api/v1/search`, `POST /api/v1/resolve`,\n`GET /api/v1/status`, registry browse, manifest reads, the dashboard) are always available."},"3144":{"id":"/security/model-9","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"Every state-changing endpoint — install, update, delete, reindex, registry refresh, manifest\nwrites — returns **HTTP 403** when writes are disabled:"},"3145":{"id":"/security/model-10","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"\"Anything that is not a pure read is gated\" — reindex and registry refresh are included because they\nare side-effecting (disk, network, embedding-API cost), not just because they are destructive. This\nis one switch: `--enable-write` enables all mutations at once. See the\n`server serve` reference."},"3146":{"id":"/security/model-11","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"FastSkill enforces **no authentication of its own**. There is no token endpoint, and API routes\nrequire no `Authorization` or `x-api-key` header. It handles no identity and no per-user\nauthorization by design."},"3147":{"id":"/security/model-12","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"**Run it local-first.** The default bind is `localhost` — a single operator viewing their own\nskills on their own machine."},"3148":{"id":"/security/model-13","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"**Front it with an authenticating proxy if you expose it.** If the port is reachable on a shared\nor untrusted network, put a reverse proxy or sidecar in front that owns request authentication,\nand ensure the app port is not directly reachable. FastSkill will not police the bind address for\nyou, and binding a non-loopback address is the normal, expected configuration behind such a proxy."},"3149":{"id":"/security/model-14","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"Combined with the read-only default, an exposed instance started **without** `--enable-write` cannot\nbe used to mutate state even before the proxy is considered. Reaching a destructive endpoint\nunauthenticated requires the operator to have *both* enabled writes *and* exposed the port with no\nfronting proxy — a deliberate double opt-out."},"3150":{"id":"/security/model-15","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"A read-only exposed instance still **discloses skill data** to anyone who reaches it. That is the\noperator's call when they open the port; it is a disclosure consideration, not a mutation risk."},"3151":{"id":"/security/model-16","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"HTTP registries can authenticate with a **PAT referenced by environment variable**.\nGit sources use system Git credentials. Tokens are not written into the manifest:"},"3152":{"id":"/security/model-17","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"FastSkill reads the token from `TEAM_REGISTRY_TOKEN` at runtime. Commit `skill-project.toml`; keep\nthe token in your shell profile, CI secrets, or a secrets manager. Never commit a plaintext token."},"3153":{"id":"/security/model-18","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#reproducible-verifiable-installs","content":"`fastskill project install` resolves the manifest and writes a lockfile (`skills.lock`, or\n`global-skills.lock` with `--global`). `fastskill project install --lock` installs the **exact** versions\nrecorded in the lock, giving reproducible and verifiable installs for CI and locked environments.\nCommit both `skill-project.toml` and `skills.lock`."},"3154":{"id":"/security/model-19","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"To set expectations honestly, FastSkill has **no**:"},"3155":{"id":"/security/model-20","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"sandboxed execution environment (it does not run skills),"},"3156":{"id":"/security/model-21","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"resource limits or execution monitoring,"},"3157":{"id":"/security/model-22","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"built-in request audit log,"},"3158":{"id":"/security/model-23","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"in-app authentication, identity, or per-user authorization."},"3159":{"id":"/security/model-24","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"For deployed exposure, those responsibilities live in the surrounding infrastructure (proxy,\nnetwork policy, secrets management)."},"3160":{"id":"/skill-management/manifest-system","page_id":"/skill-management/manifest-system","type":"page","content":"Manifests, locks, and scope","breadcrumbs":["Docs","Manage skills","Skills and projects"],"tags":[],"url":"/skill-management/manifest-system"},"3161":{"id":"/skill-management/manifest-system-0","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system","content":"Declare sources and understand what FastSkill restores for a project or user."},"3162":{"id":"/skill-management/manifest-system-1","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#project-configuration","content":"Project configuration"},"3163":{"id":"/skill-management/manifest-system-2","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#dependency-origins","content":"Dependency origins"},"3164":{"id":"/skill-management/manifest-system-3","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#groups","content":"Groups"},"3165":{"id":"/skill-management/manifest-system-4","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"Locked restoration and updates"},"3166":{"id":"/skill-management/manifest-system-5","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#project-and-global-scope","content":"Project and global scope"},"3167":{"id":"/skill-management/manifest-system-6","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#author-configuration","content":"Author configuration"},"3168":{"id":"/skill-management/manifest-system-7","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-configuration","content":"A project's `skill-project.toml` defines the installation directory and desired\nskills. FastSkill finds it by walking up from your working directory. Paths in the\nmanifest are relative to the manifest directory, not the calling shell's directory."},"3169":{"id":"/skill-management/manifest-system-8","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-configuration","content":"Use the quickstart to create this local source. `skill add` writes a\ndependency and installs it. Editing the manifest manually requires a subsequent\n`project install` to apply it."},"3170":{"id":"/skill-management/manifest-system-9","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#dependency-origins","content":"These are examples of source declarations, not publicly available packages:"},"3171":{"id":"/skill-management/manifest-system-10","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#dependency-origins","content":"A repository origin refers to a configured catalog. See source configuration.\nUse `skill add` to produce declarations from actual sources rather than guessing IDs.\nEditable local dependencies link to their source and are intentionally mutable;\nother local dependencies are copied and checked against locked integrity evidence."},"3172":{"id":"/skill-management/manifest-system-11","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#groups","content":"Groups select optional roots. Required transitive dependencies remain part of the\nselected roots' installation closure."},"3173":{"id":"/skill-management/manifest-system-12","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#groups","content":"Use one group selection mode per invocation. A group-limited lock may not cover\nroots excluded from that resolution; `--lock` cannot resolve missing coverage."},"3174":{"id":"/skill-management/manifest-system-13","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"`skills.lock` records selected origins, versions, Git commits, content digests,\ndependency edges, groups, covered roots, bundle ownership, and overrides. It is\ngenerated by FastSkill; do not hand-write a partial lockfile."},"3175":{"id":"/skill-management/manifest-system-14","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"Ordinary installation reuses compatible locked selections and resolves roots that\nlack coverage. `--lock` verifies and restores the recorded selection without\nchanging lock bytes. Updates deliberately resolve changes within the declared\nconstraints; exact pins stay pinned unless explicitly changed."},"3176":{"id":"/skill-management/manifest-system-15","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"Commit the manifest and lock together. Local sources and cached bundle artifacts\nmust also be available to recipients. `--offline` prevents network access; it\nrequires all necessary verified inputs locally and does not make remote dependencies\nportable by itself. See bundle distribution."},"3177":{"id":"/skill-management/manifest-system-16","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-and-global-scope","content":"Project operations use the manifest's installation directory. `--skills-dir`\noverrides that destination when supported. Global operations use the user-level\nskill set and `global-skills.lock`; the default directory is\n`~/.config/fastskill/skills` on Unix."},"3178":{"id":"/skill-management/manifest-system-17","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-and-global-scope","content":"A global FastSkill directory is not automatically an agent's discovery directory.\nConfirm the location your agent reads or access global skills through MCP.\nGlobal lock restoration does not require a project manifest."},"3179":{"id":"/skill-management/manifest-system-18","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#author-configuration","content":"Within a skill directory, `skill-project.toml` can also carry author metadata and\nskill dependencies. A standalone skill can begin with only `SKILL.md`; separate\nproject configuration controls where consumers install it. See\nskill validation and project init."},"3180":{"id":"/skill-management/reconciliation","page_id":"/skill-management/reconciliation","type":"page","content":"Reconcile project skill state","breadcrumbs":["Docs","Manage skills","Skills and projects"],"tags":[],"url":"/skill-management/reconciliation"},"3181":{"id":"/skill-management/reconciliation-0","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation","content":"Compare declared, locked, and installed skill state and enforce it in CI."},"3182":{"id":"/skill-management/reconciliation-1","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"Reconcile project skill state"},"3183":{"id":"/skill-management/reconciliation-2","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#human-readable-checks","content":"Human-readable checks"},"3184":{"id":"/skill-management/reconciliation-3","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#reconciliation-values","content":"Reconciliation values"},"3185":{"id":"/skill-management/reconciliation-4","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#json-schema","content":"JSON schema"},"3186":{"id":"/skill-management/reconciliation-5","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#group-scoped-checks","content":"Group-scoped checks"},"3187":{"id":"/skill-management/reconciliation-6","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#ci-example","content":"CI example"},"3188":{"id":"/skill-management/reconciliation-7","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#repair-workflow","content":"Repair workflow"},"3189":{"id":"/skill-management/reconciliation-8","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#global-state","content":"Global state"},"3190":{"id":"/skill-management/reconciliation-9","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"fastskill compares three sources of truth:"},"3191":{"id":"/skill-management/reconciliation-10","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"`skill-project.toml` records direct intent, groups, and source constraints."},"3192":{"id":"/skill-management/reconciliation-11","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"`skills.lock` records the resolved closure, versions, origins, ownership, and integrity data."},"3193":{"id":"/skill-management/reconciliation-12","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"The skills directory contains the installed files an agent reads."},"3194":{"id":"/skill-management/reconciliation-13","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"`fastskill skill list` joins those sources into one row per skill. `fastskill skill list --check`\nuses the same rows and returns nonzero when selected managed state needs reconciliation."},"3195":{"id":"/skill-management/reconciliation-14","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#human-readable-checks","content":"The detailed source path is the recorded origin path or URL, not the installed destination.\nEditable installs use the human-readable `editable` flag."},"3196":{"id":"/skill-management/reconciliation-15","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"The `reconciliation` field is the canonical machine-readable status. Values can include:"},"3197":{"id":"/skill-management/reconciliation-16","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Value"},"3198":{"id":"/skill-management/reconciliation-17","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Meaning"},"3199":{"id":"/skill-management/reconciliation-18","page_id":"/skill-management/reconc