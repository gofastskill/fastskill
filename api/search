l":"/cli-reference/eval-command#overview","content":"Overview"},"479":{"id":"/cli-reference/eval-command-2","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#usage","content":"Usage"},"480":{"id":"/cli-reference/eval-command-3","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-validate","content":"eval validate"},"481":{"id":"/cli-reference/eval-command-4","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-run","content":"eval run"},"482":{"id":"/cli-reference/eval-command-5","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#environment-isolation","content":"Environment isolation"},"483":{"id":"/cli-reference/eval-command-6","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-judge","content":"eval judge"},"484":{"id":"/cli-reference/eval-command-7","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-report","content":"eval report"},"485":{"id":"/cli-reference/eval-command-8","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-score","content":"eval score"},"486":{"id":"/cli-reference/eval-command-9","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-scorecard","content":"eval scorecard"},"487":{"id":"/cli-reference/eval-command-10","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-metrics-file","content":"The metrics file"},"488":{"id":"/cli-reference/eval-command-11","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Identity: what the numbers are about"},"489":{"id":"/cli-reference/eval-command-12","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-json-document","content":"The JSON document"},"490":{"id":"/cli-reference/eval-command-13","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-html-report","content":"The HTML report"},"491":{"id":"/cli-reference/eval-command-14","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"What is excluded, and why"},"492":{"id":"/cli-reference/eval-command-15","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#see-also","content":"See also"},"493":{"id":"/cli-reference/eval-command-16","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`fastskill eval` runs skill quality checks using prompts and rubrics under `[tool.fastskill.eval]` in `skill-project.toml`. Subcommands are `validate`, `run`, `judge`, `report`, `score`, and `scorecard`."},"494":{"id":"/cli-reference/eval-command-17","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`eval run` requires an agent on `PATH` for the chosen `--agent` key. Known keys are `aikit`, `claude`, `codex`, `cursor`, `gemini`, and `pi`. A key is accepted only when its CLI is detected on the current machine, so a typo and an uninstalled agent both error with `RUNTIME_UNKNOWN_ID`, which lists what was detected. Use `eval validate --agent <key>` or `--all` to verify availability."},"495":{"id":"/cli-reference/eval-command-18","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Checks eval configuration and files (optional agent presence check)."},"496":{"id":"/cli-reference/eval-command-19","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Option"},"497":{"id":"/cli-reference/eval-command-20","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Description"},"498":{"id":"/cli-reference/eval-command-21","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--agent <AGENT>`"},"499":{"id":"/cli-reference/eval-command-22","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify the given agent(s) are available; repeatable. Mutually exclusive with `--all`"},"500":{"id":"/cli-reference/eval-command-23","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--all`"},"501":{"id":"/cli-reference/eval-command-24","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify availability of every installed agent. Mutually exclusive with `--agent`"},"502":{"id":"/cli-reference/eval-command-25","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--model <MODEL>`"},"503":{"id":"/cli-reference/eval-command-26","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"The model `eval run` will target; a judge declaring the same one is reported as self-preference"},"504":{"id":"/cli-reference/eval-command-27","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--format <FORMAT>`"},"505":{"id":"/cli-reference/eval-command-28","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`table` or `json` only (eval does not support `grid`/`xml`)"},"506":{"id":"/cli-reference/eval-command-29","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--json`"},"507":{"id":"/cli-reference/eval-command-30","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Shorthand for `--format json`"},"508":{"id":"/cli-reference/eval-command-31","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Every `[[judge]]` in the checks file is validated from file content alone, so validate gives the same answer on a laptop and in CI. Errors: no resolvable `model`; neither or both of `prompt` / `prompt_file` (likewise for the system and retry pairs); an unknown `{{variable}}`; a `cases` id matching no case; duplicate criterion names; `scale` below 2; `min_score` outside `[0, 1]`; a prompt that never renders `{{output_contract}}`; any unknown key. Warnings: a prompt without `{{rubric}}`, and a judge sharing `--model`. Endpoint reachability and API keys are not checked here — judging checks those before its first request."},"509":{"id":"/cli-reference/eval-command-32","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"With `--agent` or `--all`, both outputs report each selected agent:\nthe table prints one `agent '<key>': available|unavailable` line per agent, and the JSON document carries an `agents` object keyed by agent id (`{\"agents\": {\"claude\": true}}`). An unavailable agent is an error unless `fail_on_missing_agent = false` is set in the eval config."},"510":{"id":"/cli-reference/eval-command-33","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Runs eval cases against an agent; writes artifacts under `--output-dir`."},"511":{"id":"/cli-reference/eval-command-34","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`)."},"512":{"id":"/cli-reference/eval-command-35","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Option"},"513":{"id":"/cli-reference/eval-command-36","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Description"},"514":{"id":"/cli-reference/eval-command-37","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <AGENT>`"},"515":{"id":"/cli-reference/eval-command-38","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Agent key(s) to run; repeatable. Required unless `--all` is given"},"516":{"id":"/cli-reference/eval-command-39","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--all`"},"517":{"id":"/cli-reference/eval-command-40","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run against all installed agents. Mutually exclusive with `--agent`"},"518":{"id":"/cli-reference/eval-command-41","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--output-dir <DIR>`"},"519":{"id":"/cli-reference/eval-command-42","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"**Required.** Directory for run output"},"520":{"id":"/cli-reference/eval-command-43","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--model <MODEL>`"},"521":{"id":"/cli-reference/eval-command-44","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Optional model override passed to the agent"},"522":{"id":"/cli-reference/eval-command-45","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--case <ID>`"},"523":{"id":"/cli-reference/eval-command-46","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run only this case id"},"524":{"id":"/cli-reference/eval-command-47","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--tag <TAG>`"},"525":{"id":"/cli-reference/eval-command-48","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run only cases with this tag"},"526":{"id":"/cli-reference/eval-command-49","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--format <FORMAT>`"},"527":{"id":"/cli-reference/eval-command-50","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`table` or `json` only"},"528":{"id":"/cli-reference/eval-command-51","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--json`"},"529":{"id":"/cli-reference/eval-command-52","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Shorthand for `--format json`"},"530":{"id":"/cli-reference/eval-command-53","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--no-fail`"},"531":{"id":"/cli-reference/eval-command-54","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Exit zero even when the suite fails"},"532":{"id":"/cli-reference/eval-command-55","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--trials <N>`"},"533":{"id":"/cli-reference/eval-command-56","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override `trials_per_case` from the config for this run (1–1000)"},"534":{"id":"/cli-reference/eval-command-57","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--threshold <F>`"},"535":{"id":"/cli-reference/eval-command-58","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override `pass_threshold` from the config for this run (0.0–1.0)"},"536":{"id":"/cli-reference/eval-command-59","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--ci`"},"537":{"id":"/cli-reference/eval-command-60","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"CI mode: the suite passes when its overall pass rate meets the threshold, instead of requiring zero failed cases"},"538":{"id":"/cli-reference/eval-command-61","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--no-isolation`"},"539":{"id":"/cli-reference/eval-command-62","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run in the project root against the ambient agent environment (disables per-case isolation)"},"540":{"id":"/cli-reference/eval-command-63","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--judge`"},"541":{"id":"/cli-reference/eval-command-64","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Judge the run after scoring it, with the judges the checks file declares. Same function as `eval judge`"},"542":{"id":"/cli-reference/eval-command-65","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--judge-model <MODEL>`"},"543":{"id":"/cli-reference/eval-command-66","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override every judge's model, and record the override"},"544":{"id":"/cli-reference/eval-command-67","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"By default every case runs **isolated**: the skill next to `skill-project.toml` is deployed alone into a per-case scratch workspace, and the agent's user-level skill discovery is suppressed where the backend supports it (claude, codex, pi). Scores then measure the skill under test rather than whatever else is installed on your machine. Isolation needs a `SKILL.md` beside `skill-project.toml` and a `[metadata].id` naming the skill — missing either is a `EVAL_ISOLATION_NO_SKILL` error, not a silent fallback."},"545":{"id":"/cli-reference/eval-command-68","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"The summary reports what each run actually got (`isolation:` line in table output, `isolation` object in `summary.json`), and a failed case's scratch workspace is kept under `<run-dir>/workspaces/` for debugging. Pass `--no-isolation` to restore the old inherit-everything behaviour."},"546":{"id":"/cli-reference/eval-command-69","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"Scores recorded before isolation existed were measured against the ambient environment — expect trigger rates to re-baseline on the first isolated run."},"547":{"id":"/cli-reference/eval-command-70","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Scores a completed run with the LLM judges its checks file declares. `eval run --judge` calls the same function right after the run's own scoring — there is one judging implementation, so a run judged either way is judged identically."},"548":{"id":"/cli-reference/eval-command-71","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Option"},"549":{"id":"/cli-reference/eval-command-72","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Description"},"550":{"id":"/cli-reference/eval-command-73","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--run-dir <DIR>`"},"551":{"id":"/cli-reference/eval-command-74","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"**Required.** The per-agent run directory (`<output-dir>/<timestamp>/<agent>`)"},"552":{"id":"/cli-reference/eval-command-75","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--checks <FILE>`"},"553":{"id":"/cli-reference/eval-command-76","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Read `[[judge]]` from this file instead of the one the run recorded"},"554":{"id":"/cli-reference/eval-command-77","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--judge-model <MODEL>`"},"555":{"id":"/cli-reference/eval-command-78","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Override every judge's model, and record the override"},"556":{"id":"/cli-reference/eval-command-79","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--judge-parallel <N>`"},"557":{"id":"/cli-reference/eval-command-80","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Concurrent judge requests (1–1000); defaults to the run's recorded `parallel`"},"558":{"id":"/cli-reference/eval-command-81","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--rejudge`"},"559":{"id":"/cli-reference/eval-command-82","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Judge again even when the same request already has a judgment"},"560":{"id":"/cli-reference/eval-command-83","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--ci`"},"561":{"id":"/cli-reference/eval-command-84","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"CI mode: the suite passes when its pass rate meets the run's threshold"},"562":{"id":"/cli-reference/eval-command-85","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--format <FORMAT>`"},"563":{"id":"/cli-reference/eval-command-86","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`table` or `json` only"},"564":{"id":"/cli-reference/eval-command-87","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--json`"},"565":{"id":"/cli-reference/eval-command-88","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Shorthand for `--format json`"},"566":{"id":"/cli-reference/eval-command-89","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--no-fail`"},"567":{"id":"/cli-reference/eval-command-90","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Exit zero on suite failure. Does **not** suppress a judge error"},"568":{"id":"/cli-reference/eval-command-91","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"A judge is one native chat completion per trial — no agent, no tools, nothing injected that the judge's author did not write. Each exchange is recorded in full in `trial-N/judgments.json`, and the engine, never the model, computes every score from the reply."},"569":{"id":"/cli-reference/eval-command-92","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Rewrites are additive: `result.json`, `aggregated.json` and `summary.json` keep every field they had, and a reader that predates the judge tier sees exactly what it saw before. Judging the same run twice asks nothing — a trial whose latest judgment carries the same request identity is skipped unless `--rejudge`."},"570":{"id":"/cli-reference/eval-command-93","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"A trial that errored is never judged: there is no answer to score, and it is reported as skipped rather than as a zero. A judge that could not produce a judgment exits the command non-zero even under `--no-fail`, because a missing measurement must not be reported as a score."},"571":{"id":"/cli-reference/eval-command-94","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Summarizes a completed run directory."},"572":{"id":"/cli-reference/eval-command-95","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Option"},"573":{"id":"/cli-reference/eval-command-96","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Description"},"574":{"id":"/cli-reference/eval-command-97","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--run-dir <DIR>`"},"575":{"id":"/cli-reference/eval-command-98","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"**Required.** The per-agent run directory — `<output-dir>/<timestamp>/<agent>`, the one that holds `summary.json`"},"576":{"id":"/cli-reference/eval-command-99","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--format <FORMAT>`"},"577":{"id":"/cli-reference/eval-command-100","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`table` or `json` only"},"578":{"id":"/cli-reference/eval-command-101","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--json`"},"579":{"id":"/cli-reference/eval-command-102","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Shorthand for `--format json`"},"580":{"id":"/cli-reference/eval-command-103","page_id":"/cli-reference/eval-co