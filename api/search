:"/cli-reference/init-command-55","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#set-all-fields-non-interactively","content":"Set all fields via command-line options:"},"714":{"id":"/cli-reference/init-command-56","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#force-reinitialization","content":"Overwrite existing `skill-project.toml`:"},"715":{"id":"/cli-reference/init-command-57","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#force-reinitialization","content":"Using `--force` will overwrite your existing `skill-project.toml` file. Make sure to backup if you need to preserve any custom configurations."},"716":{"id":"/cli-reference/init-command-58","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#behavior","content":"The `project init` command:"},"717":{"id":"/cli-reference/init-command-59","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#behavior","content":"**Detects Context**: Determines if you're in a skill directory (with SKILL.md) or a project directory"},"718":{"id":"/cli-reference/init-command-60","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#behavior","content":"**Extracts Metadata**: If SKILL.md exists, extracts version, description, and author from YAML frontmatter"},"719":{"id":"/cli-reference/init-command-61","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#behavior","content":"**Prioritizes Inputs**: Uses values in this priority order:"},"720":{"id":"/cli-reference/init-command-62","page_id":"/cli-reference/init-command","tags":[],"type":"text","url":"/cli-reference/init-command#behavior","content":"CLI arguments (highest priority)"},"721":{"id":"/cli-reference/init-command-63","page_id":"/cli-referen