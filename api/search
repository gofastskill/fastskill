riority over SKILL.md frontmatter."},"2974":{"id":"/registry/marketplace-json-127","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"When generating `marketplace.json`, all metadata fields follow this priority order:"},"2975":{"id":"/registry/marketplace-json-128","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**skill-project.toml** `[metadata]` section (highest priority)"},"2976":{"id":"/registry/marketplace-json-129","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Fields: `id` (required, no slashes), `version` (required), `description`, `author`, `tags`, `capabilities`, `download_url`"},"2977":{"id":"/registry/marketplace-json-130","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"All fields from skill-project.toml take precedence over SKILL.md"},"2978":{"id":"/registry/marketplace-json-131","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"The `id` field is required and must not contain slashes or scope information"},"2979":{"id":"/registry/marketplace-json-132","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"**SKILL.md** frontmatter (fallback)"},"2980":{"id":"/registry/marketplace-json-133","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"Used for: `name` (display only), `description`, `author`, `tags`, `capabilities`"},"2981":{"id":"/registry/marketplace-json-134","page_id":"/registry/marketplace-json","tags":[],"type":"text","url":"/registry/marketplace-json#metadata-priority","content":"`name` in SKILL.md is for display pu