command-54","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#preview-and-check","content":"Both preview modes resolve and validate the same candidates as an update, without changing files,\nthe manifest, lockfile, timestamps, repository indexes, or the vector index."},"1840":{"id":"/cli-reference/update-command-55","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#preview-and-check","content":"`--check` and `--dry-run` report the same validated target information; `--check` is the concise\ninspection form and `--dry-run` is the explicit lifecycle preview form."},"1841":{"id":"/cli-reference/update-command-56","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#apply-an-update","content":"The exact change labels can include `origin changed`, `resolved content changed`, `groups changed`,\nand `dependency ownership changed`. Ownership changes are calculated per selected root, so an\nunrelated root is not reported as updated when another root's closure changes."},"1842":{"id":"/cli-reference/update-command-57","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#version-controls","content":"An exact target can be a deliberate downgrade. `patch` stays within the current major/minor,\n`minor` stays within the current major, and `latest`/`major` use the recorded constraint. An exact\npin is never widened implicitly."},"1843":{"id":"/cli-reference/update-command-58","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#global-updates","content":"Global JSON uses the same lifecycle keys as project JSON: `scope`, `outcome`, `dry_run`, `targets`,\n`diagnostics`, `resolution`, and `indexing`. A missing global lock returns an unchanged document\nwith explicit skipped-indexing diagnostics rather than `null` lifecycle fields."},"1844":{"id":"/cli-reference/update-command-59","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#failure-and-recovery","content":"Before mutation, fastskill verifies selected managed content and refuses to replace local edits.\nEach affected closure is staged and validated. A failed application restores its prior files and\nstate, reports the failed target, and exits nonzero."},"1845":{"id":"/cli-reference/update-command-60","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#see-also","content":"Project install."},"1846":{"id":"/cli-reference/update-command-61","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#see-also","content":"Skill and project commands."},"1847":{"id":"/cli-reference/update-command-62","page_id":"/cli-reference/update-command","tags":[],"type":"text","url":"/cli-reference/update-command#see-also","content":"Reconciliation."},"1848":{"id":"/configuration/init-command","page_id":"/configuration/init-command","type":"page","content":"Init Command","breadcrumbs":["Docs","Manage skills","Project configuration"],"tags":[],"url":"/configuration/init-command"},"1849":{"id":"/configuration/init-command-0","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command","content":"Create skill-project.toml for skill authors and project configuration."},"1850":{"id":"/configuration/init-command-1","page_id":"/configuration/init-command","type":"heading","tags":[],"url":"/configuration/init-command#overview","content":"Overview"},"1851":{"id":"/configuration/init-command-2","page_id":"/configuration/init-command","type":"heading","tags":[],"url":"/configuration/init-command#what-it-does","content":"What it does"},"1852":{"id":"/configuration/init-command-3","page_id":"/configuration/init-command","type":"heading","tags":[],"url":"/configuration/init-command#usage","