-4","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Piece"},"389":{"id":"/welcome-5","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Purpose"},"390":{"id":"/welcome-6","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Skill"},"391":{"id":"/welcome-7","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Instructions and resources for a task"},"392":{"id":"/welcome-8","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"`skill-project.toml`"},"393":{"id":"/welcome-9","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Desired dependencies, sources, groups, and installation directory"},"394":{"id":"/welcome-10","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"`skills.lock`"},"395":{"id":"/welcome-11","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Selected versions, revisions, integrity evidence, and ownership"},"396":{"id":"/welcome-12","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Installed directory"},"397":{"id":"/welcome-13","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Files the agent can discover and read"},"398":{"id":"/welcome-14","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"Bundle"},"399":{"id":"/welcome-15","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#the-pieces","content":"A versioned ZIP containing a team skill set and its dependency closure"},"400":{"id":"/welcome-16","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill add` declares and installs a skill from a source."},"401":{"id":"/welcome-17","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install` restores compatible locked selections and resolves missing coverage."},"402":{"id":"/welcome-18","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install --lock` restores the locked selection without updating the lock."},"403":{"id":"/welcome-19","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill update` deliberately resolves changes allowed by the recorded constraints."},"404":{"id":"/welcome-20","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill remove` removes a direct owner; shared requirements can keep a skill installed."},"405":{"id":"/welcome-21","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill list --check` verifies the desired, locked, and installed state."},"406":{"id":"/welcome-22","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"Start with your first skill. Continue with\nmanifests and scope,\nteam bundles, or agent access."},"407":{"id":"/cli-reference/bundle-command","page_id":"/cli-reference/bundle-command","type":"page","content":"Bundle commands","breadcrumbs":["Docs","Share with teams"],"tags":[],"url":"/cli-reference/bundle-command"},"408":{"id":"/cli-reference/bundle-command-0","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command","content":"Build, install, update, restore, and customize self-contained team skill bundles."},"409":{"id":"/cli-reference/bundle-command-1","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#bundle-commands","content":"`bundle` commands"},"410":{"id":"/cli-reference/bundle-command-2","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#build-a-bundle","content":"Build a bundle"},"411":{"id":"/cli-reference/bundle-command-3","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#install-and-inspect","content":"Install and inspect"},"412":{"id":"/cli-reference/bundle-command-4","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#update-a-bundle","content":"Update a bundle"},"413":{"id":"/cli-reference/bundle-command-5","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove a bundle"},"414":{"id":"/cli-reference/bundle-command-6","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#personal-overrides","content":"Personal overrides"},"415":{"id":"/cli-reference/bundle-command-7","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#bundle-commands","content":"Bundles turn a selected team setup into one versioned ZIP. The artifact contains the selected\nskills, their installed dependency closure, resource files, and content digests. A recipient can\ninstall it without access to the original repositories."},"416":{"id":"/cli-reference/bundle-command-8","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Complete the quickstart, then add this declaration to that project's\nexisting `skill-project.toml`. Keep its `[dependencies]` and `[tool.fastskill]` sections."},"417":{"id":"/cli-reference/bundle-command-9","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Every bundle member must also appear in `[dependencies]`. The installed member version must\nsatisfy that declaration. FastSkill stops before writing an artifact when a declared member is\nmissing, has invalid frontmatter, or has a different version."},"418":{"id":"/cli-reference/bundle-command-10","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Build the release:"},"419":{"id":"/cli-reference/bundle-command-11","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"The result is `dist/notes-team-1.0.0.zip`. Its embedded identity, version, membership, and\ndigests are authoritative, so renaming the download does not change the release."},"420":{"id":"/cli-reference/bundle-command-12","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"In a second project initialized with `project init --yes --skills-dir .claude/skills`,\ninstall the artifact with `bundle add`. Replace the local path with the artifact you\nbuilt. The HTTPS URL below is an example for an artifact hosted by your team:"},"421":{"id":"/cli-reference/bundle-command-13","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Installation copies the artifact into `.fastskill/bundles/`, adds its declaration to\n`skill-project.toml`, and records the exact release and members in `skills.lock`."},"422":{"id":"/cli-reference/bundle-command-14","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Commit these files when teammates and CI need the same setup:"},"423":{"id":"/cli-reference/bundle-command-15","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Then restore the exact locked release:"},"424":{"id":"/cli-reference/bundle-command-16","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"`--lock` uses the bundle artifact, version, digest, and membership recorded in `skills.lock`.\nIt does not switch to a different release if the manifest has drifted. `--offline` additionally\nguarantees that restore does not contact a repository or embedding provider."},"425":{"id":"/cli-reference/bundle-command-17","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"Bundle updates are explicit. After building version `1.1.0` of your bundle, preview\nand apply that replacement:"},"426":{"id":"/cli-reference/bundle-command-18","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"FastSkill checks the new artifact, shared ownership, local modifications, and release immutability\nbefore it changes installed members. The preview runs the same validation as apply and reports\npolicy-only changes, such as a member becoming non-overridable, even when its bytes are unchanged."},"427":{"id":"/cli-reference/bundle-command-19","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove the bundle identity and the members that have no other owner:"},"428":{"id":"/cli-reference/bundle-command-20","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Removing a direct declaration detaches that owner. FastSkill retains the installed member while a\nbundle or another dependency root still requires it. An ID that is only a transitive requirement\ncannot be removed directly; the error names the roots that require it. A member is deleted only\nafter its final direct, transitive, bundle, and override owner is gone."},"429":{"id":"/cli-reference/bundle-command-21","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"An edited installed file is not an approved override. Put the customized skill in a separate\ndirectory and declare it explicitly. Every installed bundle that owns the skill must mark the\nmember as `overridable = true`."},"430":{"id":"/cli-reference/bundle-command-22","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"`fastskill project install` and `fastskill project install --lock` restore valid personal overrides after\nbundle members. Updates stop when a new bundle policy no longer permits an existing override."},"431":{"id":"/cli-reference/bundle-command-23","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"Return to the packaged member and clear the override records in one operation:"},"432":{"id":"/cli-reference/bundle-command-24","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"Reset is blocked if retained bundles disagree on the packaged bytes or if the installed member has\nuntracked edits. Removing the last bundle owner of a personal replacement keeps that replacement\nas an individual requirement instead of deleting it. FastSkill validates the replacement's complete\ndependency closure first; bundle removal is blocked if that closure cannot be retained."},"433":{"id":"/cli-reference/bundle-command-25","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#personal-overrides","content":"Every bundle action except `bundle list` changes files. The MCP server hides and refuses these\ntools unless it starts with `fastskill mcp serve --enable-write`."},"434":{"id":"/cli-reference/cache-command","page_id":"/cli-reference/cache-command","type":"page","content":"cache Command","breadcrumbs":["Docs","Reference","CLI commands","Operations"],"tags":[],"url":"/cli-reference/cache-command"},"435":{"id":"/cli-reference/cache-command-0","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command","content":"Inspect and reclaim the on-disk skill content cache with fastskill cache."},"436":{"id":"/cli-reference/cache-command-1","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#cache-command","content":"cache Command"},"437":{"id":"/cli-reference/cache-command-2","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#usage","content":"Usage"},"438":{"id":"/cli-reference/cache-command-3","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#subcommands","content":"Subcommands"},"439":{"id":"/cli-reference/cache-command-4","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#info","content":"info"},"440":{"id":"/cli-reference/cache-command-5","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#clean","content":"clean"},"441":{"id":"/cli-reference/cache-command-6","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#when-to-run-it","content":"When to run it"},"442":{"id":"/cli-reference/cache-command-7","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#see-also","content":"See Also"},"443":{"id":"/cli-reference/cache-command-8","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Inspect and reclaim the on-disk cache that `skill add`, `project install`, and `skill update` use so a skill's\ncontent is fetched once per machine instead of once per project."},"444":{"id":"/cli-reference/cache-command-9","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Every git, registry, or local skill fetch is checked against this cache before touching the\nnetwork again. `fastskill cache` is how to see what has accumulated there and reclaim disk\nspace -- fastskill never evicts cache entries on its own."},"445":{"id":"/cli-reference/cache-command-10","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"Show the cache location plus entry counts and disk usage, broken down by source kind (git,\nregistry, or local)."},"446":{"id":"/cli-reference/cache-command-11","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Example output**:"},"447":{"id":"/cli-reference/cache-command-12","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Options**:"},"448":{"id":"/cli-reference/cache-command-13","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--format <table|json>`: Output format (default: table)"},"449":{"id":"/cli-reference/cache-command-14","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--json`: Shorthand for `--format json` (mutually exclusive with `--format`)"},"450":{"id":"/cli-reference/cache-command-15","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"Remove cached skill content and print how many bytes were reclaimed."},"451":{"id":"/cli-reference/cache-command-16","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Options**:"},"452":{"id":"/cli-reference/cache-command-17","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--source <git|registry|local>`: Limit cleaning to one source kind (default: all)"},"453":{"id":"/cli-reference/cache-command-18","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--json`: Print the result as JSON instead of a summary line"},"454":{"id":"/cli-reference/cache-command-19","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**What it removes**: Only cached skill content -- the record of what a repository currently\nadvertises (what `repo refresh` writes) is left alone, so `repo refresh` output stays valid\nafter a clean. There is nothing to undo: the next `skill add`/`project install`/`skill update` that needs a removed\nentry re-fetches it from its original source."},"455":{"id":"/cli-reference/cache-command-20","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Safe with other fastskill processes running**: `clean` never removes an entry another process\nis mid-write on, and every write elsewhere is atomic. In the worst case, a fetch running at the\nexact moment of a clean simply re-fetches -- it never sees partial or corrupted content."},"456":{"id":"/cli-reference/cache-command-21","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache info`**: Before a `clean`, to see what is actually taking up space, or when disk\nusage seems higher than expected."},"457":{"id":"/cli-reference/cache-command-22","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache clean`**: To reclaim disk space after finishing with skills from a source no longer\nin use, or as routine cleanup on a machine used for many short-lived projects."},"458":{"id":"/cli-reference/cache-command-23","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"`repo` commands -- refresh what a repository advertises\n(`repo refresh`), independent of the content cache `cache` manages"},"459":{"id":"/cli-reference/cache-command-24","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"Install Command -- installs that hit this cache"},"460":{"id":"/cli-reference/discovery-commands","page_id":"/cli-reference/discovery-commands","type":"page","content":"Discover and inspect skills","breadcrumbs":["Docs","Reference","CLI commands","Sources and distribution"],"tags":[],"url":"/cli-reference/discovery-commands"},"461":{"id":"/cli-reference/discovery-commands-0","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Find a catalog result, inspect its origin, and install it explicitly."},"462":{"id":"/cli-reference/discovery-commands-1","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-installed-skills","content":"Search installed skills"},"463":{"id":"/cli-reference/discovery-commands-2","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-a-catalog","content":"Search a catalog"},"464":{"id":"/cli-reference/discovery-commands-3","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Complete the quickstart for local skills, or configure a real\ncatalog. Examples below use placeholder repository and skill IDs."},"465":{"id":"/cli-reference/discovery-commands-4","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-installed-skills","content":"Local keyword search needs no API key. Semantic search is optional and requires an\nindex and embedding provider."},"466":{"id":"/cli-reference/discovery-commands-5","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"Remote search is the default when `--local` is absent. Results identify the\ncanonical skill ID, repository, version, and installation command. Empty catalogs,\nmissing configuration, and partial failures are distinct outcomes; inspect both\nJSON diagnostics and exit status."},"467":{"id":"/cli-reference/discovery-commands-6","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"See search reference for filters and output formats,\nand repository reference for catalog operations."},"468":{"id":"/cli-reference/eval-command","page_id":"/cli-reference/eval-command","type":"page","content":"eval Command","breadcrumbs":["Docs","Reference","CLI commands","Quality"],"tags":[],"url":"/cli-reference/eval-command"},"469":{"id":"/cli-reference/eval-command-0","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command","content":"Validate, run, report, and score skill evaluation suites defined in skill-project.toml."},"470":{"id":"/cli-reference/eval-command-1","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#overview","content":"Overview"},"471":{"id":"/cli-reference/eval-command-2","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#usage","content":"Usage"},"472":{"id":"/cli-reference/eval-command-3","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-validate","content":"eval validate"},"473":{"id":"/cli-reference/eval-command-4","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-run","content":"eval run"},"474":{"id":"/cli-reference/eval-command-5","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#environment-isolation","content":"Environment isolation"},"475":{"id":"/cli-reference/eval-command-6","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-judge","content":"eval judge"},"476":{"id":"/cli-reference/eval-command-7","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-report","content":"eval report"},"477":{"id":"/cli-reference/eval-command-8","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-score","content":"eval score"},"478":{"id":"/cli-reference/eval-command-9","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-scorecard","content":"eval scorecard"},"479":{"id":"/cli-reference/eval-command-10","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-metrics-file","content":"The metrics file"},"480":{"id":"/cli-reference/eval-command-11","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Identity: what the numbers are about"},"481":{"id":"/cli-reference/eval-command-12","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-json-document","content":"The JSON document"},"482":{"id":"/cli-reference/eval-command-13","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-html-report","content":"The HTML report"},"483":{"id":"/cli-reference/eval-command-14","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"What is excluded, and why"},"484":{"id":"/cli-reference/eval-command-15","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#see-also","content":"See also"},"485":{"id":"/cli-reference/eval-command-16","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`fastskill eval` runs skill quality checks using prompts and rubrics under `[tool.fastskill.eval]` in `skill-project.toml`. Subcommands are `validate`, `run`, `judge`, `report`, `score`, and `scorecard`."},"486":{"id":"/cli-reference/eval-command-17","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`eval run` requires an agent on `PATH` for the chosen `--agent` key. Known keys are `aikit`, `claude`, `codex`, `cursor`, `gemini`, and `pi`. A key is accepted only when its CLI is detected on the current machine, so a typo and an uninstalled agent both error with `RUNTIME_UNKNOWN_ID`, which lists what was detected. Use `eval validate --agent <key>` or `--all` to verify availability."},"487":{"id":"/cli-reference/eval-command-18","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Checks eval configuration and files (optional agent presence check)."},"488":{"id":"/cli-reference/eval-command-19","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Option"},"489":{"id":"/cli-reference/eval-command-20","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Description"},"490":{"id":"/cli-reference/eval-command-21","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--agent <AGENT>`"},"491":{"id":"/cli-reference/eval-command-22","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify the given agent(s) are available; repeatable. Mutually exclusive with `--all`"},"492":{"id":"/cli-reference/eval-command-23","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--all`"},"493":{"id":"/cli-reference/eval-command-24","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify availability of every installed agent. Mutually exclusive with `--agent`"},"494":{"id":"/cli-reference/eval-command-25","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--model <MODEL>`"},"495":{"id":"/cli-reference/eval-command-26","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"The model `eval run` will target; a judge declaring the same one is reported as self-preference"},"496":{"id":"/cli-reference/eval-command-27","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--format <FORMAT>`"},"497":{"id":"/cli-reference/eval-command-28","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`table` or `json` only (eval does not support `grid`/`xml`)"},"498":{"id":"/cli-reference/eval-command-29","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--json`"},"499":{"id":"/cli-reference/eval-command-30","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Shorthand for `--format json`"},"500":{"id":"/cli-reference/eval-command-31","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Every `[[judge]]` in the checks file is validated from file content alone, so validate gives the same answer on a laptop and in CI. Errors: no resolvable `model`; neither or both of `prompt` / `prompt_file` (likewise for the system and retry pairs); an unknown `{{variable}}`; a `cases` id matching no case; duplicate criterion names; `scale` below 2; `min_score` outside `[0, 1]`; a prompt that never renders `{{output_contract}}`; any unknown key. Warnings: a prompt without `{{rubric}}`, and a judge sharing `--model`. Endpoint reachability and API keys are not checked here — judging checks those before its first request."},"501":{"id":"/cli-reference/eval-command-32","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"With `--agent` or `--all`, both outputs report each selected agent:\nthe table prints one `agent '<key>': available|unavailable` line per agent, and the JSON document carries an `agents` object keyed by agent id (`{\"agents\": {\"claude\": true}}`). An unavailable agent is an error unless `fail_on_missing_agent = false` is set in the eval config."},"502":{"id":"/cli-reference/eval-command-33","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Runs eval cases against an agent; writes artifacts under `--output-dir`."},"503":{"id":"/cli-reference/eval-command-34","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`)."},"504":{"id":"/cli-reference/eval-command-35","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Option"},"505":{"id":"/cli-reference/eval-command-36","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Description"},"506":{"id":"/cli-reference/eval-command-37","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <AGENT>`"},"507":{"id":"/cli-reference/eval-command-38","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Agent key(s) to run; repeatable. Required unless `--all` is given"},"508":{"id":"/cli-reference/eval-command-39","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--all`"},"509":{"id":"/cli-reference/eval-command-40","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run against all installed agents. Mutually exclusive with `--agent`"},"510":{"id":"/cli-reference/eval-command-41","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--output-dir <DIR>`"},"511":{"id":"/cli-reference/eval-command-42","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"**Required.** Directory for run output"},"512":{"id":"/cli-reference/eval-command-43","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--model <MODEL>`"},"513":{"id":"/cli-reference/eval-command-44","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Optional model override passed to the agent"},"514":{"id":"/cli-reference/eval-command-45","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--case <ID>`"},"515":{"id":"/cli-reference/eval-command-46","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run only this case id"},"516":{"id":"/cli-reference/eval-command-47","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--tag <TAG>`"},"517":{"id":"/cli-reference/eval-command-48","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run only cases with this tag"},"518":{"id":"/cli-reference/eval-command-49","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--format <FORMAT>`"},"519":{"id":"/cli-reference/eval-command-50","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`table` or `json` only"},"520":{"id":"/cli-reference/eval-command-51","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--json`"},"521":{"id":"/cli-reference/eval-command-52","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Shorthand for `--format json`"},"522":{"id":"/cli-reference/eval-command-53","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--no-fail`"},"523":{"id":"/cli-reference/eval-command-54","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Exit zero even when the suite fails"},"524":{"id":"/cli-reference/eval-command-55","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--trials <N>`"},"525":{"id":"/cli-reference/eval-command-56","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override `trials_per_case` from the config for this run (1–1000)"},"526":{"id":"/cli-reference/eval-command-57","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--threshold <F>`"},"527":{"id":"/cli-reference/eval-command-58","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override `pass_threshold` from the config for this run (0.0–1.0)"},"528":{"id":"/cli-reference/eval-command-59","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--ci`"},"529":{"id":"/cli-reference/eval-command-60","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"CI mode: the suite passes when its overall pass rate meets the threshold, instead of requiring zero failed cases"},"530":{"id":"/cli-reference/eval-command-61","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--no-isolation`"},"531":{"id":"/cli-reference/eval-command-62","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run in the project root against the ambient agent environment (disables per-case isolation)"},"532":{"id":"/cli-reference/eval-command-63","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--judge`"},"533":{"id":"/cli-reference/eval-command-64","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Judge the run after scoring it, with the judges the checks file declares. Same function as `eval judge`"},"534":{"id":"/cli-reference/eval-command-65","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--judge-model <MODEL>`"},"535":{"id":"/cli-reference/eval-command-66","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Override every judge's model, and record the override"},"536":{"id":"/cli-reference/eval-command-67","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"By default every case runs **isolated**: the skill next to `skill-project.toml` is deployed alone into a per-case scratch workspace, and the agent's user-level skill discovery is suppressed where the backend supports it (claude, codex, pi). Scores then measure the skill under test rather than whatever else is installed on your machine. Isolation needs a `SKILL.md` beside `skill-project.toml` and a `[metadata].id` naming the skill — missing either is a `EVAL_ISOLATION_NO_SKILL` error, not a silent fallback."},"537":{"id":"/cli-reference/eval-command-68","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"The summary reports what each run actually got (`isolation:` line in table output, `isolation` object in `summary.json`), and a failed case's scratch workspace is kept under `<run-dir>/workspaces/` for debugging. Pass `--no-isolation` to restore the old inherit-everything behaviour."},"538":{"id":"/cli-reference/eval-command-69","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#environment-isolation","content":"Scores recorded before isolation existed were measured against the ambient environment — expect trigger rates to re-baseline on the first isolated run."},"539":{"id":"/cli-reference/eval-command-70","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Scores a completed run with the LLM judges its checks file declares. `eval run --judge` calls the same function right after the run's own scoring — there is one judging implementation, so a run judged either way is judged identically."},"540":{"id":"/cli-reference/eval-command-71","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Option"},"541":{"id":"/cli-reference/eval-command-72","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Description"},"542":{"id":"/cli-reference/eval-command-73","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--run-dir <DIR>`"},"543":{"id":"/cli-reference/eval-command-74","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"**Required.** The per-agent run directory (`<output-dir>/<timestamp>/<agent>`)"},"544":{"id":"/cli-reference/eval-command-75","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--checks <FILE>`"},"545":{"id":"/cli-reference/eval-command-76","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Read `[[judge]]` from this file instead of the one the run recorded"},"546":{"id":"/cli-reference/eval-command-77","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--judge-model <MODEL>`"},"547":{"id":"/cli-reference/eval-command-78","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Override every judge's model, and record the override"},"548":{"id":"/cli-reference/eval-command-79","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--judge-parallel <N>`"},"549":{"id":"/cli-reference/eval-command-80","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Concurrent judge requests (1–1000); defaults to the run's recorded `parallel`"},"550":{"id":"/cli-reference/eval-command-81","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--rejudge`"},"551":{"id":"/cli-reference/eval-command-82","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Judge again even when the same request already has a judgment"},"552":{"id":"/cli-reference/eval-command-83","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--ci`"},"553":{"id":"/cli-reference/eval-command-84","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"CI mode: the suite passes when its pass rate meets the run's threshold"},"554":{"id":"/cli-reference/eval-command-85","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--format <FORMAT>`"},"555":{"id":"/cli-reference/eval-command-86","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`table` or `json` only"},"556":{"id":"/cli-reference/eval-command-87","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--json`"},"557":{"id":"/cli-reference/eval-command-88","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Shorthand for `--format json`"},"558":{"id":"/cli-reference/eval-command-89","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"`--no-fail`"},"559":{"id":"/cli-reference/eval-command-90","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Exit zero on suite failure. Does **not** suppress a judge error"},"560":{"id":"/cli-reference/eval-command-91","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"A judge is one native chat completion per trial — no agent, no tools, nothing injected that the judge's author did not write. Each exchange is recorded in full in `trial-N/judgments.json`, and the engine, never the model, computes every score from the reply."},"561":{"id":"/cli-reference/eval-command-92","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"Rewrites are additive: `result.json`, `aggregated.json` and `summary.json` keep every field they had, and a reader that predates the judge tier sees exactly what it saw before. Judging the same run twice asks nothing — a trial whose latest judgment carries the same request identity is skipped unless `--rejudge`."},"562":{"id":"/cli-reference/eval-command-93","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-judge","content":"A trial that errored is never judged: there is no answer to score, and it is reported as skipped rather than as a zero. A judge that could not produce a judgment exits the command non-zero even under `--no-fail`, because a missing measurement must not be reported as a score."},"563":{"id":"/cli-reference/eval-command-94","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Summarizes a completed run directory."},"564":{"id":"/cli-reference/eval-command-95","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Option"},"565":{"id":"/cli-reference/eval-command-96","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Description"},"566":{"id":"/cli-reference/eval-command-97","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--run-dir <DIR>`"},"567":{"id":"/cli-reference/eval-command-98","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"**Required.** The per-agent run directory — `<output-dir>/<timestamp>/<agent>`, the one that holds `summary.json`"},"568":{"id":"/cli-reference/eval-command-99","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--format <FORMAT>`"},"569":{"id":"/cli-reference/eval-command-100","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`table` or `json` only"},"570":{"id":"/cli-reference/eval-command-101","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--json`"},"571":{"id":"/cli-reference/eval-command-102","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Shorthand for `--format json`"},"572":{"id":"/cli-reference/eval-command-103","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"Re-scores saved artifacts without invoking the agent again."},"573":{"id":"/cli-reference/eval-command-104","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"Option"},"574":{"id":"/cli-reference/eval-command-105","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"Description"},"575":{"id":"/cli-reference/eval-command-106","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"`--run-dir <DIR>`"},"576":{"id":"/cli-reference/eval-command-107","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"**Required.** The per-agent run directory (`<output-dir>/<timestamp>/<agent>`)"},"577":{"id":"/cli-reference/eval-command-108","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"`--format <FORMAT>`"},"578":{"id":"/cli-reference/eval-command-109","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"`table` or `json` only"},"579":{"id":"/cli-reference/eval-command-110","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"`--json`"},"580":{"id":"/cli-reference/eval-command-111","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"Shorthand for `--format json`"},"581":{"id":"/cli-reference/eval-command-112","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"`--no-fail`"},"582":{"id":"/cli-reference/eval-command-113","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-score","content":"Exit zero on suite failure"},"583":{"id":"/cli-reference/eval-command-114","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Folds many runs into named metrics and gates each on its own threshold, where `eval report` describes one run and `eval score` decides one run's verdict."},"584":{"id":"/cli-reference/eval-command-115","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"A scorecard reports each measurement's own rate rather than a suite pass rate. A case carrying both a skill-invocation check and a tool-call ceiling would otherwise report a budget overrun as a recall failure."},"585":{"id":"/cli-reference/eval-command-116","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Option"},"586":{"id":"/cli-reference/eval-command-117","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Description"},"587":{"id":"/cli-reference/eval-command-118","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--root <DIR>`"},"588":{"id":"/cli-reference/eval-command-119","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"**Required unless `--from`.** Searched recursively for run directories (any directory holding a `summary.json`)"},"589":{"id":"/cli-reference/eval-command-120","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--metrics <FILE>`"},"590":{"id":"/cli-reference/eval-command-121","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"**Required unless `--from`.** TOML file declaring the metrics and their thresholds"},"591":{"id":"/cli-reference/eval-command-122","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--format <FORMAT>`"},"592":{"id":"/cli-reference/eval-command-123","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`table`, `json` or `html`"},"593":{"id":"/cli-reference/eval-command-124","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--json`"},"594":{"id":"/cli-reference/eval-command-125","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Shorthand for `--format json`"},"595":{"id":"/cli-reference/eval-command-126","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--no-fail`"},"596":{"id":"/cli-reference/eval-command-127","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Report the numbers without failing on a metric below its threshold"},"597":{"id":"/cli-reference/eval-command-128","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--allow-mixed-judges`"},"598":{"id":"/cli-reference/eval-command-129","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Fold judgments from more than one judge identity into one metric"},"599":{"id":"/cli-reference/eval-command-130","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--allow-mixed-targets`"},"600":{"id":"/cli-reference/eval-command-131","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Fold runs against more than one `(agent, model)` pair into one scorecard"},"601":{"id":"/cli-reference/eval-command-132","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--allow-duplicate-cases`"},"602":{"id":"/cli-reference/eval-command-133","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Fold runs that measure the same case id more than once"},"603":{"id":"/cli-reference/eval-command-134","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--from <JSON>`"},"604":{"id":"/cli-reference/eval-command-135","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Render an already-written scorecard JSON instead of reading runs. Repeat it to draw a progress section. Conflicts with `--root` and `--metrics`"},"605":{"id":"/cli-reference/eval-command-136","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`-o`, `--output <FILE>`"},"606":{"id":"/cli-reference/eval-command-137","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Write the report here instead of to stdout"},"607":{"id":"/cli-reference/eval-command-138","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"`--no-reasoning`"},"608":{"id":"/cli-reference/eval-command-139","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-scorecard","content":"Leave judge reasoning out of the report and out of its embedded JSON"},"609":{"id":"/cli-reference/eval-command-140","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-metrics-file","content":"Each `[[metric]]` selects cases by `*`-wildcard id pattern. Omitting `cases` selects every case."},"610":{"id":"/cli-reference/eval-command-141","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-metrics-file","content":"`check_rate` is passing check results over observed check results, over trials rather than cases: a case passing three of five trials contributes 3/5. `tool_calls_p95` is the 95th percentile of tool calls per trial, compared against a ceiling. `judge_score` is the mean of a judge's `overall` — or of one named criterion — over the latest judgment per trial."},"611":{"id":"/cli-reference/eval-command-142","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"A number whose provenance is gone cannot be compared with last month's, so the scorecard records four identities beside the metrics:"},"612":{"id":"/cli-reference/eval-command-143","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Identity"},"613":{"id":"/cli-reference/eval-command-144","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Where it comes from"},"614":{"id":"/cli-reference/eval-command-145","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"**Target**"},"615":{"id":"/cli-reference/eval-command-146","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"The `(agent, model)` pair each run recorded"},"616":{"id":"/cli-reference/eval-command-147","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"**Skill**"},"617":{"id":"/cli-reference/eval-command-148","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`skill_git_sha` and `skill_dirty` copied from the run, never recomputed from the working tree — and reported only when every run agrees"},"618":{"id":"/cli-reference/eval-command-149","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"**Benchmark**"},"619":{"id":"/cli-reference/eval-command-150","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`sha256` over the metrics file and every file the declared `suites` select (`checks.toml`, `prompts.csv` and every judge prompt file)"},"620":{"id":"/cli-reference/eval-command-151","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"**Judges**"},"621":{"id":"/cli-reference/eval-command-152","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Every distinct `judge_hash` with the model, endpoint and sampling settings that produced it"},"622":{"id":"/cli-reference/eval-command-153","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Three guards refuse a scorecard that would average two different measurements together. Each names the offending values, and each has an override that records itself in the document, so a reader can see the mixing happened:"},"623":{"id":"/cli-reference/eval-command-154","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Refused when"},"624":{"id":"/cli-reference/eval-command-155","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Override"},"625":{"id":"/cli-reference/eval-command-156","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Recorded as"},"626":{"id":"/cli-reference/eval-command-157","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"A `judge_score` metric folds more than one `judge_hash`"},"627":{"id":"/cli-reference/eval-command-158","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`--allow-mixed-judges`"},"628":{"id":"/cli-reference/eval-command-159","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`metrics[].mixed_judges: true`"},"629":{"id":"/cli-reference/eval-command-160","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"The runs under `--root` carry more than one `(agent, model)`"},"630":{"id":"/cli-reference/eval-command-161","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`--allow-mixed-targets`"},"631":{"id":"/cli-reference/eval-command-162","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`metrics[].mixed_targets: true`, no top-level `agent`/`model`"},"632":{"id":"/cli-reference/eval-command-163","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"The same case id is measured by more than one run"},"633":{"id":"/cli-reference/eval-command-164","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`--allow-duplicate-cases`"},"634":{"id":"/cli-reference/eval-command-165","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Every `cases[]` row keeps its own `run_dir`"},"635":{"id":"/cli-reference/eval-command-166","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"`--no-fail` suppresses none of these: it says \"report the numbers rather than gate on them\", not \"the numbers mean something they do not\"."},"636":{"id":"/cli-reference/eval-command-167","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-json-document","content":"`--format json` emits a `fastskill.scorecard/1` document: the identities above, the `metrics` and `totals` the table shows, and a `cases[]` array with one row per `(run, case)` carrying every check result and, per judge, the latest judgment per trial with each criterion's normalised score, answer and **full** reasoning. Nothing in a row is summarised — the run directories get deleted, and this document is what survives them."},"637":{"id":"/cli-reference/eval-command-168","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-html-report","content":"`--format html` renders the same document as a page a reader opens months later: identity, the gates and their verdicts, the exclusions above as notes, the judges and their sampling settings, then one table per suite with every case, its checks and its judgments, reasoning folded behind a `<details>` after the first 600 characters."},"638":{"id":"/cli-reference/eval-command-169","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-html-report","content":"It is one file. The fonts are embedded, the stylesheet is inline, and the only `<script>` is a `<script type=\"application/json\">` holding the scorecards the page was rendered from — so the page carries its own machine-readable source, and opens with no network. A run directory is linked only when it is still on disk; a link to evidence that was deleted is worse than no link."},"639":{"id":"/cli-reference/eval-command-170","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-html-report","content":"Pass `--from` instead to render scorecard JSON that was written earlier — on another machine, or by CI. That mode reads no run directory at all, so it links none."},"640":{"id":"/cli-reference/eval-command-171","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-html-report","content":"Two or more `--from` files add a progress section: one chart per metric, ordered by `generated_at`, with the gate drawn as a dashed line and every point where the verdict flipped ringed. Series are keyed by target, so two agents on the same benchmark are two lines. Every input must carry the same non-null `benchmark.sha256` — a chart across two benchmarks plots two different measurements as one trend, and there is no override for it. Mismatched inputs fail with `EVAL_SCORECARD_BENCHMARK_MISMATCH`; a scorecard whose metrics file declared no `suites` has no hash to compare and fails with `EVAL_SCORECARD_NO_BENCHMARK_HASH`."},"641":{"id":"/cli-reference/eval-command-172","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#the-html-report","content":"`--no-reasoning` removes judge reasoning from the tables **and** from the embedded JSON. It is for reports that leave the team that ran them."},"642":{"id":"/cli-reference/eval-command-173","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"**Errored trials.** A trial with outcome `error` still carries check results, because the checks ran, over an empty trace. Every negative expectation and every tool-call ceiling passed there vacuously, so folding them would report an outage as perfect restraint. They are dropped from every rate and counted separately."},"643":{"id":"/cli-reference/eval-command-174","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"**Not-observable checks.** A check whose evidence the backend cannot produce records `passed: false` for older readers. It is excluded rather than counted as a failure."},"644":{"id":"/cli-reference/eval-command-175","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"**Estimated cost.** Only the vendor-reported figure is summed. When no trial reported one, the line reads \"not reported\" rather than `$0.00`."},"645":{"id":"/cli-reference/eval-command-176","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"**Judge errors and excluded trials.** A trial whose judgment errored contributes nothing to a `judge_score` — not a zero — and is counted in `totals.judge_errors`. A trial a gated judge could not judge is counted in `totals.judge_excluded_trials`."},"646":{"id":"/cli-reference/eval-command-177","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"**Advisory judge rows.** A `judge:<name>` row for a judge that does not gate never moves a `check_rate`. It is reported by the `judge_score` metric that names the judge."},"647":{"id":"/cli-reference/eval-command-178","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"A case whose every trial errored is named in the output, and a metric that matched nothing **fails the command** even under `--no-fail`: a mistyped case pattern would otherwise make a gate quietly disappear. Check results that no metric claims are named in a warning."},"648":{"id":"/cli-reference/eval-command-179","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#see-also","content":"`project init` for skill layout"},"649":{"id":"/cli-reference/init-command","page_id":"/cli-reference/init-command","type":"page","content":"project init","breadcrumbs":["Docs","Reference","CLI commands","Skills and projects"],"tags":[],"url":"/cli-reference/init-command"},"650":{"id":"/cli-reference/init-command-0","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#project-init","content":"`project init`"},"651":{"id":"/cli-reference/init-command-1","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#usage","content":"Usage"},"652":{"id":"/cli-reference/init-command-2","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#options","content":"Options"},"653":{"id":"/cli-reference/init-command-3","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#examples","content":"Examples"},"654":{"id":"/cli-reference/init-command-4","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#interactive-initialization","content":"Interactive Initialization"},"655":{"id":"/cli-reference/init-command-5","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#non-interactive-initialization","content":"Non-Interactive Initialization"},"656":{"id":"/cli-reference/init-command-6","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#set-all-fields-non-interactively","content":"Set All Fields Non-Interactively"},"657":{"id":"/cli-reference/init-command-7","page_id":"/cli-reference/init-command","type":"heading","tags":[],"url":"/cli-reference/init-command#force-reinitialization","content":"Force Reinitialization"},"658":{"id":"/cli-reference/init-command-8","page_id":"/cli-reference/i