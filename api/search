rl":"/cli-reference/eval-command#eval-judge","content":"A trial that errored is never judged: there is no answer to score, and it is reported as skipped rather than as a zero. A judge that could not produce a judgment exits the command non-zero even under `--no-fail`, because a missing measurement must not be reported as a score."},"571":{"id":"/cli-reference/eval-command-94","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Summarizes a completed run directory."},"572":{"id":"/cli-reference/eval-command-95","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Option"},"573":{"id":"/cli-reference/eval-command-96","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"Description"},"574":{"id":"/cli-reference/eval-command-97","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--run-dir <DIR>`"},"575":{"id":"/cli-reference/eval-command-98","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"**Required.** The per-agent run directory — `<output-dir>/<timestamp>/<agent>`, the one that holds `summary.json`"},"576":{"id":"/cli-reference/eval-command-99","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--format <FORMAT>`"},"577":{"id":"/cli-reference/eval-command-100","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`table` or `json` only"},"578":{"id":"/cli-reference/eval-command-101","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-report","content":"`--json`"},"579":{"id":"/cli-reference/eval-command-102","page_id":"/cli-r