-patterns-11","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Purpose"},"2239":{"id":"/examples/advanced-patterns-12","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--threshold`"},"2240":{"id":"/examples/advanced-patterns-13","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Minimum similarity to report"},"2241":{"id":"/examples/advanced-patterns-14","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--limit`"},"2242":{"id":"/examples/advanced-patterns-15","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Maximum number of pairs to show"},"2243":{"id":"/examples/advanced-patterns-16","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--severity`"},"2244":{"id":"/examples/advanced-patterns-17","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"Filter by minimum severity: `critical`, `high`, `medium`, `all`"},"2245":{"id":"/examples/advanced-patterns-18","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`--format`"},"2246":{"id":"/examples/advanced-patterns-19","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#find-duplicate-and-overlapping-skills","content":"`table`, `json`, `grid`, or `xml` (`--json` is shorthand)"},"2247":{"id":"/examples/advanced-patterns-20","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#improve-a-skill-with-optimization","content":"`fastskill optimization` runs a text-gradient loop to iteratively improve a skill's content:"},"2248":{"id":"/examples/advanced-patterns-21","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#install-only-part-of-a-collection-with-groups","content":"Skills can be tagged into groups; installs can include or exclude them (poetry-style):"},"2249":{"id":"/examples/advanced-patterns-22","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"For local skill development, add without copying and add whole trees at once:"},"2250":{"id":"/examples/advanced-patterns-23","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#editable-and-recursive-local-skills","content":"After editing an editable skill in place, run `fastskill index rebuild` so semantic search and resolve\nreflect the changes."},"2251":{"id":"/examples/advanced-patterns-24","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#project-vs-global-scope","content":"Most commands default to the current project. Use `--global` to operate on the shared user-level\nskills directory (`~/.config/fastskill/skills`, tracked by `global-skills.lock`):"},"2252":{"id":"/examples/advanced-patterns-25","page_id":"/examples/advanced-patterns","tags":[],"type":"text","url":"/examples/advanced-patterns#project-vs-global-scope","content":"Use `analysis` to keep a collection tidy, `optimization` to sharpen individual skills, and group\nfilters\nplus `--global` to control what gets installed where."},"2253":{"id":"/examples/integration-tutorials","page_id":"/examples/integration-tutorials","type":"page","content":"Integration Tutorials","breadcrumbs":["Docs","Reference","Workflow examples"],"tags":[],"url":"/examples/integration-tutorials"},"2254":{"id":"/examples/integration-tutorials-0","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials","content":"Connect FastSkill to agents and pipelines: MCP into Claude Code and Cursor, the serve HTTP API, and locked installs in CI."},"2255":{"id":"/examples/integration-tutorials-1","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#overview","content":"Overview"},"2256":{"id":"/examples/integration-tutorials-2","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"1\\. MCP into Claude Code"},"2257":{"id":"/examples/integration-tutorials-3","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"2\\. MCP into Cursor"},"2258":{"id":"/examples/integration-tutorials-4","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"3\\. Call the HTTP API from an app"},"2259":{"id":"/examples/integration-tutorials-5","page_id":"/examples/integration-tutorials","type":"heading","tags":[],"url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"4\\. Reproducible installs in CI"},"2260":{"id":"/examples/integration-tutorials-6","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#overview","content":"These tutorials cover FastSkill's real integration surfaces: the **MCP** server for agents, the\n**HTTP API** from `fastskill server serve`, and **locked installs** in CI. Each uses commands and endpoints\nthat exist in the tool."},"2261":{"id":"/examples/integration-tutorials-7","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"Expose FastSkill to Claude Code as MCP tools — read-only unless you start the server with\n`--enable-write`."},"2262":{"id":"/examples/integration-tutorials-8","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#1-mcp-into-claude-code","content":"Claude Code will now see tools named after complete command paths, such as\n`fastskill_skill_search`, `fastskill_skill_list`, `fastskill_skill_read`, and\n`fastskill_repo_show`. Mutating tools such as `fastskill_project_install` and\n`fastskill_repo_add` are withheld until the server is started with `--enable-write`; see\nWrite access. To point the agent at a running HTTP MCP\nserver instead of spawning FastSkill itself:"},"2263":{"id":"/examples/integration-tutorials-9","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"Same flow, different agent key:"},"2264":{"id":"/examples/integration-tutorials-10","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#2-mcp-into-cursor","content":"Supported agents: `claude`, `cursor`, `gemini`, `copilot`, `opencode`, `codex`. See the full\nMCP tool-calling guide."},"2265":{"id":"/examples/integration-tutorials-11","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"Run the server and use the versioned `/api/v1/...` REST surface. Start read-only:"},"2266":{"id":"/examples/integration-tutorials-12","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#3-call-the-http-api-from-an-app","content":"These are all read endpoints and work without `--enable-write`. To manage skills over HTTP (install /\nupdate / delete), start with `fastskill server serve --enable-write`, and front the port with an\nauthenticating proxy if it is exposed — `server serve` enforces no auth of its own. See the\n`server serve` reference and security model."},"2267":{"id":"/examples/integration-tutorials-13","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"Commit `skill-project.toml` and `skills.lock`, then install exact locked versions in the pipeline:"},"2268":{"id":"/examples/integration-tutorials-14","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"Set `OPENAI_API_KEY` from a CI secret if the pipeline needs semantic search or reindex; without it\nthose steps skip silently rather than failing."},"2269":{"id":"/examples/integration-tutorials-15","page_id":"/examples/integration-tutorials","tags":[],"type":"text","url":"/examples/integration-tutorials#4-reproducible-installs-in-ci","content":"For agents, install FastSkill as an MCP server. For services and pipelines, use the `server serve`\nHTTP API and `project install --lock`. There is no separate SDK to integrate — the CLI, MCP tools,\nand HTTP API are the surface."},"2270":{"id":"/integration/agents","page_id":"/integration/agents","type":"page","content":"Documentation and tools for agents","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/agents"},"2271":{"id":"/integration/agents-0","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents","content":"Retrieve current FastSkill documentation as Markdown and use the CLI or MCP safely."},"2272":{"id":"/integration/agents-1","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#read-the-documentation","content":"Read the documentation"},"2273":{"id":"/integration/agents-2","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#inspect-the-cli-contract","content":"Inspect the CLI contract"},"2274":{"id":"/integration/agents-3","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#preview-apply-verify","content":"Preview, apply, verify"},"2275":{"id":"/integration/agents-4","page_id":"/integration/agents","type":"heading","tags":[],"url":"/integration/agents#agent-skills-and-mcp","content":"Agent skills and MCP"},"2276":{"id":"/integration/agents-5","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#read-the-documentation","content":"This site documents one release. The release number appears on every page and in\nall Markdown exports. Start with llms.txt, follow its per-page Markdown\nlinks, or download llms-full.txt. These URLs need no authentication\nor browser JavaScript. Each page also provides View Markdown and Copy Markdown."},"2277":{"id":"/integration/agents-6","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#inspect-the-cli-contract","content":"Match the binary version to the documentation. `cli spec` describes the installed\nbinary's complete command tree and flags. Use only the flags supported by that\ncommand; `--json` is not a global flag."},"2278":{"id":"/integration/agents-7","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#preview-apply-verify","content":"Check the process exit status and the returned diagnostics. A valid JSON response\ncan describe failure or partial success. Dry runs validate a plan without changing\nmanaged state; online plans can still fetch inputs. Use `--offline` when supported\nand when required verified content is already available locally."},"2279":{"id":"/integration/agents-8","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#agent-skills-and-mcp","content":"Installed skills provide task instructions. FastSkill's MCP tools provide package\noperations. They are separate interfaces; reading a skill does not require an MCP\nserver. See Claude Code and\nCursor for installation locations and registration."},"2280":{"id":"/integration/agents-9","page_id":"/integration/agents","tags":[],"type":"text","url":"/integration/agents#agent-skills-and-mcp","content":"The server exposes read-only tools by default. Mutating tools require\n`mcp serve --enable-write`. Tool names use the full command path, for example\n`fastskill_skill_read` and `fastskill_project_install`. See\nMCP tool access for write configuration."},"2281":{"id":"/integration/claude-code-integration","page_id":"/integration/claude-code-integration","type":"page","content":"Claude Code Integration","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/claude-code-integration"},"2282":{"id":"/integration/claude-code-integration-0","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration","content":"Integrate FastSkill with Claude Code for intelligent skill discovery."},"2283":{"id":"/integration/claude-code-integration-1","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#overview","content":"Overview"},"2284":{"id":"/integration/claude-code-integration-2","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#quick-start","content":"Quick start"},"2285":{"id":"/integration/claude-code-integration-3","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#how-it-works","content":"How it works"},"2286":{"id":"/integration/claude-code-integration-4","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#github-actions","content":"GitHub Actions"},"2287":{"id":"/integration/claude-code-integration-5","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#troubleshooting","content":"Troubleshooting"},"2288":{"id":"/integration/claude-code-integration-6","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#mcp-registration","content":"MCP Registration"},"2289":{"id":"/integration/claude-code-integration-7","page_id":"/integration/claude-code-integration","type":"heading","tags":[],"url":"/integration/claude-code-integration#http-api","content":"HTTP API"},"2290":{"id":"/integration/claude-code-integration-8","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#overview","content":"Claude Code reads skills **directly** from the skills directory (`.claude/skills/` by\ndefault). FastSkill's job is to get the right skills onto disk and keep them reconciled with\nyour manifest — once a skill is installed, Claude Code discovers it natively. There is no\nmetadata file to generate or keep in sync."},"2291":{"id":"/integration/claude-code-integration-9","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#quick-start","content":"That's it — the next time Claude Code runs in this project, the installed skills are available."},"2292":{"id":"/integration/claude-code-integration-10","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"`fastskill project install` / `fastskill skill add` materializes skills into the configured\n`skills_directory` (default `.claude/skills/`)."},"2293":{"id":"/integration/claude-code-integration-11","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Each skill is a folder containing `SKILL.md` plus its resources."},"2294":{"id":"/integration/claude-code-integration-12","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Claude Code scans that directory and loads skills by their `SKILL.md` frontmatter — no\nexport or sync step is involved."},"2295":{"id":"/integration/claude-code-integration-13","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#how-it-works","content":"Use `fastskill skill read <skill-id>` to see exactly what an agent loads, or\n`fastskill skill read <skill-id> --meta` for just the metadata."},"2296":{"id":"/integration/claude-code-integration-14","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#github-actions","content":"Keep the skills directory reconciled in CI so commits always carry the resolved skill set:"},"2297":{"id":"/integration/claude-code-integration-15","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#troubleshooting","content":"**Claude Code doesn't see a skill:** Confirm it is installed with `fastskill skill list`, and that\nthe skills directory contains a valid `SKILL.md` for it. `fastskill skill read <skill-id>` should\nprint its content."},"2298":{"id":"/integration/claude-code-integration-16","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#troubleshooting","content":"**Wrong skills directory:** Claude Code and FastSkill must agree on the location. The default\nis `.claude/skills/`; override it via `skills_directory` under `[tool.fastskill]` in\n`skill-project.toml` or the `--skills-dir` flag."},"2299":{"id":"/integration/claude-code-integration-17","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#mcp-registration","content":"Register `fastskill` as an MCP server inside Claude Code with a single command:"},"2300":{"id":"/integration/claude-code-integration-18","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#mcp-registration","content":"After running the command, reload Claude Code. The tools exposed by\n`fastskill mcp serve --transport stdio` will be callable from the agent — the read-only ones only.\nMutating tools (`fastskill_project_install`, `fastskill_skill_add`,\n`fastskill_skill_remove`, …) require `mcp serve --enable-write`; see\nWrite access."},"2301":{"id":"/integration/claude-code-integration-19","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"`fastskill server serve` exposes FastSkill's versioned application API under `/api/v1/…`, for example `GET /api/v1/status` and `GET /api/v1/skills`."},"2302":{"id":"/integration/claude-code-integration-20","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"The old Claude-compatible `/v1/skills…` HTTP surface is no longer part of the public server. Use the MCP integration above for Claude Code and use `/api/v1/…` for HTTP clients."},"2303":{"id":"/integration/claude-code-integration-21","page_id":"/integration/claude-code-integration","tags":[],"type":"text","url":"/integration/claude-code-integration#http-api","content":"See the agent’s skill documentation for native discovery behavior."},"2304":{"id":"/integration/cursor-integration","page_id":"/integration/cursor-integration","type":"page","content":"Cursor Integration","breadcrumbs":["Docs","Connect agents","Agent setup"],"tags":[],"url":"/integration/cursor-integration"},"2305":{"id":"/integration/cursor-integration-0","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration","content":"Integrate FastSkill with Cursor IDE for intelligent skill discovery and tool recommendations."},"2306":{"id":"/integration/cursor-integration-1","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#overview","content":"Overview"},"2307":{"id":"/integration/cursor-integration-2","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#quick-start","content":"Quick start"},"2308":{"id":"/integration/cursor-integration-3","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#mcp-registration","content":"MCP registration"},"2309":{"id":"/integration/cursor-integration-4","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"How Cursor uses the skills"},"2310":{"id":"/integration/cursor-integration-5","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#example","content":"Example"},"2311":{"id":"/integration/cursor-integration-6","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#configuration","content":"Configuration"},"2312":{"id":"/integration/cursor-integration-7","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#multiple-skill-directories","content":"Multiple skill directories"},"2313":{"id":"/integration/cursor-integration-8","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#automation","content":"Automation"},"2314":{"id":"/integration/cursor-integration-9","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#troubleshooting","content":"Troubleshooting"},"2315":{"id":"/integration/cursor-integration-10","page_id":"/integration/cursor-integration","type":"heading","tags":[],"url":"/integration/cursor-integration#summary","content":"Summary"},"2316":{"id":"/integration/cursor-integration-11","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#overview","content":"Cursor discovers skills **directly** from the skills directory (`.claude/skills/` by default)\nand via the FastSkill MCP server. FastSkill's job is to install the right skills onto disk and\nkeep them reconciled with your manifest — there is no metadata file to generate or keep in sync."},"2317":{"id":"/integration/cursor-integration-12","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#overview","content":"Modern agents (Cursor, Claude Code, …) read installed skills from the skills directory natively.\nJust `fastskill project install` (or `fastskill skill add`) and the skills are available. Register the MCP\nserver below for richer, tool-based access from inside Cursor."},"2318":{"id":"/integration/cursor-integration-13","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#mcp-registration","content":"Register `fastskill` as an MCP server inside Cursor with a single command:"},"2319":{"id":"/integration/cursor-integration-14","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#mcp-registration","content":"After running the command, reload Cursor. The tools exposed by\n`fastskill mcp serve --transport stdio` will be callable from the agent — the read-only ones only.\nMutating tools (`fastskill_project_install`, `fastskill_skill_add`,\n`fastskill_skill_remove`, …) require\n`mcp serve --enable-write`; see Write access."},"2320":{"id":"/integration/cursor-integration-15","page_id":"/integration/cursor-integration","tags":[],"type":"text","url":"/integration/cursor-integration#how-cursor-uses-the-skills","content":"When you ask Cursor to perform a task, it:"