 resolved relative to the **skill project root** (the directory containing `skill-project.toml`) unless it's absolute."},"2218":{"id":"/evals-quality/setup-24","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Field"},"2219":{"id":"/evals-quality/setup-25","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Type"},"2220":{"id":"/evals-quality/setup-26","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Required"},"2221":{"id":"/evals-quality/setup-27","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Default"},"2222":{"id":"/evals-quality/setup-28","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Meaning"},"2223":{"id":"/evals-quality/setup-29","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"`prompts`"},"2224":{"id":"/evals-quality/setup-30","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"path"},"2225":{"id":"/evals-quality/setup-31","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"**yes**"},"2226":{"id":"/evals-quality/setup-32","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"—"},"2227":{"id":"/evals-quality/setup-33","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-quality/setup#1-the-toolfastskilleval-table","content":"Path to the prompts CSV."},"2228":{"id":"/evals-quality/setup-34","page_id":"/evals-quality/setup","tags":[],"type":"text","url":"/evals-qua