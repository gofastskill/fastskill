me","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`project install --lock` restores the locked selection without updating the lock."},"409":{"id":"/welcome-19","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill update` deliberately resolves changes allowed by the recorded constraints."},"410":{"id":"/welcome-20","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill remove` removes a direct owner; shared requirements can keep a skill installed."},"411":{"id":"/welcome-21","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"`skill list --check` verifies the desired, locked, and installed state."},"412":{"id":"/welcome-22","page_id":"/welcome","tags":[],"type":"text","url":"/welcome#choose-the-operation","content":"Start with your first skill. Continue with\nmanifests and scope,\nteam bundles, or agent access."},"413":{"id":"/cli-reference/bundle-command","page_id":"/cli-reference/bundle-command","type":"page","content":"Bundle commands","breadcrumbs":["Docs","Share with teams"],"tags":[],"url":"/cli-reference/bundle-command"},"414":{"id":"/cli-reference/bundle-command-0","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command","content":"Build, install, update, and restore self-contained project exports."},"415":{"id":"/cli-reference/bundle-command-1","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#bundle-commands","content":"`bundle` commands"},"416":{"id":"/cli-reference/bundle-command-2","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#build-a-bundle","content":"Build a bundle"},"417":{"id":"/cli-reference/bundle-command-3","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#install-and-inspect","content":"Install and inspect"},"418":{"id":"/cli-reference/bundle-command-4","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#update-a-bundle","content":"Update a bundle"},"419":{"id":"/cli-reference/bundle-command-5","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove a bundle"},"420":{"id":"/cli-reference/bundle-command-6","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"Reuse a setup without packaging it"},"421":{"id":"/cli-reference/bundle-command-7","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Legacy member overrides"},"422":{"id":"/cli-reference/bundle-command-8","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#bundle-commands","content":"Bundles turn a skill project into one versioned ZIP. The artifact contains every declared skill,\nits installed dependency closure, resource files, and content digests. A recipient can\ninstall it without access to the original repositories. On Unix systems, executable files remain\nexecutable after bundle installation; other permission bits are normalized for portability."},"423":{"id":"/cli-reference/bundle-command-9","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Complete the quickstart, then give the project an identity and version in its existing\n`skill-project.toml`:"},"424":{"id":"/cli-reference/bundle-command-10","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Every dependency becomes a bundle member. Its installed version must satisfy the declaration.\nFastSkill stops before writing an artifact when a declared dependency is\nmissing, has invalid frontmatter, or has a different version."},"425":{"id":"/cli-reference/bundle-command-11","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Build the release:"},"426":{"id":"/cli-reference/bundle-command-12","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"The result is `dist/notes-team-1.0.0.zip`. Its embedded identity, version, membership, and\ndigests are authoritative, so renaming the download does not change the release.\nAn artifact built by an earlier release, whose digests lack the `sha256-tree-v2:` prefix, still\ninstalls with a warning; rebuild it to record current-form digests."},"427":{"id":"/cli-reference/bundle-command-13","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"There is no `[bundle.members]` list to maintain. A source Manifest using the earlier `[bundle]`\nformat remains buildable for migration, while all new bundles should use `[metadata]`."},"428":{"id":"/cli-reference/bundle-command-14","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"In a second project initialized with `project init --yes --skills-dir .claude/skills`,\ninstall the artifact with `bundle add`. Replace the local path with the artifact you\nbuilt. The HTTPS URL below is an example for an artifact hosted by your team:"},"429":{"id":"/cli-reference/bundle-command-15","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Installation copies the artifact into `.fastskill/bundles/`, adds its declaration to\n`skill-project.toml`, and records the exact release and members in `skills.lock`."},"430":{"id":"/cli-reference/bundle-command-16","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Commit these files when teammates and CI need the same setup:"},"431":{"id":"/cli-reference/bundle-command-17","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Then restore the exact locked release:"},"432":{"id":"/cli-reference/bundle-command-18","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"`--lock` uses the bundle artifact, version, digest, and membership recorded in `skills.lock`.\nIt does not switch to a different release if the manifest has drifted. `--offline` additionally\nguarantees that restore does not contact a repository or embedding provider."},"433":{"id":"/cli-reference/bundle-command-19","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"Bundle updates are explicit. After building version `1.1.0` of your bundle, preview\nand apply that replacement:"},"434":{"id":"/cli-reference/bundle-command-20","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"FastSkill checks the new artifact, shared ownership, local modifications, and release immutability\nbefore it changes installed members. The preview runs the same validation as apply and reports\nmembership changes even when retained member bytes are unchanged."},"435":{"id":"/cli-reference/bundle-command-21","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove the bundle identity and the members that have no other owner:"},"436":{"id":"/cli-reference/bundle-command-22","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Removing a direct declaration detaches that owner. FastSkill retains the installed member while a\nbundle or another dependency root still requires it. An ID that is only a transitive requirement\ncannot be removed directly; the error names the roots that require it. A member is deleted only\nafter its final direct, transitive, or bundle owner is gone."},"437":{"id":"/cli-reference/bundle-command-23","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"A references-only bundle would duplicate a Manifest, so FastSkill uses Manifest composition for\nthat case. A consuming project references the shared file once:"},"438":{"id":"/cli-reference/bundle-command-24","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"The shared Manifest can declare skills from multiple Git repositories, configured repositories,\nZIP URLs, or shared paths. `project install` resolves the combined roots and the consuming project\nwrites the exact results to its own `skills.lock`. References may be nested. FastSkill rejects\nmissing files, reference cycles, and incompatible declarations of the same skill ID."},"439":{"id":"/cli-reference/bundle-command-25","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"Use a bundle when recipients need an offline-ready artifact. Use a composed Manifest when they\nhave access to the declared sources and should obtain the skills from those sources."},"440":{"id":"/cli-reference/bundle-command-26","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Bundles created with the earlier `[bundle.members]` format may permit a personal replacement.\nThose existing artifacts remain supported through `fastskill bundle override <skill-id> --from <directory>` and `fastskill bundle override <skill-id> --reset`. Manifest-driven builds make all\nmembers required and do not create new override policies."},"441":{"id":"/cli-reference/bundle-command-27","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Every bundle action except `bundle list` changes files. The MCP server hides and refuses these\ntools unless it starts with `fastskill mcp serve --enable-write`."},"442":{"id":"/cli-reference/cache-command","page_id":"/cli-reference/cache-command","type":"page","content":"cache Command","breadcrumbs":["Docs","Reference","CLI commands","Operations"],"tags":[],"url":"/cli-reference/cache-command"},"443":{"id":"/cli-reference/cache-command-0","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command","content":"Inspect and reclaim the on-disk skill content cache with fastskill cache."},"444":{"id":"/cli-reference/cache-command-1","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#cache-command","content":"cache Command"},"445":{"id":"/cli-reference/cache-command-2","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#usage","content":"Usage"},"446":{"id":"/cli-reference/cache-command-3","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#subcommands","content":"Subcommands"},"447":{"id":"/cli-reference/cache-command-4","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#info","content":"info"},"448":{"id":"/cli-reference/cache-command-5","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#clean","content":"clean"},"449":{"id":"/cli-reference/cache-command-6","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#when-to-run-it","content":"When to run it"},"450":{"id":"/cli-reference/cache-command-7","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#see-also","content":"See Also"},"451":{"id":"/cli-reference/cache-command-8","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Inspect and reclaim the on-disk cache that `skill add`, `project install`, and `skill update` use so a skill's\ncontent is fetched once per machine instead of once per project."},"452":{"id":"/cli-reference/cache-command-9","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Every git, registry, or local skill fetch is checked against this cache before touching the\nnetwork again. `fastskill cache` is how to see what has accumulated there and reclaim disk\nspace -- fastskill never evicts cache entries on its own."},"453":{"id":"/cli-reference/cache-command-10","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"Show the cache location plus entry counts and disk usage, broken down by source kind (git,\nregistry, or local)."},"454":{"id":"/cli-reference/cache-command-11","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Example output**:"},"455":{"id":"/cli-reference/cache-command-12","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Options**:"},"456":{"id":"/cli-reference/cache-command-13","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--format <table|json>`: Output format (default: table)"},"457":{"id":"/cli-reference/cache-command-14","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--json`: Shorthand for `--format json` (mutually exclusive with `--format`)"},"458":{"id":"/cli-reference/cache-command-15","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"Remove cached skill content and print how many bytes were reclaimed."},"459":{"id":"/cli-reference/cache-command-16","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Options**:"},"460":{"id":"/cli-reference/cache-command-17","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--source <git|registry|local>`: Limit cleaning to one source kind (default: all)"},"461":{"id":"/cli-reference/cache-command-18","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--json`: Print the result as JSON instead of a summary line"},"462":{"id":"/cli-reference/cache-command-19","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**What it removes**: Only cached skill content -- the record of what a repository currently\nadvertises (what `repo refresh` writes) is left alone, so `repo refresh` output stays valid\nafter a clean. There is nothing to undo: the next `skill add`/`project install`/`skill update` that needs a removed\nentry re-fetches it from its original source."},"463":{"id":"/cli-reference/cache-command-20","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Safe with other fastskill processes running**: `clean` never removes an entry another process\nis mid-write on, and every write elsewhere is atomic. In the worst case, a fetch running at the\nexact moment of a clean simply re-fetches -- it never sees partial or corrupted content."},"464":{"id":"/cli-reference/cache-command-21","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache info`**: Before a `clean`, to see what is actually taking up space, or when disk\nusage seems higher than expected."},"465":{"id":"/cli-reference/cache-command-22","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache clean`**: To reclaim disk space after finishing with skills from a source no longer\nin use, or as routine cleanup on a machine used for many short-lived projects."},"466":{"id":"/cli-reference/cache-command-23","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"`repo` commands -- refresh what a repository advertises\n(`repo refresh`), independent of the content cache `cache` manages"},"467":{"id":"/cli-reference/cache-command-24","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"Install Command -- installs that hit this cache"},"468":{"id":"/cli-reference/discovery-commands","page_id":"/cli-reference/discovery-commands","type":"page","content":"Discover and inspect skills","breadcrumbs":["Docs","Reference","CLI commands","Sources and distribution"],"tags":[],"url":"/cli-reference/discovery-commands"},"469":{"id":"/cli-reference/discovery-commands-0","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Find a catalog result, inspect its origin, and install it explicitly."},"470":{"id":"/cli-reference/discovery-commands-1","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-installed-skills","content":"Search installed skills"},"471":{"id":"/cli-reference/discovery-commands-2","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-a-catalog","content":"Search a catalog"},"472":{"id":"/cli-reference/discovery-commands-3","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Complete the quickstart for local skills, or configure a real\ncatalog. Examples below use placeholder repository and skill IDs."},"473":{"id":"/cli-reference/discovery-commands-4","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-installed-skills","content":"Local keyword search needs no API key. Semantic search is optional and requires an\nindex and embedding provider."},"474":{"id":"/cli-reference/discovery-commands-5","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"Remote search is the default when `--local` is absent. Results identify the\ncanonical skill ID, repository, version, and installation command. Empty catalogs,\nmissing configuration, and partial failures are distinct outcomes; inspect both\nJSON diagnostics and exit status."},"475":{"id":"/cli-reference/discovery-commands-6","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"See search reference for filters and output formats,\nand repository reference for catalog operations."},"476":{"id":"/cli-reference/eval-command","page_id":"/cli-reference/eval-command","type":"page","content":"eval Command","breadcrumbs":["Docs","Reference","CLI commands","Quality"],"tags":[],"url":"/cli-reference/eval-command"},"477":{"id":"/cli-reference/eval-command-0","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command","content":"Validate, run, report, and score skill evaluation suites defined in skill-project.toml."},"478":{"id":"/cli-reference/eval-command-1","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#overview","content":"Overview"},"479":{"id":"/cli-reference/eval-command-2","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#usage","content":"Usage"},"480":{"id":"/cli-reference/eval-command-3","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-validate","content":"eval validate"},"481":{"id":"/cli-reference/eval-command-4","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-run","content":"eval run"},"482":{"id":"/cli-reference/eval-command-5","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#environment-isolation","content":"Environment isolation"},"483":{"id":"/cli-reference/eval-command-6","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-judge","content":"eval judge"},"484":{"id":"/cli-reference/eval-command-7","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-report","content":"eval report"},"485":{"id":"/cli-reference/eval-command-8","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-score","content":"eval score"},"486":{"id":"/cli-reference/eval-command-9","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-scorecard","content":"eval scorecard"},"487":{"id":"/cli-reference/eval-command-10","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-metrics-file","content":"The metrics file"},"488":{"id":"/cli-reference/eval-command-11","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Identity: what the numbers are about"},"489":{"id":"/cli-reference/eval-command-12","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-json-document","content":"The JSON document"},"490":{"id":"/cli-reference/eval-command-13","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-html-report","content":"The HTML report"},"491":{"id":"/cli-reference/eval-command-14","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"What is excluded, and why"},"492":{"id":"/cli-reference/eval-command-15","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#see-also","content":"See also"},"493":{"id":"/cli-reference/eval-command-16","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`fastskill eval` runs skill quality checks using prompts and rubrics under `[tool.fastskill.eval]` in `skill-project.toml`. Subcommands are `validate`, `run`, `judge`, `report`, `score`, and `scorecard`."},"494":{"id":"/cli-reference/eval-command-17","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`eval run` requires an agent on `PATH` for the chosen `--agent` key. Known keys are `aikit`, `claude`, `codex`, `cursor`, `gemini`, and `pi`. A key is accepted only when its CLI is detected on the current machine, so a typo and an uninstalled agent both error with `RUNTIME_UNKNOWN_ID`, which lists what was detected. Use `eval validate --agent <key>` or `--all` to verify availability."},"495":{"id":"/cli-reference/eval-command-18","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Checks eval configuration and files (optional agent presence check)."},"496":{"id":"/cli-reference/eval-command-19","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Option"},"497":{"id":"/cli-reference/eval-command-20","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Description"},"498":{"id":"/cli-reference/eval-command-21","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--agent <AGENT>`"},"499":{"id":"/cli-reference/eval-command-22","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify the given agent(s) are available; repeatable. Mutually exclusive with `--all`"},"500":{"id":"/cli-reference/eval-command-23","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--all`"},"501":{"id":"/cli-reference/eval-command-24","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify availability of every installed agent. Mutually exclusive with `--agent`"},"502":{"id":"/cli-reference/eval-command-25","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--model <MODEL>`"},"503":{"id":"/cli-reference/eval-command-26","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"The model `eval run` will target; a judge declaring the same one is reported as self-preference"},"504":{"id":"/cli-reference/eval-command-27","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--format <FORMAT>`"},"505":{"id":"/cli-reference/eval-command-28","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`table` or `json` only (eval does not support `grid`/`xml`)"},"506":{"id":"/cli-reference/eval-command-29","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--json`"},"507":{"id":"/cli-reference/eval-command-30","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Shorthand for `--format json`"},"508":{"id":"/cli-reference/eval-command-31","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Every `[[judge]]` in the checks file is validated from file content alone, so validate gives the same answer on a laptop and in CI. Errors: no resolvable `model`; neither or both of `prompt` / `prompt_file` (likewise for the system and retry pairs); an unknown `{{variable}}`; a `cases` id matching no case; duplicate criterion names; `scale` below 2; `min_score` outside `[0, 1]`; a prompt that never renders `{{output_contract}}`; any unknown key. Warnings: a prompt without `{{rubric}}`, and a judge sharing `--model`. Endpoint reachability and API keys are not checked here — judging checks those before its first request."},"509":{"id":"/cli-reference/eval-command-32","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"With `--agent` or `--all`, both outputs report each selected agent:\nthe table prints one `agent '<key>': available|unavailable` line per agent, and the JSON document carries an `agents` object keyed by agent id (`{\"agents\": {\"claude\": true}}`). An unavailable agent is an error unless `fail_on_missing_agent = false` is set in the eval config."},"510":{"id":"/cli-reference/eval-command-33","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Runs eval cases against an agent; writes artifacts under `--output-dir`."},"511":{"id":"/cli-reference/eval-command-34","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`)."},"512":{"id":"/cli-reference/eval-command-35","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Option"},"513":{"id":"/cli-reference/eval-command-36","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Description"},"514":{"id":"/cli-reference/eval-command-37","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <AGENT>`"},"515":{"id":"/cli-reference/eval-command-38","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Agent key(s) to run; repeatable. Required unless `--all` is given"},"516":{"id":"/cli-reference/eval-command-39","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--all`"},"517":{"id":"/cli-reference/eval-command-40","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Run against all installed agents. Mutually exclusive with `--agent`"},"518":{"id":"/cli-reference/eval-command-41","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--output-dir <DIR>`"},"519":{"id":"/cli-reference/eval-command-42","page_id"