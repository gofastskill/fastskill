":[],"type":"text","url":"/cli-reference/install-command#install-without-dev-skills","content":"This is useful for CI/CD pipelines where you want lean production deployments without development dependencies."},"876":{"id":"/cli-reference/install-command-76","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#install-only-specific-groups","content":"Install only skills from specific groups:"},"877":{"id":"/cli-reference/install-command-77","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#reproducible-installation","content":"Install exact versions from `skills.lock`:"},"878":{"id":"/cli-reference/install-command-78","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#reproducible-installation","content":"Use `--lock` for production deployments. It verifies locked identity, revision, and content and\nleaves lock bytes unchanged. `--offline` also prevents network and provider calls."},"879":{"id":"/cli-reference/install-command-79","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#reproducible-installation","content":"Project lock restoration still requires `skill-project.toml`; the Manifest defines selected roots,\ngroups, bundles, and the install destination. To restore `global-skills.lock` without a project\nManifest, run `fastskill project install --global --lock`."},"880":{"id":"/cli-reference/install-command-80","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#combined-example-production-deployment","content":"Install production skills with exact versions:"},"881":{"id":"/cli-reference/install-command-81","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"The `project install` command:"},"882":{"id":"/cli-reference/install-command-82","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Locates Project File**: Finds `skill-project.toml` at project root or walks up directory tree"},"883":{"id":"/cli-reference/install-command-83","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Loads Dependencies**: Reads `[dependencies]` section from `skill-project.toml`"},"884":{"id":"/cli-reference/install-command-84","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Selects Roots**: Applies `--without` or `--only` to roots, then includes every required child"},"885":{"id":"/cli-reference/install-command-85","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Resolves Skills**: For each dependency:"},"886":{"id":"/cli-reference/install-command-86","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"If `--lock` is set: verifies complete locked coverage and exact resolved facts"},"887":{"id":"/cli-reference/install-command-87","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"Otherwise: reuses compatible pins and resolves only missing coverage"},"888":{"id":"/cli-reference/install-command-88","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Validates a Plan**: Checks IDs, cycles, depth, digests, ownership, and destination safety"},"889":{"id":"/cli-reference/install-command-89","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Installs Skills**: Stages and commits each overlapping dependency closure as one recovery unit"},"890":{"id":"/cli-reference/install-command-90","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#behavior","content":"**Updates Lockfile**: Records exact facts without moving unrelated compatible pins"},"891":{"id":"/cli-reference/install-command-91","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#dependency-groups","content":"Skills can be organized into groups for selective installation. Specify groups in `skill-project.toml`:"},"892":{"id":"/cli-reference/install-command-92","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#dependency-groups","content":"If no `groups` are specified, the root belongs to the implicit `default` group. Plain install\nselects every group. `--only` and `--without` cannot be combined, and unknown groups fail before\nmutation."},"893":{"id":"/cli-reference/install-command-93","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#skills-lock-file","content":"The `skills.lock` file ensures reproducible installations across environments."},"894":{"id":"/cli-reference/install-command-94","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#lock-contents","content":"FastSkill generates `skills.lock` with selected origins, resolved versions and Git\ncommits, content integrity evidence, dependency edges, groups, covered roots, and\nownership. Do not hand-write a partial lock. See\nmanifests and locks for the restoration contract."},"895":{"id":"/cli-reference/install-command-95","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#lock-file-usage","content":"**Development Mode** (with `skill-project.toml`):"},"896":{"id":"/cli-reference/install-command-96","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#lock-file-usage","content":"**Production Mode** (with `skills.lock`):"},"897":{"id":"/cli-reference/install-command-97","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#dependency-resolution","content":"`project install` resolves dependencies from multiple origins:"},"898":{"id":"/cli-reference/install-command-98","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#repository-priority","content":"Skills are resolved from repositories configured in `[tool.fastskill.repositories]`:"},"899":{"id":"/cli-reference/install-command-99","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#repository-priority","content":"Lower priority numbers take precedence. In this example, `public-registry` (priority 0) is checked before `team-registry` (priority 1)."},"900":{"id":"/cli-reference/install-command-100","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#missing-lock-file","content":"**Solution**: Run `fastskill project install` without `--lock` to create the lockfile first."},"901":{"id":"/cli-reference/install-command-101","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#missing-skill-projecttoml","content":"**Solution**: Run `fastskill project init` to create `skill-project.toml` or use `fastskill skill add` to add individual skills."},"902":{"id":"/cli-reference/install-command-102","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#unresolved-dependencies","content":"**Solution**: Check the skill ID and ensure repositories are configured correctly with `fastskill repo`."},"903":{"id":"/cli-reference/install-command-103","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#conflicting-group-flags","content":"**Solution**: Use either `--without` or `--only`, but not both at the same time."},"904":{"id":"/cli-reference/install-command-104","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#1-commit-both-skill-projecttoml-and-skillslock","content":"Always commit both files to version control. This ensures all team members install the same versions."},"905":{"id":"/cli-reference/install-command-105","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#2-use-groups-for-environment-specific-dependencies","content":"Separate dev, test, and production dependencies into groups. Use `--without dev` for production builds."},"906":{"id":"/cli-reference/install-command-106","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#3-run-fastskill-project-install-before-committing","content":"Run `fastskill project install` after modifying `skill-project.toml` to update `skills.lock` with new versions."},"907":{"id":"/cli-reference/install-command-107","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#4-use---lock-for-production-deployments","content":"Always use `--lock` flag in production to ensure exact version matches."},"908":{"id":"/cli-reference/install-command-108","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#5-index-only-when-using-semantic-search","content":"If an embedding provider is configured, use `fastskill index rebuild` when needed.\nKeyword search with `--local --embedding false` works without an index."},"909":{"id":"/cli-reference/install-command-109","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#see-also","content":"Update Command - Update skills to latest versions"},"910":{"id":"/cli-reference/install-command-110","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#see-also","content":"Add Command - Add individual skills to project"},"911":{"id":"/cli-reference/install-command-111","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#see-also","content":"`repo` commands - Manage skill repositories"},"912":{"id":"/cli-reference/install-command-112","page_id":"/cli-reference/install-command","tags":[],"type":"text","url":"/cli-reference/install-command#see-also","content":"Manifest System - Understanding skill-project.toml"},"913":{"id":"/cli-reference/managed-command","page_id":"/cli-reference/managed-command","type":"page","content":"managed Command","breadcrumbs":["Docs","Reference","CLI commands","Operations"],"tags":[],"url":"/cli-reference/managed-command"},"914":{"id":"/cli-reference/managed-command-0","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command","content":"Keep this user's agent skills in line with a signed managed state using fastskill managed."},"915":{"id":"/cli-reference/managed-command-1","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#managed-command","content":"managed Command"},"916":{"id":"/cli-reference/managed-command-2","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#usage","content":"Usage"},"917":{"id":"/cli-reference/managed-command-3","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#settings","content":"Settings"},"918":{"id":"/cli-reference/managed-command-4","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#sources","content":"Sources"},"919":{"id":"/cli-reference/managed-command-5","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"Fields only an `https://` source honors"},"920":{"id":"/cli-reference/managed-command-6","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#the-report","content":"The report"},"921":{"id":"/cli-reference/managed-command-7","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#subcommands","content":"Subcommands"},"922":{"id":"/cli-reference/managed-command-8","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#enroll","content":"enroll"},"923":{"id":"/cli-reference/managed-command-9","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#apply","content":"apply"},"924":{"id":"/cli-reference/managed-command-10","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#status","content":"status"},"925":{"id":"/cli-reference/managed-command-11","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#unenroll","content":"unenroll"},"926":{"id":"/cli-reference/managed-command-12","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#hooks","content":"hooks"},"927":{"id":"/cli-reference/managed-command-13","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#keeping-up-to-date","content":"Keeping up to date"},"928":{"id":"/cli-reference/managed-command-14","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#installs-and-other-commands","content":"Installs and other commands"},"929":{"id":"/cli-reference/managed-command-15","page_id":"/cli-reference/managed-command","type":"heading","tags":[],"url":"/cli-reference/managed-command#the-quarantine","content":"The quarantine"},"930":{"id":"/cli-reference/managed-command-16","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#managed-command","content":"Follow a **managed state**: a signed list of the skills one user's agents on this machine\nshould have, decided somewhere else. FastSkill checks its signature against keys pinned in\ntrusted settings, then deploys the listed skills into each agent's user skills folder, removes\nthe ones it put there that are no longer listed, and moves blocked content into a quarantine\ninstead of deleting it."},"931":{"id":"/cli-reference/managed-command-17","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#managed-command","content":"Only FastSkill's own entries are changed. A skill folder that FastSkill didn't place and that\nholds other content than the state lists is reported as a collision and left alone."},"932":{"id":"/cli-reference/managed-command-18","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#managed-command","content":"The envelope and the payload are documented in Managed state.\nWhat an administrator pins through device management, and what FastSkill can't enforce, is in\nHardening managed machines."},"933":{"id":"/cli-reference/managed-command-19","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#settings","content":"The source and the signing keys come only from two files, never from a project:"},"934":{"id":"/cli-reference/managed-command-20","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#settings","content":"the system file, deployed by device management: `/etc/fastskill/managed.toml` (Linux),\n`/Library/Application Support/FastSkill/managed.toml` (macOS) or\n`%ProgramData%\\FastSkill\\managed.toml` (Windows). It must be owned by the administrator and\nwritable by nobody else;"},"935":{"id":"/cli-reference/managed-command-21","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#settings","content":"the user file, `managed.toml` in FastSkill's configuration folder."},"936":{"id":"/cli-reference/managed-command-22","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#settings","content":"A value in the system file wins over the same value in the user file."},"937":{"id":"/cli-reference/managed-command-23","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#sources","content":"The source is either a local file or an `https://` URL."},"938":{"id":"/cli-reference/managed-command-24","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#sources","content":"**A file source** reads the state from a path. The skill archives it lists are read from paths\nnext to it, or from absolute paths."},"939":{"id":"/cli-reference/managed-command-25","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#sources","content":"**An `https://` source** fetches the state from the URL, and each listed skill archive from\nits `https://` URL. Redirects to anything but `https://` are refused. The state can be at most\n8 MiB and each archive at most 512 MiB."},"940":{"id":"/cli-reference/managed-command-26","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#sources","content":"When the source needs a sign-in, name a credential command:"},"941":{"id":"/cli-reference/managed-command-27","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#sources","content":"The command runs without a shell, from FastSkill's configuration folder, for at most 30\nseconds. The first line it prints, at most 16 KiB, is the token, sent as\n`Authorization: Bearer <token>`. The token is never stored or printed, and it is sent only to\nthe source's origin (scheme, host and port): a request to another origin, including a redirect\nto one, goes without it. When there is a terminal, the command can prompt on it; without one,\nsuch as from an agent hook, `FASTSKILL_INTERACTIVE=0` is set so it can fail at once instead of\nwaiting."},"942":{"id":"/cli-reference/managed-command-28","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#sources","content":"When the command fails, or the source answers `401`, apply uses the last accepted state and\nreports **sign-in needed**; run `fastskill managed apply` in a terminal to sign in again."},"943":{"id":"/cli-reference/managed-command-29","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"State field"},"944":{"id":"/cli-reference/managed-command-30","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"What it does"},"945":{"id":"/cli-reference/managed-command-31","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"`report_url`"},"946":{"id":"/cli-reference/managed-command-32","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"Where each apply sends its report. Must be on the source's origin."},"947":{"id":"/cli-reference/managed-command-33","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"`request_url`"},"948":{"id":"/cli-reference/managed-command-34","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"A link template with `{digest}`, shown when an install is refused, so people can ask for the skill. Must be on the source's origin."},"949":{"id":"/cli-reference/managed-command-35","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"`editable`"},"950":{"id":"/cli-reference/managed-command-36","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"`blocked-only` (default) lets editable local skills skip the allow-list; `refused` refuses them when only listed skills are allowed."},"951":{"id":"/cli-reference/managed-command-37","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#fields-only-an-https-source-honors","content":"A `report_url` or `request_url` on another origin is ignored with a warning. A file source\nignores all three, and `fastskill managed status` names each one it ignores."},"952":{"id":"/cli-reference/managed-command-38","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"When the state names a `report_url`, each apply sends a JSON report to it, signed in with the\nsame token. The body is fixed and holds no prompts, file contents, paths, usernames, project\nnames or repository URLs:"},"953":{"id":"/cli-reference/managed-command-39","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"`format_version`, `machine_id` and `sequence`, which goes up by one with each report;"},"954":{"id":"/cli-reference/managed-command-40","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"`issued_at` of the state applied and whether the apply `completed`;"},"955":{"id":"/cli-reference/managed-command-41","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"the covered `agents`, by name;"},"956":{"id":"/cli-reference/managed-command-42","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"every skill entry in the agent folders: its id, digest, whether FastSkill placed it\n(`origin_kind`), whether it is an editable local skill, and its outcome (`deployed`,\n`adopted`, `collision`, `quarantined` or `unmanaged`);"},"957":{"id":"/cli-reference/managed-command-43","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"the `quarantine`, and what this apply quarantined (`quarantined_now`), by id, digest and\nreason;"},"958":{"id":"/cli-reference/managed-command-44","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"`refusals`: installs the state refused since the last accepted report, by digest and command\nname, never its arguments;"},"959":{"id":"/cli-reference/managed-command-45","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"`project_skills`: the ids and digests in the current project's skills folder."},"960":{"id":"/cli-reference/managed-command-46","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-report","content":"`fastskill managed status --json --report` prints the body the next report would carry, without\nsending it."},"961":{"id":"/cli-reference/managed-command-47","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#enroll","content":"Enroll this user with the configured source and apply its first state. Enrolling again with the\nsame source keeps the machine id. Enrolling also registers the session-start hooks and installs\nthe timer (see Keeping up to date)."},"962":{"id":"/cli-reference/managed-command-48","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#apply","content":"Apply the newest signed state. When the system file names the source, the first apply enrolls\nthis user. Without network access to the source, the last accepted state is used and the report\nsays so. An expired state adds, changes and removes nothing, but blocked content is still\nquarantined."},"963":{"id":"/cli-reference/managed-command-49","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#apply","content":"Only one apply runs at a time for a user. A second apply started from a terminal says so; one\nstarted without a terminal, such as from an agent hook, exits quietly. An apply that couldn't\ncomplete every step exits with an error after its report."},"964":{"id":"/cli-reference/managed-command-50","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#status","content":"Show the source, the machine id, the state's subject and expiry, whether a sign-in is needed,\nthe fields this source ignores, where reports go, the last apply's targets, collisions and\nwarnings, and the quarantine. Nothing is changed."},"965":{"id":"/cli-reference/managed-command-51","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#unenroll","content":"Remove what managed state put on this machine for this user: the skills FastSkill deployed (a\ndeployed copy that was changed is quarantined instead), the stored skills, the cached state,\nthe records and the user settings file. The quarantine is kept. Refused when the system file\nsets `required = true`, and while an apply runs. The session-start hooks and the timer are\nremoved too."},"966":{"id":"/cli-reference/managed-command-52","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#hooks","content":"Show this user's session-start hook for each agent that supports one, and the timer. With\n`--system`, print instead what an administrator installs for every user: the entry to merge\ninto each agent's administrator-level settings, and the machine-wide timer files and commands.\nNothing is written."},"967":{"id":"/cli-reference/managed-command-53","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#hooks","content":"**Options** (every subcommand):"},"968":{"id":"/cli-reference/managed-command-54","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#hooks","content":"`--json`: Print the result as JSON"},"969":{"id":"/cli-reference/managed-command-55","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#keeping-up-to-date","content":"Two things run `managed apply` without anyone typing it:"},"970":{"id":"/cli-reference/managed-command-56","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#keeping-up-to-date","content":"**Session-start hooks.** Every apply registers a hook in the user settings of each covered\nagent that can run a command when a session starts (Claude Code and Gemini CLI), and removes\nit from agents no longer covered. The hook starts an apply in the background and returns at\nonce. It prints nothing unless the user must act, such as to sign in, and then one notice.\nClaude Code asks the user to approve a new hook once; the apply that adds it says so. An\nagent whose administrator-level settings already hold the hook gets no user-level one."},"971":{"id":"/cli-reference/managed-command-57","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#keeping-up-to-date","content":"**A timer.** Enrolling, including the first apply that enrolls, installs a timer that applies\nshortly after login and then every hour, each time after a random wait of up to 10 minutes:\na systemd user timer on Linux, a launchd agent on macOS, and a scheduled task on Windows. No\nuser timer is installed when a machine-wide one is present. Set `FASTSKILL_MANAGED_TIMER=off`\nto install none, for example on a machine without a user service manager."},"972":{"id":"/cli-reference/managed-command-58","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#keeping-up-to-date","content":"A hook or timer that can't be installed is a warning in the apply's report, not a failure."},"973":{"id":"/cli-reference/managed-command-59","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"While this user follows a state, every command that adds or replaces skill content checks it\nfirst, before anything changes: `skill add`, `skill update`, `bundle add`, `bundle update`,\n`bundle override` (and resetting one), `project install` and restoring personal overrides. The\nsame check applies to `server serve` and `mcp serve`. Content whose digest is blocked is\nrefused, and when the state allows only the listed skills, so is anything it doesn't list. An\neditable local skill changes with every edit, so it skips the list, but never the block."},"974":{"id":"/cli-reference/managed-command-60","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"Other commands that read or change skills follow the state too:"},"975":{"id":"/cli-reference/managed-command-61","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"Situation"},"976":{"id":"/cli-reference/managed-command-62","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"`managed`, `cache`, `repo`, `cli`"},"977":{"id":"/cli-reference/managed-command-63","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"Commands that read skills"},"978":{"id":"/cli-reference/managed-command-64","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"Commands that change content"},"979":{"id":"/cli-reference/managed-command-65","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"Expired state"},"980":{"id":"/cli-reference/managed-command-66","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"run"},"981":{"id":"/cli-reference/managed-command-67","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"run, with a warning"},"982":{"id":"/cli-reference/managed-command-68","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"refused"},"983":{"id":"/cli-reference/managed-command-69","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"No valid state, `required = true`"},"984":{"id":"/cli-reference/managed-command-70","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"run"},"985":{"id":"/cli-reference/managed-command-71","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"refused"},"986":{"id":"/cli-reference/managed-command-72","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"refused"},"987":{"id":"/cli-reference/managed-command-73","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"No valid state, not required"},"988":{"id":"/cli-reference/managed-command-74","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"run"},"989":{"id":"/cli-reference/managed-command-75","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"run, with a warning"},"990":{"id":"/cli-reference/managed-command-76","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"run, with a warning"},"991":{"id":"/cli-reference/managed-command-77","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#installs-and-other-commands","content":"`skill list` reports installed content the state blocks as `managed-blocked`, and content it\ndoesn't allow as `managed-not-allowed`; `skill list --check` fails on both. See\nreconciliation."},"992":{"id":"/cli-reference/managed-command-78","page_id":"/cli-reference/managed-command","tags":[],"type":"text","url":"/cli-reference/managed-command#the-quarantine","content":"Content is moved, not deleted, when its digest is blocked, when the state allows only the\nlisted skills and claims the agent folders exclusively, or when a copy FastSkill deployed was\nchanged and is no longer listed. Each item keeps its former location, its digest and the\nreason, and `fastskill managed status` lists them."},"993":{"id":"/cli-reference/optimize-command","page_id":"/cli-reference/optimize-command","type":"page","content":"optimization commands","breadcrumbs":["Docs","Reference","CLI commands","Quality"],"tags":[],"url":"/cli-reference/optimize-command"},"994":{"id":"/cli-reference/optimize-command-0","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command","content":"Run, resume, inspect, and export text-gradient skill optimization runs."},"995":{"id":"/cli-reference/optimize-command-1","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#overview","content":"Overview"},"996":{"id":"/cli-reference/optimize-command-2","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#usage","content":"Usage"},"997":{"id":"/cli-reference/optimize-command-3","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#optimization-run","content":"optimization run"},"998":{"id":"/cli-reference/optimize-command-4","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#optimization-resume","content":"optimization resume"},"999":{"id":"/cli-reference/optimize-command-5","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#optimization-status","content":"optimization status"},"1000":{"id":"/cli-reference/optimize-command-6","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#optimization-inspect","content":"optimization inspect"},"1001":{"id":"/cli-reference/optimize-command-7","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#optimization-export","content":"optimization export"},"1002":{"id":"/cli-reference/optimize-command-8","page_id":"/cli-reference/optimize-command","type":"heading","tags":[],"url":"/cli-reference/optimize-command#see-also","content":"See also"},"1003":{"id":"/cli-reference/optimize-command-9","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#overview","content":"`fastskill optimization` improves a skill document iteratively: each step scores the current `SKILL.md` against your eval suite, proposes patches, and keeps the best candidate. Subcommands are `run`, `resume`, `status`, `inspect`, and `export`. For the config file format and a walkthrough, see Optimization."},"1004":{"id":"/cli-reference/optimize-command-10","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#overview","content":"`optimization run` scores candidates with the same agent runtimes as `fastskill eval run`, so the\nagent named in the configuration must be on `PATH`. Use\n`fastskill eval validate --agent <key>` to verify availability."},"1005":{"id":"/cli-reference/optimize-command-11","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"Starts an optimization run from a config file."},"1006":{"id":"/cli-reference/optimize-command-12","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"Option"},"1007":{"id":"/cli-reference/optimize-command-13","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"Description"},"1008":{"id":"/cli-reference/optimize-command-14","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"`--config <PATH>`"},"1009":{"id":"/cli-reference/optimize-command-15","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"**Required.** Path to the optimize config file"},"1010":{"id":"/cli-reference/optimize-command-16","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"`--out-dir <DIR>`"},"1011":{"id":"/cli-reference/optimize-command-17","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"Override `out_dir` from the config file"},"1012":{"id":"/cli-reference/optimize-command-18","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"`--resume <RUN-DIR>`"},"1013":{"id":"/cli-reference/optimize-command-19","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"Resume from this run directory instead of starting fresh"},"1014":{"id":"/cli-reference/optimize-command-20","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"`--no-isolation`"},"1015":{"id":"/cli-reference/optimize-command-21","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-run","content":"Score in a shared workspace against the ambient agent environment (disables per-case scoring isolation)"},"1016":{"id":"/cli-reference/optimize-command-22","page_id":"/cli-reference/optimize-command","tags":[],"type":"text","url":"/cli-reference/optimize-command#optimization-resume","content":"Resumes an interrupted run in place."},"1017":{"id":"/cli-reference/optimize-command-23","page_id":"/cli-reference/optimize-co