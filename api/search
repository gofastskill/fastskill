436":{"id":"/configuration/init-command-22","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"**Skill-level**: run in a directory containing `SKILL.md` — writes a `[metadata]` section for skill authors. `skills_directory` is optional."},"437":{"id":"/configuration/init-command-23","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#overview","content":"**Project-level**: run at a project root — writes `[dependencies]` for skill consumers. A skills directory is required (via `--skills-dir`, or the prompt)."},"438":{"id":"/configuration/init-command-24","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Checks for an existing file**: refuses to overwrite `skill-project.toml` unless `--force` is given."},"439":{"id":"/configuration/init-command-25","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Reads `SKILL.md`** (if present): pulls `version`, `description`, and `author` from the frontmatter."},"440":{"id":"/configuration/init-command-26","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Resolves missing fields**: from CLI flags, or by prompting (unless `--yes`)."},"441":{"id":"/configuration/init-command-27","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Writes `skill-project.toml`**: with `[metadata]`, `[dependencies]`, and — when a skills directory is set — `[tool.fastskill]`."},"442":{"id":"/configuration/init-command-28","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#what-it-does","content":"**Validates**: the skill ID (derived from the directory name) and the version (must be valid semver)."},"443":{"id":"/configuration/init-command-29","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#interactive-setup","content":"Prompts for each missing field. For example, at a project root:"},"444":{"id":"/configuration/init-command-30","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#non-interactive-setup","content":"At a project root, `--yes` requires `--skills-dir <path>`. Without it, either drop `--yes` to be prompted or pass the flag."},"445":{"id":"/configuration/init-command-31","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Option"},"446":{"id":"/configuration/init-command-32","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Description"},"447":{"id":"/configuration/init-command-33","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Default"},"448":{"id":"/configuration/init-command-34","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--yes`"},"449":{"id":"/configuration/init-command-35","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Skip interactive prompts and use defaults"},"450":{"id":"/configuration/init-command-36","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`false`"},"451":{"id":"/configuration/init-command-37","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--force`"},"452":{"id":"/configuration/init-command-38","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Overwrite an existing `skill-project.toml`"},"453":{"id":"/configuration/init-command-39","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`false`"},"454":{"id":"/configuration/init-command-40","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--set-version <VER>`"},"455":{"id":"/configuration/init-command-41","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Set the skill version (validated as semver)"},"456":{"id":"/configuration/init-command-42","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"from `SKILL.md`, else `1.0.0`"},"457":{"id":"/configuration/init-command-43","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--description <TEXT>`"},"458":{"id":"/configuration/init-command-44","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Set the description"},"459":{"id":"/configuration/init-command-45","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"from `SKILL.md`, else empty"},"460":{"id":"/configuration/init-command-46","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--author <NAME>`"},"461":{"id":"/configuration/init-command-47","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Set the author"},"462":{"id":"/configuration/init-command-48","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"from `SKILL.md`, else empty"},"463":{"id":"/configuration/init-command-49","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--download-url <URL>`"},"464":{"id":"/configuration/init-command-50","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Set the download URL"},"465":{"id":"/configuration/init-command-51","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"empty"},"466":{"id":"/configuration/init-command-52","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`--skills-dir <DIR>`"},"467":{"id":"/configuration/init-command-53","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"Skills directory (global flag)"},"468":{"id":"/configuration/init-command-54","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#command-options","content":"`.claude/skills`"},"469":{"id":"/configuration/init-command-55","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#the-file-it-creates","content":"At a project root, `project init` produces a `skill-project.toml` like:"},"470":{"id":"/configuration/init-command-56","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#the-file-it-creates","content":"The commented block is written verbatim so you can uncomment and fill in embedding settings or repositories later."},"471":{"id":"/configuration/init-command-57","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#skills-directory","content":"**Default**: `.claude/skills`"},"472":{"id":"/configuration/init-command-58","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#skills-directory","content":"**Custom**: any path you pass via `--skills-dir` or the prompt"},"473":{"id":"/configuration/init-command-59","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#skills-directory","content":"**Resolution at runtime**: `--skills-dir` flag > `--global` (`~/.config/fastskill/skills`) > `skills_directory` under `[tool.fastskill]` > walk up to an existing `.claude/skills/` > default `.claude/skills/`"},"474":{"id":"/configuration/init-command-60","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#schema-version","content":"`project init` writes the current manifest schema. Use the generated file as the\nstarting point and keep project configuration in version control."},"475":{"id":"/configuration/init-command-61","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#embedding-configuration","content":"Semantic search uses OpenAI-compatible embeddings, configured under `[tool.fastskill.embedding]` in `skill-project.toml` (not created by `project init` — add it when you need it):"},"476":{"id":"/configuration/init-command-62","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#embedding-configuration","content":"Set the API key via the environment; if it is unset, semantic search is silently skipped:"},"477":{"id":"/configuration/init-command-63","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`skill-project.toml` is committed and shared by everyone on the project, so it is\nthe wrong place to record that *your* machine — or one CI job — talks to a\ndifferent embedding endpoint. Both non-secret fields can be overridden from the\nenvironment, and the environment wins:"},"478":{"id":"/configuration/init-command-64","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"Variable"},"479":{"id":"/configuration/init-command-65","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"Overrides"},"480":{"id":"/configuration/init-command-66","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"Example"},"481":{"id":"/configuration/init-command-67","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`OPENAI_BASE_URL`"},"482":{"id":"/configuration/init-command-68","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`openai_base_url`"},"483":{"id":"/configuration/init-command-69","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`https://gateway.internal/v1`"},"484":{"id":"/configuration/init-command-70","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`FASTSKILL_EMBEDDING_MODEL`"},"485":{"id":"/configuration/init-command-71","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`embedding_model`"},"486":{"id":"/configuration/init-command-72","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"`my-embed-model`"},"487":{"id":"/configuration/init-command-73","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"An empty or whitespace-only value counts as unset, so a blank variable in a shell\nprofile or CI matrix will not silently blank out a working manifest setting."},"488":{"id":"/configuration/init-command-74","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"Run `fastskill cli doctor` to see which endpoint and model are actually in effect:"},"489":{"id":"/configuration/init-command-75","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"**Changing the embedding model invalidates your index.** Vectors from different\nmodels are not comparable — and often not even the same length. After switching\nmodels, run `fastskill index rebuild` before searching, or results will be meaningless."},"490":{"id":"/configuration/init-command-76","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#pointing-at-a-different-endpoint","content":"The API key stays environment-only on purpose: a committed manifest is the wrong\nhome for a secret."},"491":{"id":"/configuration/init-command-77","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#skill-projecttoml-already-exists-use---force-to-overwrite","content":"**Cause**: a `skill-project.toml` is already present.\n**Solution**: pass `--force` to overwrite it, or remove the file first."},"492":{"id":"/configuration/init-command-78","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#project-level-init-requires---skills-dir","content":"**Cause**: `--yes` was used at a project root without a skills directory.\n**Solution**: add `--skills-dir <path>`, or drop `--yes` to be prompted."},"493":{"id":"/configuration/init-command-79","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#invalid-version","content":"**Cause**: the version (from `--set-version` or `SKILL.md`) is not valid semver.\n**Solution**: use a semver string such as `1.0.0`."},"494":{"id":"/configuration/init-command-80","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#permission-denied","content":"**Cause**: the current directory is not writable.\n**Solution**: fix permissions or run in a directory where you have write access."},"495":{"id":"/configuration/init-command-81","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#next-steps-after-init","content":"**Add skills**: `fastskill skill add <skill-id>` (registry, Git, or local path)."},"496":{"id":"/configuration/init-command-82","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#next-steps-after-init","content":"**Install from the manifest**: `fastskill project install`."},"497":{"id":"/configuration/init-command-83","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#next-steps-after-init","content":"**Index for search**: `fastskill index rebuild` (requires `OPENAI_API_KEY`)."},"498":{"id":"/configuration/init-command-84","page_id":"/configuration/init-command","tags":[],"type":"text","url":"/configuration/init-command#next-steps-after-init","content":"**Search**: `fastskill skill search \"your query\"`."},"499":{"id":"/cli-reference/bundle-command","page_id":"/cli-reference/bundle-command","type":"page","content":"Bundle commands","breadcrumbs":["Docs","Share with teams"],"tags":[],"url":"/cli-reference/bundle-command"},"500":{"id":"/cli-reference/bundle-command-0","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command","content":"Build, install, update, and restore self-contained project exports."},"501":{"id":"/cli-reference/bundle-command-1","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#bundle-commands","content":"`bundle` commands"},"502":{"id":"/cli-reference/bundle-command-2","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#build-a-bundle","content":"Build a bundle"},"503":{"id":"/cli-reference/bundle-command-3","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#install-and-inspect","content":"Install and inspect"},"504":{"id":"/cli-reference/bundle-command-4","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#update-a-bundle","content":"Update a bundle"},"505":{"id":"/cli-reference/bundle-command-5","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove a bundle"},"506":{"id":"/cli-reference/bundle-command-6","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"Reuse a setup without packaging it"},"507":{"id":"/cli-reference/bundle-command-7","page_id":"/cli-reference/bundle-command","type":"heading","tags":[],"url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Legacy member overrides"},"508":{"id":"/cli-reference/bundle-command-8","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#bundle-commands","content":"Bundles turn a skill project into one versioned ZIP. The artifact contains every declared skill,\nits installed dependency closure, resource files, and content digests. A recipient can\ninstall it without access to the original repositories. On Unix systems, executable files remain\nexecutable after bundle installation; other permission bits are normalized for portability."},"509":{"id":"/cli-reference/bundle-command-9","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Complete the quickstart, then give the project an identity and version in its existing\n`skill-project.toml`:"},"510":{"id":"/cli-reference/bundle-command-10","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Every dependency becomes a bundle member. Its installed version must satisfy the declaration.\nFastSkill stops before writing an artifact when a declared dependency is\nmissing, has invalid frontmatter, or has a different version."},"511":{"id":"/cli-reference/bundle-command-11","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"Build the release:"},"512":{"id":"/cli-reference/bundle-command-12","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"The result is `dist/notes-team-1.0.0.zip`. Its embedded identity, version, membership, and\ndigests are authoritative, so renaming the download does not change the release.\nAn artifact built by an earlier release, whose digests lack the `sha256-tree-v2:` prefix, still\ninstalls with a warning; rebuild it to record current-form digests."},"513":{"id":"/cli-reference/bundle-command-13","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#build-a-bundle","content":"There is no `[bundle.members]` list to maintain. A source Manifest using the earlier `[bundle]`\nformat remains buildable for migration, while all new bundles should use `[metadata]`."},"514":{"id":"/cli-reference/bundle-command-14","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"In a second project initialized with `project init --yes --skills-dir .claude/skills`,\ninstall the artifact with `bundle add`. Replace the local path with the artifact you\nbuilt. The HTTPS URL below is an example for an artifact hosted by your team:"},"515":{"id":"/cli-reference/bundle-command-15","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Installation copies the artifact into `.fastskill/bundles/`, adds its declaration to\n`skill-project.toml`, and records the exact release and members in `skills.lock`."},"516":{"id":"/cli-reference/bundle-command-16","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Commit these files when teammates and CI need the same setup:"},"517":{"id":"/cli-reference/bundle-command-17","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"Then restore the exact locked release:"},"518":{"id":"/cli-reference/bundle-command-18","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#install-and-inspect","content":"`--lock` uses the bundle artifact, version, digest, and membership recorded in `skills.lock`.\nIt does not switch to a different release if the manifest has drifted. `--offline` additionally\nguarantees that restore does not contact a repository or embedding provider."},"519":{"id":"/cli-reference/bundle-command-19","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"Bundle updates are explicit. After building version `1.1.0` of your bundle, preview\nand apply that replacement:"},"520":{"id":"/cli-reference/bundle-command-20","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#update-a-bundle","content":"FastSkill checks the new artifact, shared ownership, local modifications, and release immutability\nbefore it changes installed members. The preview runs the same validation as apply and reports\nmembership changes even when retained member bytes are unchanged."},"521":{"id":"/cli-reference/bundle-command-21","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Remove the bundle identity and the members that have no other owner:"},"522":{"id":"/cli-reference/bundle-command-22","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#remove-a-bundle","content":"Removing a direct declaration detaches that owner. FastSkill retains the installed member while a\nbundle or another dependency root still requires it. An ID that is only a transitive requirement\ncannot be removed directly; the error names the roots that require it. A member is deleted only\nafter its final direct, transitive, or bundle owner is gone."},"523":{"id":"/cli-reference/bundle-command-23","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"A references-only bundle would duplicate a Manifest, so FastSkill uses Manifest composition for\nthat case. A consuming project references the shared file once:"},"524":{"id":"/cli-reference/bundle-command-24","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"The shared Manifest can declare skills from multiple Git repositories, configured repositories,\nZIP URLs, or shared paths. `project install` resolves the combined roots and the consuming project\nwrites the exact results to its own `skills.lock`. References may be nested. FastSkill rejects\nmissing files, reference cycles, and incompatible declarations of the same skill ID."},"525":{"id":"/cli-reference/bundle-command-25","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#reuse-a-setup-without-packaging-it","content":"Use a bundle when recipients need an offline-ready artifact. Use a composed Manifest when they\nhave access to the declared sources and should obtain the skills from those sources."},"526":{"id":"/cli-reference/bundle-command-26","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Bundles created with the earlier `[bundle.members]` format may permit a personal replacement.\nThose existing artifacts remain supported through `fastskill bundle override <skill-id> --from <directory>` and `fastskill bundle override <skill-id> --reset`. Manifest-driven builds make all\nmembers required and do not create new override policies."},"527":{"id":"/cli-reference/bundle-command-27","page_id":"/cli-reference/bundle-command","tags":[],"type":"text","url":"/cli-reference/bundle-command#legacy-member-overrides","content":"Every bundle action except `bundle list` changes files. The MCP server hides and refuses these\ntools unless it starts with `fastskill mcp serve --enable-write`."},"528":{"id":"/cli-reference/cache-command","page_id":"/cli-reference/cache-command","type":"page","content":"cache Command","breadcrumbs":["Docs","Reference","CLI commands","Operations"],"tags":[],"url":"/cli-reference/cache-command"},"529":{"id":"/cli-reference/cache-command-0","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command","content":"Inspect and reclaim the on-disk skill content cache with fastskill cache."},"530":{"id":"/cli-reference/cache-command-1","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#cache-command","content":"cache Command"},"531":{"id":"/cli-reference/cache-command-2","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#usage","content":"Usage"},"532":{"id":"/cli-reference/cache-command-3","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#subcommands","content":"Subcommands"},"533":{"id":"/cli-reference/cache-command-4","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#info","content":"info"},"534":{"id":"/cli-reference/cache-command-5","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#clean","content":"clean"},"535":{"id":"/cli-reference/cache-command-6","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#when-to-run-it","content":"When to run it"},"536":{"id":"/cli-reference/cache-command-7","page_id":"/cli-reference/cache-command","type":"heading","tags":[],"url":"/cli-reference/cache-command#see-also","content":"See Also"},"537":{"id":"/cli-reference/cache-command-8","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Inspect and reclaim the on-disk cache that `skill add`, `project install`, and `skill update` use so a skill's\ncontent is fetched once per machine instead of once per project."},"538":{"id":"/cli-reference/cache-command-9","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#cache-command","content":"Every git, registry, or local skill fetch is checked against this cache before touching the\nnetwork again. `fastskill cache` is how to see what has accumulated there and reclaim disk\nspace -- fastskill never evicts cache entries on its own."},"539":{"id":"/cli-reference/cache-command-10","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"Show the cache location plus entry counts and disk usage, broken down by source kind (git,\nregistry, or local)."},"540":{"id":"/cli-reference/cache-command-11","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Example output**:"},"541":{"id":"/cli-reference/cache-command-12","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"**Options**:"},"542":{"id":"/cli-reference/cache-command-13","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--format <table|json>`: Output format (default: table)"},"543":{"id":"/cli-reference/cache-command-14","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#info","content":"`--json`: Shorthand for `--format json` (mutually exclusive with `--format`)"},"544":{"id":"/cli-reference/cache-command-15","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"Remove cached skill content and print how many bytes were reclaimed."},"545":{"id":"/cli-reference/cache-command-16","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Options**:"},"546":{"id":"/cli-reference/cache-command-17","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--source <git|registry|local>`: Limit cleaning to one source kind (default: all)"},"547":{"id":"/cli-reference/cache-command-18","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"`--json`: Print the result as JSON instead of a summary line"},"548":{"id":"/cli-reference/cache-command-19","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**What it removes**: Only cached skill content -- the record of what a repository currently\nadvertises (what `repo refresh` writes) is left alone, so `repo refresh` output stays valid\nafter a clean. There is nothing to undo: the next `skill add`/`project install`/`skill update` that needs a removed\nentry re-fetches it from its original source."},"549":{"id":"/cli-reference/cache-command-20","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#clean","content":"**Safe with other fastskill processes running**: `clean` never removes an entry another process\nis mid-write on, and every write elsewhere is atomic. In the worst case, a fetch running at the\nexact moment of a clean simply re-fetches -- it never sees partial or corrupted content."},"550":{"id":"/cli-reference/cache-command-21","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache info`**: Before a `clean`, to see what is actually taking up space, or when disk\nusage seems higher than expected."},"551":{"id":"/cli-reference/cache-command-22","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#when-to-run-it","content":"**`cache clean`**: To reclaim disk space after finishing with skills from a source no longer\nin use, or as routine cleanup on a machine used for many short-lived projects."},"552":{"id":"/cli-reference/cache-command-23","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"`repo` commands -- refresh what a repository advertises\n(`repo refresh`), independent of the content cache `cache` manages"},"553":{"id":"/cli-reference/cache-command-24","page_id":"/cli-reference/cache-command","tags":[],"type":"text","url":"/cli-reference/cache-command#see-also","content":"Install Command -- installs that hit this cache"},"554":{"id":"/cli-reference/discovery-commands","page_id":"/cli-reference/discovery-commands","type":"page","content":"Discover and inspect skills","breadcrumbs":["Docs","Reference","CLI commands","Sources and distribution"],"tags":[],"url":"/cli-reference/discovery-commands"},"555":{"id":"/cli-reference/discovery-commands-0","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Find a catalog result, inspect its origin, and install it explicitly."},"556":{"id":"/cli-reference/discovery-commands-1","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-installed-skills","content":"Search installed skills"},"557":{"id":"/cli-reference/discovery-commands-2","page_id":"/cli-reference/discovery-commands","type":"heading","tags":[],"url":"/cli-reference/discovery-commands#search-a-catalog","content":"Search a catalog"},"558":{"id":"/cli-reference/discovery-commands-3","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands","content":"Complete the quickstart for local skills, or configure a real\ncatalog. Examples below use placeholder repository and skill IDs."},"559":{"id":"/cli-reference/discovery-commands-4","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-installed-skills","content":"Local keyword search needs no API key. Semantic search is optional and requires an\nindex and embedding provider."},"560":{"id":"/cli-reference/discovery-commands-5","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"Remote search is the default when `--local` is absent. Results identify the\ncanonical skill ID, repository, version, and installation command. Empty catalogs,\nmissing configuration, and partial failures are distinct outcomes; inspect both\nJSON diagnostics and exit status."},"561":{"id":"/cli-reference/discovery-commands-6","page_id":"/cli-reference/discovery-commands","tags":[],"type":"text","url":"/cli-reference/discovery-commands#search-a-catalog","content":"See search reference for filters and output formats,\nand repository reference for catalog operations."},"562":{"id":"/cli-reference/eval-command","page_id":"/cli-reference/eval-command","type":"page","content":"eval Command","breadcrumbs":["Docs","Reference","CLI commands","Quality"],"tags":[],"url":"/cli-reference/eval-command"},"563":{"id":"/cli-reference/eval-command-0","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command","content":"Validate, run, report, and score skill evaluation suites defined in skill-project.toml."},"564":{"id":"/cli-reference/eval-command-1","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#overview","content":"Overview"},"565":{"id":"/cli-reference/eval-command-2","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#usage","content":"Usage"},"566":{"id":"/cli-reference/eval-command-3","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-validate","content":"eval validate"},"567":{"id":"/cli-reference/eval-command-4","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-run","content":"eval run"},"568":{"id":"/cli-reference/eval-command-5","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#environment-isolation","content":"Environment isolation"},"569":{"id":"/cli-reference/eval-command-6","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-judge","content":"eval judge"},"570":{"id":"/cli-reference/eval-command-7","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-report","content":"eval report"},"571":{"id":"/cli-reference/eval-command-8","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-score","content":"eval score"},"572":{"id":"/cli-reference/eval-command-9","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#eval-scorecard","content":"eval scorecard"},"573":{"id":"/cli-reference/eval-command-10","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-metrics-file","content":"The metrics file"},"574":{"id":"/cli-reference/eval-command-11","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#identity-what-the-numbers-are-about","content":"Identity: what the numbers are about"},"575":{"id":"/cli-reference/eval-command-12","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-json-document","content":"The JSON document"},"576":{"id":"/cli-reference/eval-command-13","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#the-html-report","content":"The HTML report"},"577":{"id":"/cli-reference/eval-command-14","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#what-is-excluded-and-why","content":"What is excluded, and why"},"578":{"id":"/cli-reference/eval-command-15","page_id":"/cli-reference/eval-command","type":"heading","tags":[],"url":"/cli-reference/eval-command#see-also","content":"See also"},"579":{"id":"/cli-reference/eval-command-16","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`fastskill eval` runs skill quality checks using prompts and rubrics under `[tool.fastskill.eval]` in `skill-project.toml`. Subcommands are `validate`, `run`, `judge`, `report`, `score`, and `scorecard`."},"580":{"id":"/cli-reference/eval-command-17","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#overview","content":"`eval run` requires an agent on `PATH` for the chosen `--agent` key. Known keys are `aikit`, `claude`, `codex`, `cursor`, `gemini`, and `pi`. A key is accepted only when its CLI is detected on the current machine, so a typo and an uninstalled agent both error with `RUNTIME_UNKNOWN_ID`, which lists what was detected. Use `eval validate --agent <key>` or `--all` to verify availability."},"581":{"id":"/cli-reference/eval-command-18","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Checks eval configuration and files (optional agent presence check)."},"582":{"id":"/cli-reference/eval-command-19","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Option"},"583":{"id":"/cli-reference/eval-command-20","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Description"},"584":{"id":"/cli-reference/eval-command-21","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--agent <AGENT>`"},"585":{"id":"/cli-reference/eval-command-22","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify the given agent(s) are available; repeatable. Mutually exclusive with `--all`"},"586":{"id":"/cli-reference/eval-command-23","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--all`"},"587":{"id":"/cli-reference/eval-command-24","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Verify availability of every installed agent. Mutually exclusive with `--agent`"},"588":{"id":"/cli-reference/eval-command-25","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--model <MODEL>`"},"589":{"id":"/cli-reference/eval-command-26","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"The model `eval run` will target; a judge declaring the same one is reported as self-preference"},"590":{"id":"/cli-reference/eval-command-27","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--format <FORMAT>`"},"591":{"id":"/cli-reference/eval-command-28","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`table` or `json` only (eval does not support `grid`/`xml`)"},"592":{"id":"/cli-reference/eval-command-29","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"`--json`"},"593":{"id":"/cli-reference/eval-command-30","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Shorthand for `--format json`"},"594":{"id":"/cli-reference/eval-command-31","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"Every `[[judge]]` in the checks file is validated from file content alone, so validate gives the same answer on a laptop and in CI. Errors: no resolvable `model`; neither or both of `prompt` / `prompt_file` (likewise for the system and retry pairs); an unknown `{{variable}}`; a `cases` id matching no case; duplicate criterion names; `scale` below 2; `min_score` outside `[0, 1]`; a prompt that never renders `{{output_contract}}`; any unknown key. Warnings: a prompt without `{{rubric}}`, and a judge sharing `--model`. Endpoint reachability and API keys are not checked here — judging checks those before its first request."},"595":{"id":"/cli-reference/eval-command-32","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-validate","content":"With `--agent` or `--all`, both outputs report each selected agent:\nthe table prints one `agent '<key>': available|unavailable` line per agent, and the JSON document carries an `agents` object keyed by agent id (`{\"agents\": {\"claude\": true}}`). An unavailable agent is an error unless `fail_on_missing_agent = false` is set in the eval config."},"596":{"id":"/cli-reference/eval-command-33","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Runs eval cases against an agent; writes artifacts under `--output-dir`."},"597":{"id":"/cli-reference/eval-command-34","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <key>` (repeatable) and `--all` are mutually exclusive — passing both errors with `RUNTIME_CONFLICTING_FLAGS`. `eval run` requires one of them (passing neither errors with `RUNTIME_NO_SELECTION`)."},"598":{"id":"/cli-reference/eval-command-35","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Option"},"599":{"id":"/cli-reference/eval-command-36","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Description"},"600":{"id":"/cli-reference/eval-command-37","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"`--agent <AGENT>`"},"601":{"id":"/cli-reference/eval-command-38","page_id":"/cli-reference/eval-command","tags":[],"type":"text","url":"/cli-reference/eval-command#eval-run","content":"Agent key(s) to run; repeatable. Required unless `--all` is given"},"602":{"id":"/cli-reference/eval-command-39","page_id":"/cli-reference/eval-command","tags":[],"type":"t