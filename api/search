security/managed-machines#agents","content":"yes"},"3462":{"id":"/security/managed-machines-106","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"`/etc/devin/hooks.json`"},"3463":{"id":"/security/managed-machines-107","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3464":{"id":"/security/managed-machines-108","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Auggie"},"3465":{"id":"/security/managed-machines-109","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3466":{"id":"/security/managed-machines-110","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3467":{"id":"/security/managed-machines-111","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"`/etc/augment/settings.json`"},"3468":{"id":"/security/managed-machines-112","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3469":{"id":"/security/managed-machines-113","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Kiro, CodeBuddy, Qoder"},"3470":{"id":"/security/managed-machines-114","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3471":{"id":"/security/managed-machines-115","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3472":{"id":"/security/managed-machines-116","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"not checked"},"3473":{"id":"/security/managed-machines-117","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3474":{"id":"/security/managed-machines-118","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"IBM Bob"},"3475":{"id":"/security/managed-machines-119","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3476":{"id":"/security/managed-machines-120","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes; 10 s timeout"},"3477":{"id":"/security/managed-machines-121","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"enforced-hooks policy"},"3478":{"id":"/security/managed-machines-122","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3479":{"id":"/security/managed-machines-123","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"OpenCode, Amp, Pi, Kilo"},"3480":{"id":"/security/managed-machines-124","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3481":{"id":"/security/managed-machines-125","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"only through a plugin"},"3482":{"id":"/security/managed-machines-126","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"not checked"},"3483":{"id":"/security/managed-machines-127","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3484":{"id":"/security/managed-machines-128","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"Roo Code (archived)"},"3485":{"id":"/security/managed-machines-129","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"yes"},"3486":{"id":"/security/managed-machines-130","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"none"},"3487":{"id":"/security/managed-machines-131","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"none"},"3488":{"id":"/security/managed-machines-132","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"no"},"3489":{"id":"/security/managed-machines-133","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#agents","content":"\"Later\" means the agent watches its skills folders and picks the skill up during the session.\nFastSkill registers session-start hooks where it has verified support (today Claude Code and\nGemini CLI); every other agent is kept up to date by the timer. Agents add hooks and folders\noften, so check the agent's current documentation before relying on a row."},"3490":{"id":"/security/managed-machines-134","page_id":"/security/managed-machines","tags":[],"type":"text","url":"/security/managed-machines#several-users-on-one-machine","content":"The system file is machine-wide. Everything else is per user: the managed store, the machine id,\nthe cached state, the quarantine, the hooks and the timer. Each user enrolls and reports\nseparately."},"3491":{"id":"/security/model","page_id":"/security/model","type":"page","content":"Security Model","breadcrumbs":["Docs","Reference","Security"],"tags":[],"url":"/security/model"},"3492":{"id":"/security/model-0","page_id":"/security/model","tags":[],"type":"text","url":"/security/model","content":"How FastSkill treats trust boundaries: read-only-by-default serve, no in-app auth, env-var token indirection, and reproducible locked installs."},"3493":{"id":"/security/model-1","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#overview","content":"Overview"},"3494":{"id":"/security/model-2","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"`fastskill server serve` is read-only by default"},"3495":{"id":"/security/model-3","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#server-serve-is-not-a-security-boundary","content":"`server serve` is not a security boundary"},"3496":{"id":"/security/model-4","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#repository-credentials-env-var-indirection","content":"Repository credentials: env-var indirection"},"3497":{"id":"/security/model-5","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#reproducible-verifiable-installs","content":"Reproducible, verifiable installs"},"3498":{"id":"/security/model-6","page_id":"/security/model","type":"heading","tags":[],"url":"/security/model#what-fastskill-does-not-provide","content":"What FastSkill does not provide"},"3499":{"id":"/security/model-7","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#overview","content":"FastSkill is a skill **package manager**, not a runtime. It installs, indexes, and serves skill\ndirectories; it does **not** execute skills, so there is no sandbox, no resource governor, and no\nper-request audit log to speak of. Its security model is about two things: what the `fastskill server serve`\nHTTP surface lets a caller do, and how repository credentials are handled."},"3500":{"id":"/security/model-8","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"Per ADR-0003, `fastskill server serve` mounts **only read endpoints** unless you start it with\n`--enable-write`. Reads (list/get skills, `POST /api/v1/search`, `POST /api/v1/resolve`,\n`GET /api/v1/status`, registry browse, manifest reads, the dashboard) are always available."},"3501":{"id":"/security/model-9","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"Every state-changing endpoint — install, update, delete, reindex, registry refresh, manifest\nwrites — returns **HTTP 403** when writes are disabled:"},"3502":{"id":"/security/model-10","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#fastskill-server-serve-is-read-only-by-default","content":"\"Anything that is not a pure read is gated\" — reindex and registry refresh are included because they\nare side-effecting (disk, network, embedding-API cost), not just because they are destructive. This\nis one switch: `--enable-write` enables all mutations at once. See the\n`server serve` reference."},"3503":{"id":"/security/model-11","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"FastSkill enforces **no authentication of its own**. There is no token endpoint, and API routes\nrequire no `Authorization` or `x-api-key` header. It handles no identity and no per-user\nauthorization by design."},"3504":{"id":"/security/model-12","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"**Run it local-first.** The default bind is `localhost` — a single operator viewing their own\nskills on their own machine."},"3505":{"id":"/security/model-13","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"**Front it with an authenticating proxy if you expose it.** If the port is reachable on a shared\nor untrusted network, put a reverse proxy or sidecar in front that owns request authentication,\nand ensure the app port is not directly reachable. FastSkill will not police the bind address for\nyou, and binding a non-loopback address is the normal, expected configuration behind such a proxy."},"3506":{"id":"/security/model-14","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"Combined with the read-only default, an exposed instance started **without** `--enable-write` cannot\nbe used to mutate state even before the proxy is considered. Reaching a destructive endpoint\nunauthenticated requires the operator to have *both* enabled writes *and* exposed the port with no\nfronting proxy — a deliberate double opt-out."},"3507":{"id":"/security/model-15","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#server-serve-is-not-a-security-boundary","content":"A read-only exposed instance still **discloses skill data** to anyone who reaches it. That is the\noperator's call when they open the port; it is a disclosure consideration, not a mutation risk."},"3508":{"id":"/security/model-16","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"HTTP registries can authenticate with a **PAT or bearer token referenced by environment variable**.\nGit sources use system Git credentials. Tokens are not written into the manifest:"},"3509":{"id":"/security/model-17","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"FastSkill reads the token from `TEAM_REGISTRY_TOKEN` at runtime. Commit `skill-project.toml`; keep\nthe token in your shell profile, CI secrets, or a secrets manager. Never commit a plaintext token."},"3510":{"id":"/security/model-18","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"A registry that requires an OAuth bearer token uses `auth = { type = \"bearer\", env_var = \"…\" }`\ninstead, and FastSkill sends `Authorization: Bearer <token>`. When the token is short-lived, a\n**credential command** can print it (`auth = { type = \"command\", command = [...] }`):"},"3511":{"id":"/security/model-19","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"**Only user configuration may name a command.** It lives in `repositories.toml` in FastSkill's\nconfiguration directory. A `skill-project.toml` that names a command is refused, so a cloned\nrepository can never make FastSkill run a program."},"3512":{"id":"/security/model-20","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"**It runs without a shell**, from FastSkill's configuration directory, with a 30-second timeout,\nat most once per process for each repository. The token stays in memory; it is never written to\ndisk, logs or error messages."},"3513":{"id":"/security/model-21","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"**Non-interactive runs are flagged.** When standard input or standard error is not a terminal,\nthe command sees `FASTSKILL_INTERACTIVE=0` and must not prompt."},"3514":{"id":"/security/model-22","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"**The token stays on the registry origin.** It is sent only to the scheme, host and port of\n`index_url`. A redirect to another origin drops it, and a redirect from `https` to `http` is\nrefused."},"3515":{"id":"/security/model-23","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#repository-credentials-env-var-indirection","content":"**Missing credentials fail closed.** An unset `bearer` variable or a failing command is an error,\nnever an unauthenticated retry. `pat` keeps its existing behaviour."},"3516":{"id":"/security/model-24","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#reproducible-verifiable-installs","content":"`fastskill project install` resolves the manifest and writes a lockfile (`skills.lock`, or\n`global-skills.lock` with `--global`). `fastskill project install --lock` installs the **exact** versions\nrecorded in the lock, giving reproducible and verifiable installs for CI and locked environments.\nCommit both `skill-project.toml` and `skills.lock`."},"3517":{"id":"/security/model-25","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"To set expectations honestly, FastSkill has **no**:"},"3518":{"id":"/security/model-26","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"sandboxed execution environment (it does not run skills),"},"3519":{"id":"/security/model-27","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"resource limits or execution monitoring,"},"3520":{"id":"/security/model-28","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"built-in request audit log,"},"3521":{"id":"/security/model-29","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"in-app authentication, identity, or per-user authorization."},"3522":{"id":"/security/model-30","page_id":"/security/model","tags":[],"type":"text","url":"/security/model#what-fastskill-does-not-provide","content":"For deployed exposure, those responsibilities live in the surrounding infrastructure (proxy,\nnetwork policy, secrets management)."},"3523":{"id":"/skill-management/managed-state","page_id":"/skill-management/managed-state","type":"page","content":"Managed state","breadcrumbs":["Docs","Manage skills","Skills and projects"],"tags":[],"url":"/skill-management/managed-state"},"3524":{"id":"/skill-management/managed-state-0","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state","content":"The format of the signed managed state a machine follows: the DSSE envelope, the payload fields, what FastSkill refuses, and how a state is bound to its source and subject."},"3525":{"id":"/skill-management/managed-state-1","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#managed-state","content":"Managed state"},"3526":{"id":"/skill-management/managed-state-2","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#the-envelope","content":"The envelope"},"3527":{"id":"/skill-management/managed-state-3","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#the-payload","content":"The payload"},"3528":{"id":"/skill-management/managed-state-4","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#example","content":"Example"},"3529":{"id":"/skill-management/managed-state-5","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#what-fastskill-refuses","content":"What FastSkill refuses"},"3530":{"id":"/skill-management/managed-state-6","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#bound-to-its-source-and-subject-and-never-backwards","content":"Bound to its source and subject, and never backwards"},"3531":{"id":"/skill-management/managed-state-7","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#expiry","content":"Expiry"},"3532":{"id":"/skill-management/managed-state-8","page_id":"/skill-management/managed-state","type":"heading","tags":[],"url":"/skill-management/managed-state#producing-a-state","content":"Producing a state"},"3533":{"id":"/skill-management/managed-state-9","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#managed-state","content":"A **managed state** is a signed, resolved list of the skills one user's agents on one machine\nshould have. Something outside FastSkill decides it; FastSkill verifies it, applies it and never\ndecides it. This page is the format reference. The commands are under\n`managed`, and what an administrator pins is in\nHardening managed machines."},"3534":{"id":"/skill-management/managed-state-10","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#managed-state","content":"The envelope, the payload and the report are a\ncompatibility surface, like the reconciliation statuses: each\ncarries a format version, and within a version fields are only added, never changed or removed."},"3535":{"id":"/skill-management/managed-state-11","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"A state travels in a DSSE envelope: one JSON object."},"3536":{"id":"/skill-management/managed-state-12","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"`payloadType` is exactly `application/vnd.fastskill.managed-state+json`."},"3537":{"id":"/skill-management/managed-state-13","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"`payload` is the payload's exact bytes in base64: standard or URL-safe alphabet, padded or not."},"3538":{"id":"/skill-management/managed-state-14","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"Each signature is Ed25519 over DSSE's pre-authentication encoding of the payload type and the\npayload bytes, `DSSEv1 <length of type> <type> <length of payload> <payload>`, with the lengths\nin ASCII decimal. No JSON is canonicalized: the signer signs the bytes it puts in `payload`."},"3539":{"id":"/skill-management/managed-state-15","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"`keyid` names a pinned key. FastSkill accepts the envelope when at least one signature names a\npinned key id and verifies against that key. Signatures that name no pinned key are ignored."},"3540":{"id":"/skill-management/managed-state-16","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"An envelope larger than 8 MiB is refused."},"3541":{"id":"/skill-management/managed-state-17","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-envelope","content":"Keys are pinned in trusted settings only; they are\nnever fetched from the source. Several keys can be pinned at once, so pin a new key before the\nsource starts signing with it, and unpin a key to revoke it. FastSkill verifies the cached state\nevery time it uses it, so a state signed only by an unpinned key stops counting at once."},"3542":{"id":"/skill-management/managed-state-18","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"The payload is a JSON object. Its `format_version` is `1`; a state with any other value is refused\nwith a message to update FastSkill, before anything else is read."},"3543":{"id":"/skill-management/managed-state-19","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Field"},"3544":{"id":"/skill-management/managed-state-20","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Required"},"3545":{"id":"/skill-management/managed-state-21","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Meaning"},"3546":{"id":"/skill-management/managed-state-22","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`format_version`"},"3547":{"id":"/skill-management/managed-state-23","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"yes"},"3548":{"id":"/skill-management/managed-state-24","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`1`."},"3549":{"id":"/skill-management/managed-state-25","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`issued_at`"},"3550":{"id":"/skill-management/managed-state-26","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"yes"},"3551":{"id":"/skill-management/managed-state-27","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"When the state was issued, RFC 3339."},"3552":{"id":"/skill-management/managed-state-28","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`expires_at`"},"3553":{"id":"/skill-management/managed-state-29","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"yes"},"3554":{"id":"/skill-management/managed-state-30","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"When it expires, RFC 3339."},"3555":{"id":"/skill-management/managed-state-31","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`source`"},"3556":{"id":"/skill-management/managed-state-32","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"yes"},"3557":{"id":"/skill-management/managed-state-33","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"The managed source it was issued for: the configured `source`, exactly."},"3558":{"id":"/skill-management/managed-state-34","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`subject`"},"3559":{"id":"/skill-management/managed-state-35","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"yes"},"3560":{"id":"/skill-management/managed-state-36","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"An opaque label. FastSkill displays it and compares it for equality, never interprets it."},"3561":{"id":"/skill-management/managed-state-37","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`skills`"},"3562":{"id":"/skill-management/managed-state-38","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3563":{"id":"/skill-management/managed-state-39","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"The skills to install. Each entry has an `id`, a `digest` and an `artifact`."},"3564":{"id":"/skill-management/managed-state-40","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`allowed`"},"3565":{"id":"/skill-management/managed-state-41","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"yes"},"3566":{"id":"/skill-management/managed-state-42","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`listed`: only digests in `skills` or `also_allowed` may be installed. `any`: anything that isn't blocked."},"3567":{"id":"/skill-management/managed-state-43","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`also_allowed`"},"3568":{"id":"/skill-management/managed-state-44","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3569":{"id":"/skill-management/managed-state-45","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Digests that may be installed but that the state doesn't install."},"3570":{"id":"/skill-management/managed-state-46","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`blocked`"},"3571":{"id":"/skill-management/managed-state-47","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3572":{"id":"/skill-management/managed-state-48","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Digests that must not be present, each with an optional `message` for the user."},"3573":{"id":"/skill-management/managed-state-49","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`exclusive_targets`"},"3574":{"id":"/skill-management/managed-state-50","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3575":{"id":"/skill-management/managed-state-51","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"With `allowed = listed`, `true` makes apply quarantine content in an agent folder whose digest isn't allowed, instead of leaving it alone. Default `false`."},"3576":{"id":"/skill-management/managed-state-52","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`report_url`"},"3577":{"id":"/skill-management/managed-state-53","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3578":{"id":"/skill-management/managed-state-54","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Where each apply sends its report."},"3579":{"id":"/skill-management/managed-state-55","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`editable`"},"3580":{"id":"/skill-management/managed-state-56","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3581":{"id":"/skill-management/managed-state-57","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`blocked-only` (default) or `refused`: whether editable local skills skip the allow-list."},"3582":{"id":"/skill-management/managed-state-58","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`request_url`"},"3583":{"id":"/skill-management/managed-state-59","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"no"},"3584":{"id":"/skill-management/managed-state-60","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"A link template with one `{digest}`, shown when an install is refused."},"3585":{"id":"/skill-management/managed-state-61","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`report_url`, `editable` and `request_url` take effect only with an `https://` source; see\nthe fields only an `https://` source honors."},"3586":{"id":"/skill-management/managed-state-62","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"A `skills` entry has:"},"3587":{"id":"/skill-management/managed-state-63","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`id`: the skill's id, one safe path component. It must equal the identity of the content the\narchive holds."},"3588":{"id":"/skill-management/managed-state-64","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`digest`: the skill's content digest in the current `sha256-tree-v2:` form. It must equal the\ndigest of the extracted archive."},"3589":{"id":"/skill-management/managed-state-65","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"`artifact`: where the skill's ZIP archive is. An `https://` URL; for a file source, also a path\nnext to the state or an absolute path."},"3590":{"id":"/skill-management/managed-state-66","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#the-payload","content":"Entries are resolved content, like a Lock, not intent, like a Manifest. Applying a state never\nresolves versions, reads repositories or runs dependency resolution: `managed apply` installs\nexactly `skills`. A skill whose declared dependencies aren't in the state is still installed, and\napply reports the missing dependencies."},"3591":{"id":"/skill-management/managed-state-67","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"The whole state is refused when any of these is true:"},"3592":{"id":"/skill-management/managed-state-68","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"its format version isn't `1`"},"3593":{"id":"/skill-management/managed-state-69","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"a digest is in `blocked` and also in `skills` or `also_allowed`"},"3594":{"id":"/skill-management/managed-state-70","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"two `skills` entries share an id"},"3595":{"id":"/skill-management/managed-state-71","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"an id isn't a safe skill id: one path component, under the same rules as any skill id"},"3596":{"id":"/skill-management/managed-state-72","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"a digest isn't in the current content digest form; the older bare-hex form is never accepted\nhere, because two different trees could share it"},"3597":{"id":"/skill-management/managed-state-73","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"an `artifact`, `report_url` or `request_url` isn't `https://` (a file source may use local\npaths for artifacts)"},"3598":{"id":"/skill-management/managed-state-74","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"`editable` has a value other than `blocked-only` or `refused`"},"3599":{"id":"/skill-management/managed-state-75","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#what-fastskill-refuses","content":"When it installs a skill, apply also requires that the downloaded content's digest equals the\nentry's `digest` and that the content's own identity equals the entry's `id`."},"3600":{"id":"/skill-management/managed-state-76","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#bound-to-its-source-and-subject-and-never-backwards","content":"**Source.** `source` must equal the configured managed source. A state issued for another source\nis refused, even when a pinned key signed it."},"3601":{"id":"/skill-management/managed-state-77","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#bound-to-its-source-and-subject-and-never-backwards","content":"**Subject.** FastSkill records the `subject` of the first state it accepts after enrollment.\nLater states with a different subject are refused until `fastskill managed enroll` runs again,\nso a state issued for one user can't be swapped in for another's."},"3602":{"id":"/skill-management/managed-state-78","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#bound-to-its-source-and-subject-and-never-backwards","content":"**No rollback.** FastSkill records the highest `issued_at` it has accepted and refuses any state\nissued earlier. Receiving the same state again is fine."},"3603":{"id":"/skill-management/managed-state-79","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#bound-to-its-source-and-subject-and-never-backwards","content":"**Clock skew.** A state whose `issued_at` is more than five minutes ahead of the local clock is\nrefused."},"3604":{"id":"/skill-management/managed-state-80","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#expiry","content":"FastSkill keeps the last valid state and uses it offline until it expires. After expiry, commands\nthat add or change skill content are refused, and `managed apply` adds, changes and removes\nnothing, though blocked content is still quarantined. Nothing is removed because of expiry alone,\nand expiry is checked against the local clock. The next accepted state ends the condition."},"3605":{"id":"/skill-management/managed-state-81","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#producing-a-state","content":"FastSkill ships no signer and serves no managed state. Any tool that writes JSON and signs with\nan Ed25519 key can produce one:"},"3606":{"id":"/skill-management/managed-state-82","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#producing-a-state","content":"Resolve the skills: for each, its id, its content digest, and a ZIP archive of its folder at\nthat digest, placed where `artifact` will point."},"3607":{"id":"/skill-management/managed-state-83","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#producing-a-state","content":"Write the payload with `issued_at` now, an `expires_at` that leaves machines time to fetch the\nnext state, and the `source` the machines are configured with."},"3608":{"id":"/skill-management/managed-state-84","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#producing-a-state","content":"Sign the pre-authentication encoding of the payload type and the payload bytes with the private\nkey, and wrap the payload and the signature in the envelope under the key's pinned id."},"3609":{"id":"/skill-management/managed-state-85","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#producing-a-state","content":"Publish the envelope at the source, next to the archives for a file source, and pin the public\nkey in the machines' trusted settings before any machine fetches it."},"3610":{"id":"/skill-management/managed-state-86","page_id":"/skill-management/managed-state","tags":[],"type":"text","url":"/skill-management/managed-state#producing-a-state","content":"A signed state in a git repository or a storage bucket is a complete managed source. Nothing\nabout it depends on the transport."},"3611":{"id":"/skill-management/manifest-system","page_id":"/skill-management/manifest-system","type":"page","content":"Manifests, locks, and scope","breadcrumbs":["Docs","Manage skills","Skills and projects"],"tags":[],"url":"/skill-management/manifest-system"},"3612":{"id":"/skill-management/manifest-system-0","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system","content":"Declare sources and understand what FastSkill restores for a project or user."},"3613":{"id":"/skill-management/manifest-system-1","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#project-configuration","content":"Project configuration"},"3614":{"id":"/skill-management/manifest-system-2","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#manifest-composition","content":"Manifest composition"},"3615":{"id":"/skill-management/manifest-system-3","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#dependency-origins","content":"Dependency origins"},"3616":{"id":"/skill-management/manifest-system-4","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#groups","content":"Groups"},"3617":{"id":"/skill-management/manifest-system-5","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"Locked restoration and updates"},"3618":{"id":"/skill-management/manifest-system-6","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#project-and-global-scope","content":"Project and global scope"},"3619":{"id":"/skill-management/manifest-system-7","page_id":"/skill-management/manifest-system","type":"heading","tags":[],"url":"/skill-management/manifest-system#author-configuration","content":"Author configuration"},"3620":{"id":"/skill-management/manifest-system-8","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-configuration","content":"A project's `skill-project.toml` defines the installation directory and desired\nskills. FastSkill finds it by walking up from your working directory. Paths in the\nmanifest are relative to the manifest directory, not the calling shell's directory."},"3621":{"id":"/skill-management/manifest-system-9","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-configuration","content":"Use the quickstart to create this local source. `skill add` writes a\ndependency and installs it. Editing the manifest manually requires a subsequent\n`project install` to apply it."},"3622":{"id":"/skill-management/manifest-system-10","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-configuration","content":"FastSkill refuses a manifest with a key it does not recognise under\n`[tool.fastskill]`, so a misspelt setting fails loudly instead of being ignored.\nOther tables, such as `[tool.<other-tool>]`, are left alone and kept on save."},"3623":{"id":"/skill-management/manifest-system-11","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#manifest-composition","content":"Reference a reusable team Manifest without copying its dependencies:"},"3624":{"id":"/skill-management/manifest-system-12","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#manifest-composition","content":"A reference may name the file or its containing directory. References are recursive and their\npaths are relative to the Manifest containing the declaration. Dependencies inside each referenced\nManifest keep their own path base, so a shared Manifest may combine Git, repository, ZIP URL, and\nshared-filesystem origins normally."},"3625":{"id":"/skill-management/manifest-system-13","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#manifest-composition","content":"`project install` resolves all composed roots into the consuming project's `skills.lock`. Repeated\nidentical declarations are deduplicated. Missing files, cycles, or different origins/groups for the\nsame skill ID are errors and stop installation before managed state changes."},"3626":{"id":"/skill-management/manifest-system-14","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#manifest-composition","content":"A composed Manifest's `[[tool.fastskill.repositories]]` join the consuming project's for\nresolution, so a shared `repository` origin finds the catalog its own Manifest names. A local\nrepository `path` is relative to the Manifest that declares it. When two Manifests define the same\nrepository name differently, installation stops and asks you to rename one; identical definitions\nare merged. `fastskill repo` commands list and edit only the project's own repositories."},"3627":{"id":"/skill-management/manifest-system-15","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#manifest-composition","content":"Only dependencies and repositories are taken from a composed Manifest. Its `skills_directory`,\n`[tool.fastskill.eval]` and `[tool.fastskill.server]` are ignored on purpose: those settings belong\nto the consuming project."},"3628":{"id":"/skill-management/manifest-system-16","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#manifest-composition","content":"Manifest composition is supported in author-controlled project manifests. Installed or fetched\nskill packages must declare dependencies directly; their manifest references are rejected before\nany referenced file is read. This prevents packages from importing host project files."},"3629":{"id":"/skill-management/manifest-system-17","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#dependency-origins","content":"These are examples of source declarations, not publicly available packages:"},"3630":{"id":"/skill-management/manifest-system-18","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#dependency-origins","content":"A repository origin refers to a configured catalog. See source configuration.\nUse `skill add` to produce declarations from actual sources rather than guessing IDs.\nEditable local dependencies link to their source and are intentionally mutable;\nother local dependencies are copied and checked against locked integrity evidence."},"3631":{"id":"/skill-management/manifest-system-19","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#groups","content":"Groups select optional roots. Required transitive dependencies remain part of the\nselected roots' installation closure."},"3632":{"id":"/skill-management/manifest-system-20","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#groups","content":"Use one group selection mode per invocation. A group-limited lock may not cover\nroots excluded from that resolution; `--lock` cannot resolve missing coverage."},"3633":{"id":"/skill-management/manifest-system-21","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"`skills.lock` records the resolved result of local and composed Manifest roots: origins, versions, Git commits, content digests,\ndependency edges, groups, covered roots, bundle ownership, and overrides. It is\ngenerated by FastSkill; do not hand-write a partial lockfile."},"3634":{"id":"/skill-management/manifest-system-22","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"A content digest names the exact files of a skill directory and is written as\n`sha256-tree-v2:<hex>`. A lockfile from an earlier release may hold 64-character digests\nwithout that prefix; they are still verified, with a warning, and are replaced when fastskill\nnext rewrites that entry. fastskill releases before this format report a checksum mismatch on\nthe new form, so upgrade every machine and CI job that shares the lockfile."},"3635":{"id":"/skill-management/manifest-system-23","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"Ordinary installation reuses compatible locked selections and resolves roots that\nlack coverage. `--lock` verifies and restores the recorded selection without\nchanging lock bytes. Updates deliberately resolve changes within the declared\nconstraints; exact pins stay pinned unless explicitly changed."},"3636":{"id":"/skill-management/manifest-system-24","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#locked-restoration-and-updates","content":"Commit the manifest and lock together. Local sources and cached bundle artifacts\nmust also be available to recipients. `--offline` prevents network access; it\nrequires all necessary verified inputs locally and does not make remote dependencies\nportable by itself. See bundle distribution."},"3637":{"id":"/skill-management/manifest-system-25","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-and-global-scope","content":"Project operations use the manifest's installation directory. `--skills-dir`\noverrides that destination when supported. Global operations use the user-level\nskill set and `global-skills.lock`; the default directory is\n`~/.config/fastskill/skills` on Unix."},"3638":{"id":"/skill-management/manifest-system-26","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#project-and-global-scope","content":"A global FastSkill directory is not automatically an agent's discovery directory.\nConfirm the location your agent reads or access global skills through MCP.\nGlobal lock restoration does not require a project manifest."},"3639":{"id":"/skill-management/manifest-system-27","page_id":"/skill-management/manifest-system","tags":[],"type":"text","url":"/skill-management/manifest-system#author-configuration","content":"Within a skill directory, `skill-project.toml` can also carry author metadata and\nskill dependencies. A standalone skill can begin with only `SKILL.md`; separate\nproject configuration controls where consumers install it. See\nskill validation and project init."},"3640":{"id":"/skill-management/reconciliation","page_id":"/skill-management/reconciliation","type":"page","content":"Reconcile project skill state","breadcrumbs":["Docs","Manage skills","Skills and projects"],"tags":[],"url":"/skill-management/reconciliation"},"3641":{"id":"/skill-management/reconciliation-0","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation","content":"Compare declared, locked, and installed skill state and enforce it in CI."},"3642":{"id":"/skill-management/reconciliation-1","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"Reconcile project skill state"},"3643":{"id":"/skill-management/reconciliation-2","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#human-readable-checks","content":"Human-readable checks"},"3644":{"id":"/skill-management/reconciliation-3","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#reconciliation-values","content":"Reconciliation values"},"3645":{"id":"/skill-management/reconciliation-4","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#json-schema","content":"JSON schema"},"3646":{"id":"/skill-management/reconciliation-5","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#group-scoped-checks","content":"Group-scoped checks"},"3647":{"id":"/skill-management/reconciliation-6","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#ci-example","content":"CI example"},"3648":{"id":"/skill-management/reconciliation-7","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#repair-workflow","content":"Repair workflow"},"3649":{"id":"/skill-management/reconciliation-8","page_id":"/skill-management/reconciliation","type":"heading","tags":[],"url":"/skill-management/reconciliation#global-state","content":"Global state"},"3650":{"id":"/skill-management/reconciliation-9","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"fastskill compares three sources of truth:"},"3651":{"id":"/skill-management/reconciliation-10","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"`skill-project.toml` records direct intent, groups, and source constraints."},"3652":{"id":"/skill-management/reconciliation-11","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"`skills.lock` records the resolved closure, versions, origins, ownership, and integrity data."},"3653":{"id":"/skill-management/reconciliation-12","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"The skills directory contains the installed files an agent reads."},"3654":{"id":"/skill-management/reconciliation-13","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconcile-project-skill-state","content":"`fastskill skill list` joins those sources into one row per skill. `fastskill skill list --check`\nuses the same rows and returns nonzero when selected managed state needs reconciliation."},"3655":{"id":"/skill-management/reconciliation-14","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#human-readable-checks","content":"The detailed source path is the recorded origin path or URL, not the installed destination.\nEditable installs use the human-readable `editable` flag."},"3656":{"id":"/skill-management/reconciliation-15","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"The `reconciliation` field is the canonical machine-readable status. Values can include:"},"3657":{"id":"/skill-management/reconciliation-16","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Value"},"3658":{"id":"/skill-management/reconciliation-17","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Meaning"},"3659":{"id":"/skill-management/reconciliation-18","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`managed-blocked`"},"3660":{"id":"/skill-management/reconciliation-19","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"The managed state blocks the installed content's digest."},"3661":{"id":"/skill-management/reconciliation-20","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`managed-not-allowed`"},"3662":{"id":"/skill-management/reconciliation-21","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"The managed state allows only listed content, and the installed content isn't listed."},"3663":{"id":"/skill-management/reconciliation-22","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`ok`"},"3664":{"id":"/skill-management/reconciliation-23","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Selected state agrees and managed content passes integrity checks."},"3665":{"id":"/skill-management/reconciliation-24","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`excluded`"},"3666":{"id":"/skill-management/reconciliation-25","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"A group filter excluded the owning root."},"3667":{"id":"/skill-management/reconciliation-26","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`missing-lock`"},"3668":{"id":"/skill-management/reconciliation-27","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Declared intent has no resolved lock entry."},"3669":{"id":"/skill-management/reconciliation-28","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`missing-content`"},"3670":{"id":"/skill-management/reconciliation-29","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Managed content is absent from the skills directory."},"3671":{"id":"/skill-management/reconciliation-30","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`intent-mismatch`"},"3672":{"id":"/skill-management/reconciliation-31","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Manifest intent and locked origin differ."},"3673":{"id":"/skill-management/reconciliation-32","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`revision-mismatch`"},"3674":{"id":"/skill-management/reconciliation-33","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Installed and locked versions differ."},"3675":{"id":"/skill-management/reconciliation-34","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`content-mismatch`"},"3676":{"id":"/skill-management/reconciliation-35","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Installed managed content differs from its digest."},"3677":{"id":"/skill-management/reconciliation-36","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`integrity-error`"},"3678":{"id":"/skill-management/reconciliation-37","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Installed content could not be verified."},"3679":{"id":"/skill-management/reconciliation-38","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`insufficient-integrity`"},"3680":{"id":"/skill-management/reconciliation-39","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"The lock lacks evidence required for a reliable check."},"3681":{"id":"/skill-management/reconciliation-40","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`ownership-conflict`"},"3682":{"id":"/skill-management/reconciliation-41","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Bundle owners disagree about the expected content."},"3683":{"id":"/skill-management/reconciliation-42","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"`extraneous`"},"3684":{"id":"/skill-management/reconciliation-43","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"Installed content has no manifest, lock, bundle, or override owner."},"3685":{"id":"/skill-management/reconciliation-44","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#reconciliation-values","content":"The two `managed-` values appear only when this machine follows a verified managed state (see\n`fastskill managed`). They take precedence over every other\nvalue, `managed-blocked` first, and `skill list --check` fails on them even for a skill outside\nthe current selection."},"3686":{"id":"/skill-management/reconciliation-45","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#json-schema","content":"Do not test a nonexistent `.status` field. Use `reconciliation` for reports and use the\n`--check` exit status for pass/fail automation."},"3687":{"id":"/skill-management/reconciliation-46","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#group-scoped-checks","content":"`--only` and `--without` affect both displayed rows and the selected check closure. They are\nmutually exclusive."},"3688":{"id":"/skill-management/reconciliation-47","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#group-scoped-checks","content":"The implicit group for an ungrouped root is `default`. `--only default` is valid even for an empty\nproject and produces an empty successful result."},"3689":{"id":"/skill-management/reconciliation-48","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#ci-example","content":"The last command fails the step when reconciliation is required. Keep the JSON artifact for\ndiagnostics; no `jq` predicate is required to decide success."},"3690":{"id":"/skill-management/reconciliation-49","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#ci-example","content":"For a readable failure report while preserving the command's exit status:"},"3691":{"id":"/skill-management/reconciliation-50","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#repair-workflow","content":"Use the row status to choose the repair:"},"3692":{"id":"/skill-management/reconciliation-51","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#repair-workflow","content":"fastskill refuses to overwrite locally modified managed content during update/removal. Preserve or\nrevert the local change before retrying. Editable installs are intentionally mutable and are checked\nby link shape rather than copied-content digest."},"3693":{"id":"/skill-management/reconciliation-52","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#global-state","content":"Use `--global` to reconcile `global-skills.lock` and the global skills directory:"},"3694":{"id":"/skill-management/reconciliation-53","page_id":"/skill-management/reconciliation","tags":[],"type":"text","url":"/skill-management/reconciliation#global-state","content":"Global checks treat an extraneous on-disk skill as a reconciliation failure, matching project\nchecks."},"3695":{"id":"/skill-management/validation","page_id":"/skill-management/validation","type":"page","content":"Validate a skill","breadcrumbs":["Docs","Manage skills","Skills and projects"],"tags":[],"url":"/skill-management/validation"},"3696":{"id":"/skill-management/validation-0","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation","content":"Check skill structure and installed state before an agent uses it."},"3697":{"id":"/skill-management/validation-1","page_id":"/skill-management/validation","type":"heading","tags":[],"url":"/skill-management/validation#start-with-skillmd","content":"Start with SKILL.md"},"3698":{"id":"/skill-management/validation-2","page_id":"/skill-management/validation","type":"heading","tags":[],"url":"/skill-management/validation#validate-installation-and-state","content":"Validate installation and state"},"3699":{"id":"/skill-management/validation-3","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation#start-with-skillmd","content":"A skill root contains `SKILL.md` with YAML frontmatter and instructions:"},"3700":{"id":"/skill-management/validation-4","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation#start-with-skillmd","content":"The standard validator expects a lowercase name of 1–64 characters using letters,\ndigits, and single separating hyphens. The description must be nonempty and at most\n1024 characters. Name and description help an agent decide when to load the skill."},"3701":{"id":"/skill-management/validation-5","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation#start-with-skillmd","content":"FastSkill derives identity from the skill metadata/name and uses a semantic version\nwhen resolving or packaging skills. Version metadata is optional for a minimal skill;\nFastSkill defaults an unspecified version to `1.0.0`. Set `metadata.version`\nexplicitly for a skill you distribute."},"3702":{"id":"/skill-management/validation-6","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation#validate-installation-and-state","content":"After creating the source above, add it from a configured project:"},"3703":{"id":"/skill-management/validation-7","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation#validate-installation-and-state","content":"Installation validates metadata and source contents. Reconciliation checks desired\nconstraints, locked facts, dependency ownership, and installed content. Editable\nlocal sources are reported as mutable rather than digest-verified."},"3704":{"id":"/skill-management/validation-8","page_id":"/skill-management/validation","tags":[],"type":"text","url":"/skill-management/validation#validate-installation-and-state","content":"A successful structural check does not prove that instructions are safe or useful.\nReview scripts and resources, then use evals to measure\nbehavior on representative tasks. See reconciliation\nfor missing, changed, conflicting, and unverifiable installations."},"3705":{"id":"/testing/debugging","page_id":"/testing/debugging","type":"page","content":"Debugging Guide","breadcrumbs":["Docs","Reference","Diagnostics"],"tags":[],"url":"/testing/debugging"},"3706":{"id":"/testing/debugging-0","page_id":"/testing/debugging","tags":[],"type":"text","url":"/testing/debugging","content":"Diagnose FastSkill setup and behavior with `fastskill cli doctor` and `--verbose` output."},"3707":{"id":"/testing/debugging-1","page_id":"/tes